@using VoltaMarcada.Application.WorkOrders
@using VoltaMarcada.Application.Equipment
@using VoltaMarcada.Application.Services
@using VoltaMarcada.Domain.Enums
@using VoltaMarcada.Web.Formatting
@inject IBrazilianDisplayFormatter DisplayFormatter

<MudStack Spacing="2">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">Itens e valores</MudText>
        @if (!ReadOnly)
        {
            <MudStack Row="true">
                @if (AddEquipmentRequested.HasDelegate)
                {
                    <MudButton Variant="Variant.Text" OnClick="AddEquipmentRequested">Novo equipamento</MudButton>
                }
                <MudButton Variant="Variant.Outlined" OnClick="AddItem">Adicionar item</MudButton>
            </MudStack>
        }
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(ServiceName))
    {
        <MudGrid Class="work-order-item-row" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="3">
                <MudTextField T="string" Value="@ServiceName" Label="Serviço" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="Guid?" Value="@PrimaryEquipmentId" ValueChanged="PrimaryEquipmentIdChanged" Label="Equipamento" Required="true" RequiredError="Selecione o equipamento." Disabled="ReadOnly">
                    @foreach (var equipment in EquipmentOptions)
                    {
                        <MudSelectItem Value="@((Guid?)equipment.Id)">@equipment.Type @equipment.Manufacturer @equipment.Model</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudNumericField T="decimal" Value="@(1m)" Label="Quantidade" ReadOnly="true" />
            </MudItem>
            <MudItem xs="6" sm="2">
                <BrazilianCurrencyInput Id="service-unit-price"
                                        Name="service-unit-price"
                                        Label="Valor do serviço"
                                        Value="@ServiceUnitPrice"
                                        ValueChanged="ServiceUnitPriceChanged"
                                        Required="@(!IsServicePriceFixed)"
                                        RequiredError="Informe o valor do serviço."
                                        Variant="Variant.Text"
                                        Disabled="@(IsServicePriceReadOnly || ReadOnly || IsServicePriceFixed)" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudText>Subtotal: @DisplayFormatter.FormatCurrency(ServiceSubtotal)</MudText>
            </MudItem>
        </MudGrid>
    }

    @if (Items.Count == 0)
    {
        <MudText Color="Color.Secondary">Nenhum item adicional adicionado.</MudText>
    }
    else
    {
        @foreach (var item in Items.Select((value, index) => new { value, index }))
        {
            <MudGrid Class="work-order-item-row" AlignItems="AlignItems.Center">
                <MudItem xs="12" sm="3">
                    <MudSelect T="WorkOrderItemType" Value="@item.value.Type" ValueChanged="@(value => UpdateItem(item.index, item.value with { Type = value, ServiceId = value == WorkOrderItemType.Service ? item.value.ServiceId : null }))" Label="Tipo" Disabled="@(ReadOnly || !CanEditItemTypes)">
                        @foreach (var type in Enum.GetValues<WorkOrderItemType>())
                        {
                            <MudSelectItem Value="@type">@GetItemTypeName(type)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="Guid?" Value="@item.value.EquipmentId" ValueChanged="@(value => UpdateItem(item.index, item.value with { EquipmentId = value }))" Label="Equipamento" Required="@(item.value.Type == WorkOrderItemType.Service)" RequiredError="Selecione o equipamento." Clearable="@(item.value.Type != WorkOrderItemType.Service)" Disabled="ReadOnly">
                        @foreach (var equipment in EquipmentOptions)
                        {
                            <MudSelectItem Value="@((Guid?)equipment.Id)">@equipment.Type @equipment.Manufacturer @equipment.Model</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (item.value.Type == WorkOrderItemType.Service)
                {
                    <MudItem xs="12" sm="3">
                        <MudSelect T="Guid?" Value="@item.value.ServiceId" ValueChanged="@(value => UpdateServiceItem(item.index, item.value, value))" Label="Serviço" Required="true" RequiredError="Selecione o serviço." Disabled="ReadOnly">
                            @foreach (var service in ServiceOptions)
                            {
                                <MudSelectItem Value="@((Guid?)service.Id)">@service.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" sm="@(item.value.Type == WorkOrderItemType.Service ? 3 : 6)">
                    <MudTextField T="string" Value="@item.value.Description" ValueChanged="@(value => UpdateItem(item.index, item.value with { Description = value ?? string.Empty }))" Label="Descrição" ReadOnly="ReadOnly" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudNumericField T="decimal" Value="@item.value.Quantity" ValueChanged="@(value => UpdateItem(item.index, item.value with { Quantity = value }))" Label="Quantidade" Min="0.01m" ReadOnly="ReadOnly" />
                </MudItem>
                <MudItem xs="6" sm="2">
                    <BrazilianCurrencyInput Id="@($"additional-item-{item.index}-unit-price")"
                                            Name="@($"additional-item-{item.index}-unit-price")"
                                            Label="Valor unitário"
                                            Value="@item.value.UnitPrice"
                                            ValueChanged="@(value => UpdateItem(item.index, item.value with { UnitPrice = value ?? 0m }))"
                                            Variant="Variant.Text"
                                            Disabled="ReadOnly" />
                </MudItem>
                <MudItem xs="8" sm="2">
                    <MudText>Subtotal: @DisplayFormatter.FormatCurrency(item.value.Quantity * item.value.UnitPrice)</MudText>
                </MudItem>
                @if (!ReadOnly)
                {
                    <MudItem xs="4" sm="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover item" OnClick="@(() => RemoveItem(item.index))" />
                    </MudItem>
                }
            </MudGrid>
        }
    }

    @if (!ReadOnly)
    {
        <BrazilianCurrencyInput Id="work-order-discount" Name="work-order-discount" Label="Desconto" Value="@DiscountAmount" ValueChanged="OnDiscountAmountChanged" Variant="Variant.Text" />
    }
    <MudText Typo="Typo.body2">Desconto: -@DisplayFormatter.FormatCurrency(DiscountAmount)</MudText>
    <MudText Typo="Typo.subtitle1">Total da OS: @DisplayFormatter.FormatCurrency(ServiceSubtotal + Items.Sum(item => item.Quantity * item.UnitPrice) - DiscountAmount)</MudText>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public List<WorkOrderItemInput> Items { get; set; } = [];

    [Parameter]
    public EventCallback<List<WorkOrderItemInput>> ItemsChanged { get; set; }

    [Parameter]
    public IReadOnlyList<EquipmentDto> EquipmentOptions { get; set; } = [];

    [Parameter]
    public Guid? PrimaryEquipmentId { get; set; }

    [Parameter]
    public EventCallback<Guid?> PrimaryEquipmentIdChanged { get; set; }

    [Parameter]
    public EventCallback AddEquipmentRequested { get; set; }

    [Parameter]
    public IReadOnlyList<ServiceDto> ServiceOptions { get; set; } = [];

    [Parameter]
    public bool CanEditItemTypes { get; set; } = true;

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public string ServiceName { get; set; } = string.Empty;

    [Parameter]
    public decimal? ServiceUnitPrice { get; set; }

    [Parameter]
    public EventCallback<decimal?> ServiceUnitPriceChanged { get; set; }

    [Parameter]
    public bool IsServicePriceFixed { get; set; }

    [Parameter]
    public bool IsServicePriceReadOnly { get; set; }
    [Parameter]
    public decimal DiscountAmount { get; set; }

    [Parameter]
    public EventCallback<decimal> DiscountAmountChanged { get; set; }


    private decimal ServiceSubtotal => ServiceUnitPrice ?? 0m;

    private async Task AddItem()
    {
        var updated = Items.Append(new WorkOrderItemInput(string.Empty, 1, 0)).ToList();
        await ItemsChanged.InvokeAsync(updated);
    }

    private async Task RemoveItem(int index)
    {
        var updated = Items.Where((_, currentIndex) => currentIndex != index).ToList();
        await ItemsChanged.InvokeAsync(updated);
    }

    private async Task UpdateItem(int index, WorkOrderItemInput updatedItem)
    {
        var updated = Items.Select((item, currentIndex) => currentIndex == index ? updatedItem : item).ToList();
        await ItemsChanged.InvokeAsync(updated);
    }

    private Task UpdateServiceItem(int index, WorkOrderItemInput item, Guid? serviceId)
    {
        var service = ServiceOptions.SingleOrDefault(option => option.Id == serviceId);
        var unitPrice = service?.PriceType is ServicePriceType.Fixed or ServicePriceType.StartingAt ? service.BasePrice ?? item.UnitPrice : item.UnitPrice;
        return UpdateItem(index, item with { ServiceId = serviceId, UnitPrice = unitPrice });
    }

    private Task OnDiscountAmountChanged(decimal? value) => DiscountAmountChanged.InvokeAsync(value ?? 0m);
    private static string GetItemTypeName(WorkOrderItemType type) => type switch
    {
        WorkOrderItemType.Service => "Serviço",
        WorkOrderItemType.Part => "Peça",
        WorkOrderItemType.Material => "Material",
        WorkOrderItemType.Travel => "Deslocamento",
        _ => "Outro"
    };
}
