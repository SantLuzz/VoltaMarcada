@using Microsoft.JSInterop
@using VoltaMarcada.Application.Equipment
@inject IComponentOperationExecutor OperationExecutor
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<MudDrawer Open="@Open" OpenChanged="SetOpenAsync" Anchor="Anchor.End" Variant="DrawerVariant.Temporary" Elevation="8" Width="520px" Class="equipment-history-drawer">
    <MudStack Spacing="2" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">@HistoryTitle</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" AriaLabel="@CloseHistoryLabel" OnClick="CloseAsync" />
        </MudStack>

        @if (isInitialLoading)
        {
            <div class="equipment-history-loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else if (loadError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                @loadError
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RetryAsync">Tentar novamente</MudButton>
            </MudAlert>
        }
        else if (historyPage is not null)
        {
            <MudText Typo="Typo.subtitle2">@historyPage.Equipment.Description</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@historyPage.Equipment.CustomerName</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@historyRecords.Count de @historyPage.TotalRecordCount registros</MudText>

            @if (historyRecords.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.History" Title="@EmptyHistoryTitle" Description="@EmptyHistoryDescription" />
            }
            else
            {
                <div class="equipment-history-timeline" @ref="timelineElement" @onscroll="HandleTimelineScrollAsync">
                    @foreach (var record in historyRecords)
                    {
                        <MudPaper Outlined="true" Class="pa-3 equipment-history-record">
                            <MudText Typo="Typo.subtitle2">@record.ServiceName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@record.WorkOrderDisplayNumber &#183; @record.CompletedAtUtc.LocalDateTime.ToString("dd/MM/yyyy")</MudText>
                            @if (!string.IsNullOrWhiteSpace(record.ProfessionalName))
                            {
                                <MudText Typo="Typo.body2">@TechnicianLabel: @record.ProfessionalName</MudText>
                            }
                            <MudText Typo="Typo.body2">Checklist: @record.CompletedChecklistCount/@record.RequiredChecklistCount &#183; @EvidenceLabel: @record.BeforePhotoCount antes, @record.AfterPhotoCount depois</MudText>
                            <MudText Typo="Typo.body2">Anexos: @record.AttachmentCount &#183; Valor: @record.TotalAmount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</MudText>
                            @if (record.NextMaintenanceDueDate is { } dueDate)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Primary">@NextMaintenanceLabel: @dueDate.ToString("dd/MM/yyyy")</MudText>
                            }
                        </MudPaper>
                    }
                    @if (isLoadingMore)
                    {
                        <div class="equipment-history-loading-more"><MudProgressCircular Indeterminate="true" Size="Size.Small" /></div>
                    }
                </div>
            }
        }
    </MudStack>
</MudDrawer>

@code {
    [Parameter] public Guid? EquipmentId { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private EquipmentHistoryPageDto? historyPage;
    private IReadOnlyList<EquipmentHistoryRecordDto> historyRecords = [];
    private ElementReference timelineElement;
    private IJSObjectReference? scrollModule;
    private Guid? loadedEquipmentId;
    private bool isInitialLoading;
    private bool isLoadingMore;
    private string? loadError;
    private const string HistoryTitle = "Hist\u00F3rico do equipamento";
    private const string CloseHistoryLabel = "Fechar hist\u00F3rico";
    private const string EmptyHistoryTitle = "Sem hist\u00F3rico t\u00E9cnico";
    private const string EmptyHistoryDescription = "Ainda n\u00E3o h\u00E1 servi\u00E7os conclu\u00EDdos para este equipamento.";
    private const string TechnicianLabel = "T\u00E9cnico";
    private const string EvidenceLabel = "Evid\u00EAncias";
    private const string NextMaintenanceLabel = "Pr\u00F3xima manuten\u00E7\u00E3o";
    private const string LoadErrorMessage = "N\u00E3o foi poss\u00EDvel carregar o hist\u00F3rico deste equipamento.";

    protected override async Task OnParametersSetAsync()
    {
        if (Open && EquipmentId is { } equipmentId && loadedEquipmentId != equipmentId)
        {
            loadedEquipmentId = equipmentId;
            await LoadAsync(reset: true);
        }
    }

    private async Task HandleTimelineScrollAsync()
    {
        if (historyPage is not { HasMore: true } || isLoadingMore || isInitialLoading)
        {
            return;
        }

        scrollModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/equipment-history-scroll.js");
        if (await scrollModule.InvokeAsync<bool>("isNearBottom", timelineElement, 160))
        {
            await LoadAsync(reset: false);
        }
    }

    private async Task LoadAsync(bool reset)
    {
        if (EquipmentId is not { } equipmentId)
        {
            return;
        }

        if (reset)
        {
            isInitialLoading = true;
            loadError = null;
            historyPage = null;
            historyRecords = [];
        }
        else
        {
            isLoadingMore = true;
        }

        try
        {
            var offset = reset ? 0 : historyRecords.Count;
            var result = await OperationExecutor.ExecuteAsync(
                (GetEquipmentHistoryUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(equipmentId, offset, cancellationToken));

            if (!result.IsSuccess || result.Value is null)
            {
                loadError = LoadErrorMessage;
                return;
            }

            historyPage = result.Value;
            historyRecords = reset
                ? result.Value.Records
                : historyRecords.Concat(result.Value.Records).ToArray();
        }
        catch
        {
            loadError = LoadErrorMessage;
        }
        finally
        {
            isInitialLoading = false;
            isLoadingMore = false;
        }
    }

    private Task RetryAsync() => LoadAsync(reset: true);

    private async Task SetOpenAsync(bool value)
    {
        if (!value)
        {
            loadedEquipmentId = null;
            historyPage = null;
            historyRecords = [];
            loadError = null;
        }

        await OpenChanged.InvokeAsync(value);
    }

    private Task CloseAsync() => SetOpenAsync(false);

    public async ValueTask DisposeAsync()
    {
        if (scrollModule is not null)
        {
            await scrollModule.DisposeAsync();
        }
    }
}
