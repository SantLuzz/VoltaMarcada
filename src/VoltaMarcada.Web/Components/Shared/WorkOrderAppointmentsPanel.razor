@using VoltaMarcada.Application.Scheduling
@using VoltaMarcada.Application.Professionals
@using VoltaMarcada.Domain.Enums
@inject IComponentOperationExecutor OperationExecutor
@inject ISnackbar Snackbar

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="@HeaderClass">
    <MudText Typo="Typo.h6">Agendamentos vinculados</MudText>
    @if (CanCreateAppointments)
    {
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAppointmentEditor">Novo agendamento</MudButton>
    }
</MudStack>

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (appointments.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.EventBusy" Title="Nenhum agendamento" Description="Esta OS ainda não possui compromissos vinculados." />
}
else
{
    <MudList T="AppointmentDto">
        @foreach (var appointment in appointments)
        {
            <MudListItem T="AppointmentDto" Value="@appointment" Icon="@Icons.Material.Filled.Event" OnClick="@(() => OpenAppointmentDetails(appointment.Id))">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2">@AppointmentCalendarTime.ToLocalDateTime(appointment.StartAtUtc, appointment.ProfessionalTimeZoneId).ToString("dd/MM HH:mm") — @GetStatusName(appointment.Status)</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(appointment.Origin == AppointmentOrigin.External ? Color.Info : Color.Default)">@(appointment.Origin == AppointmentOrigin.External ? "Externo" : "Interno")</MudChip>
                    <MudText Typo="Typo.body2">@(appointment.CustomerName ?? "Cliente não informado") · @(appointment.ServiceName ?? "Serviço não informado")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@appointment.ProfessionalName@(string.IsNullOrWhiteSpace(appointment.EquipmentName) ? string.Empty : $" · {appointment.EquipmentName}")</MudText>
                    @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@appointment.Notes</MudText>
                    }
                    @if (appointment.RescheduleHistory.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Histórico de ajustes</MudText>
                        @foreach (var history in appointment.RescheduleHistory)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@history.Reason — @AppointmentCalendarTime.ToLocalDateTime(history.PreviousStartAtUtc, appointment.ProfessionalTimeZoneId).ToString("dd/MM HH:mm") → @AppointmentCalendarTime.ToLocalDateTime(history.NewStartAtUtc, appointment.ProfessionalTimeZoneId).ToString("dd/MM HH:mm")</MudText>
                        }
                    }
                </MudStack>
                <div @onclick:stopPropagation="true">
                    @if (appointment.Status == AppointmentStatus.Scheduled)
                    {
                        @if (IsOwner)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => OpenAdjustmentDialogAsync(appointment))">Ajustar</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => OpenNotesDialog(appointment))">Editar</MudButton>
                        }
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => StartAsync(appointment.Id))">Iniciar atendimento</MudButton>
                    }
                    @if (appointment.Status == AppointmentStatus.InProgress)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="@(() => CompleteAsync(appointment.Id))">Concluir atendimento</MudButton>
                    }
                    @if (IsOwner && (appointment.Status is AppointmentStatus.Scheduled or AppointmentStatus.InProgress))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => CancelAsync(appointment.Id))">Cancelar agendamento</MudButton>
                    }
                </div>
            </MudListItem>
        }
    </MudList>
}

<AppointmentEditor @bind-Visible="isAppointmentEditorOpen" FixedWorkOrderId="@WorkOrderId" Created="OnAppointmentCreatedAsync" />
<AppointmentDetailsDialog AppointmentId="@selectedAppointmentId" @bind-Visible="isAppointmentDetailsDialogOpen" />

<MudDialog @bind-Visible="isNotesDialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Editar agendamento</MudText></TitleContent>
    <DialogContent>
        <MudTextField Label="Observações" Lines="3" @bind-Value="editedNotes" Disabled="@isSavingNotes" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseNotesDialog" Disabled="@isSavingNotes">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveNotesAsync" Disabled="@isSavingNotes">@(isSavingNotes ? "Salvando..." : "Salvar")</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="isAdjustmentDialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Ajustar agendamento</MudText></TitleContent>
    <DialogContent>
        @if (isLoadingAdjustmentOptions)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Profissional" @bind-Value="adjustmentProfessionalId" @bind-Value:after="LoadAdjustmentSlotsAsync" Disabled="@isAdjusting">
                        @foreach (var professional in adjustmentProfessionals)
                        {
                            <MudSelectItem Value="@((Guid?)professional.Id)">@professional.CompanyMemberName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data" @bind-Date="adjustmentDate" @bind-Date:after="LoadAdjustmentSlotsAsync" Disabled="@isAdjusting" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="TimeOnly?" Label="Horário" @bind-Value="adjustmentStartTime" Disabled="@(isAdjusting || adjustmentSlots.Count == 0)">
                        @foreach (var slot in adjustmentSlots)
                        {
                            <MudSelectItem Value="@((TimeOnly?)slot.StartTime)">@slot.StartTime.ToString("HH:mm")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Motivo do ajuste" Lines="2" Required="true" @bind-Value="adjustmentReason" Disabled="@isAdjusting" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAdjustmentDialog" Disabled="@isAdjusting">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAdjustmentAsync" Disabled="@(isLoadingAdjustmentOptions || isAdjusting)">@(isAdjusting ? "Salvando..." : "Salvar ajuste")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string? Class { get; set; }

    private string HeaderClass => $"mb-3 {Class}";

    [Parameter, EditorRequired] public Guid WorkOrderId { get; set; }
    [Parameter, EditorRequired] public bool IsOwner { get; set; }
    [Parameter, EditorRequired] public bool CanCreateAppointments { get; set; }

    private IReadOnlyList<AppointmentDto> appointments = [];
    private bool isLoading = true;
    private bool isAppointmentEditorOpen;
    private bool isAppointmentDetailsDialogOpen;
    private bool isNotesDialogOpen;
    private bool isSavingNotes;
    private bool isAdjustmentDialogOpen;
    private bool isLoadingAdjustmentOptions;
    private bool isAdjusting;
    private Guid? selectedAppointmentId;
    private AppointmentDto? appointmentToEdit;
    private string? editedNotes;
    private AppointmentDto? appointmentToAdjust;
    private IReadOnlyList<VoltaMarcada.Application.Professionals.ProfessionalDto> adjustmentProfessionals = [];
    private IReadOnlyList<AppointmentSlotDto> adjustmentSlots = [];
    private Guid? adjustmentProfessionalId;
    private DateTime? adjustmentDate;
    private TimeOnly? adjustmentStartTime;
    private string? adjustmentReason;
    private int adjustmentDurationMinutes;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        appointments = await LoadAppointmentsAsync();
        isLoading = false;
    }

    private async Task CompleteAsync(Guid appointmentId)
    {
        var result = await OperationExecutor.ExecuteAsync(
            (CompleteAppointmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(appointmentId, cancellationToken));
        if (!result.IsSuccess)
        {
            Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error);
            return;
        }

        appointments = await LoadAppointmentsAsync();
        Snackbar.Add("Atendimento concluído.", Severity.Success);
    }

    private void OpenAppointmentEditor() => isAppointmentEditorOpen = true;

    private async Task OnAppointmentCreatedAsync(Guid _)
    {
        appointments = await LoadAppointmentsAsync();
    }

    private void OpenAppointmentDetails(Guid appointmentId)
    {
        selectedAppointmentId = appointmentId;
        isAppointmentDetailsDialogOpen = true;
    }

    private void OpenNotesDialog(AppointmentDto appointment)
    {
        appointmentToEdit = appointment;
        editedNotes = appointment.Notes;
        isNotesDialogOpen = true;
    }

    private void CloseNotesDialog()
    {
        if (!isSavingNotes)
        {
            isNotesDialogOpen = false;
            appointmentToEdit = null;
        }
    }

    private async Task SaveNotesAsync()
    {
        if (appointmentToEdit is null)
        {
            return;
        }

        isSavingNotes = true;
        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (UpdateAppointmentNotesUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(
                    appointmentToEdit.Id,
                    new UpdateAppointmentNotesCommand(editedNotes),
                    cancellationToken));
            if (!result.IsSuccess)
            {
                Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error);
                return;
            }

            isNotesDialogOpen = false;
            appointmentToEdit = null;
            appointments = await LoadAppointmentsAsync();
            Snackbar.Add("Agendamento atualizado.", Severity.Success);
        }
        finally
        {
            isSavingNotes = false;
        }
    }

    private async Task OpenAdjustmentDialogAsync(AppointmentDto appointment)
    {
        appointmentToAdjust = appointment;
        adjustmentProfessionalId = appointment.ProfessionalId;
        adjustmentDate = AppointmentCalendarTime.ToLocalDateTime(appointment.StartAtUtc, appointment.ProfessionalTimeZoneId).Date;
        adjustmentDurationMinutes = (int)(appointment.EndAtUtc - appointment.StartAtUtc).TotalMinutes;
        adjustmentStartTime = null;
        adjustmentReason = null;
        adjustmentSlots = [];
        isAdjustmentDialogOpen = true;
        isLoadingAdjustmentOptions = true;

        try
        {
            adjustmentProfessionals = (await OperationExecutor.ExecuteAsync(
                (GetProfessionalsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(null, cancellationToken)))
                .Where(professional => professional.IsActive)
                .ToArray();
            await LoadAdjustmentSlotsAsync();
            var currentStartTime = TimeOnly.FromDateTime(
                AppointmentCalendarTime.ToLocalDateTime(appointment.StartAtUtc, appointment.ProfessionalTimeZoneId));
            adjustmentStartTime = adjustmentSlots.Any(slot => slot.StartTime == currentStartTime)
                ? currentStartTime
                : null;
        }
        finally
        {
            isLoadingAdjustmentOptions = false;
        }
    }

    private void CloseAdjustmentDialog()
    {
        if (!isAdjusting)
        {
            isAdjustmentDialogOpen = false;
            appointmentToAdjust = null;
        }
    }

    private async Task LoadAdjustmentSlotsAsync()
    {
        adjustmentStartTime = null;
        adjustmentSlots = [];
        if (appointmentToAdjust is null || adjustmentProfessionalId is not { } professionalId || adjustmentDate is null)
        {
            return;
        }

        adjustmentSlots = await OperationExecutor.ExecuteAsync(
            (GetAvailableAppointmentSlotsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(
                professionalId,
                DateOnly.FromDateTime(adjustmentDate.Value),
                adjustmentDurationMinutes,
                appointmentToAdjust.Id,
                cancellationToken));
    }

    private async Task SaveAdjustmentAsync()
    {
        if (appointmentToAdjust is null ||
            adjustmentProfessionalId is not { } professionalId ||
            adjustmentDate is null ||
            adjustmentStartTime is null ||
            string.IsNullOrWhiteSpace(adjustmentReason))
        {
            Snackbar.Add("Informe profissional, data, horário e motivo do ajuste.", Severity.Warning);
            return;
        }

        isAdjusting = true;
        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (AdjustAppointmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(
                    appointmentToAdjust.Id,
                    new AdjustAppointmentCommand(
                    professionalId,
                    DateOnly.FromDateTime(adjustmentDate.Value),
                    adjustmentStartTime.Value,
                    adjustmentReason,
                    WorkOrderId),
                    cancellationToken));
            if (!result.IsSuccess)
            {
                Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error);
                await LoadAdjustmentSlotsAsync();
                return;
            }

            isAdjustmentDialogOpen = false;
            appointmentToAdjust = null;
            appointments = await LoadAppointmentsAsync();
            Snackbar.Add("Agendamento ajustado.", Severity.Success);
        }
        finally
        {
            isAdjusting = false;
        }
    }

    private async Task StartAsync(Guid appointmentId)
    {
        var result = await OperationExecutor.ExecuteAsync(
            (StartAppointmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(appointmentId, cancellationToken));
        if (!result.IsSuccess)
        {
            Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error);
            return;
        }

        appointments = await LoadAppointmentsAsync();
        Snackbar.Add("Atendimento iniciado.", Severity.Success);
    }

    private async Task CancelAsync(Guid appointmentId)
    {
        var result = await OperationExecutor.ExecuteAsync(
            (CancelAppointmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(appointmentId, cancellationToken));
        if (!result.IsSuccess)
        {
            Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error);
            return;
        }

        appointments = await LoadAppointmentsAsync();
        Snackbar.Add("Agendamento cancelado.", Severity.Success);
    }

    private Task<IReadOnlyList<AppointmentDto>> LoadAppointmentsAsync() =>
        OperationExecutor.ExecuteAsync(
            (GetWorkOrderAppointmentsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(WorkOrderId, cancellationToken));

    private static string GetStatusName(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Completed => "Concluído",
        AppointmentStatus.Cancelled => "Cancelado",
        AppointmentStatus.InProgress => "Em andamento",
        _ => "Agendado"
    };
}
