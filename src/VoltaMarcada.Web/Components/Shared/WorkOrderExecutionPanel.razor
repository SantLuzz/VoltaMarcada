    private async Task AddPaymentInstallment()
    {
        if (WorkOrder.TotalAmount < (paymentInstallments.Count + 1) * 0.01m)
        {
            Snackbar.Add("Não é possível criar um pagamento com valor zero.", Severity.Warning);
            return;
        }

        paymentInstallments.Add(new PaymentInstallmentFormModel
        {
            PaymentMethod = PaymentMethod.Cash,
            Amount = 0m
        });

        await RedistributePaymentInstallmentsAsync();
    }

    private async Task RemovePaymentInstallment(PaymentInstallmentFormModel installment)
    {
        if (paymentInstallments.Count > 1)
        {
            paymentInstallments.Remove(installment);
            await RedistributePaymentInstallmentsAsync();
        }
    }

    private async Task RedistributePaymentInstallmentsAsync()
    {
        var amountPerInstallment = decimal.Floor((WorkOrder.TotalAmount / paymentInstallments.Count) * 100m) / 100m;
        var allocatedAmount = 0m;

        for (var index = 0; index < paymentInstallments.Count; index++)
        {
            var installment = paymentInstallments[index];
            installment.Amount = index == paymentInstallments.Count - 1
                ? WorkOrder.TotalAmount - allocatedAmount
                : amountPerInstallment;
            allocatedAmount += installment.Amount;
            installment.PixPayment = null;
        }

        foreach (var installment in paymentInstallments.Where(item => item.PaymentMethod == PaymentMethod.Pix))
        {
            await LoadPixPaymentAsync(installment);
        }
    }

    private async Task OnPaymentMethodChangedAsync(PaymentInstallmentFormModel installment, PaymentMethod paymentMethod)
    {
        installment.PaymentMethod = paymentMethod;
        installment.PixPayment = null;
        if (paymentMethod == PaymentMethod.Pix)
        {
            await LoadPixPaymentAsync(installment);
        }
    }

    private async Task OnPaymentAmountChangedAsync(PaymentInstallmentFormModel installment, decimal? amount)
    {
        var otherInstallmentsTotal = PaymentInstallmentsTotal - installment.Amount;
        var availableAmount = Math.Max(0m, WorkOrder.TotalAmount - otherInstallmentsTotal);
        installment.Amount = Math.Min(amount ?? 0m, availableAmount);
        installment.PixPayment = null;
        if (installment.PaymentMethod == PaymentMethod.Pix)
        {
            await LoadPixPaymentAsync(installment);
        }
    }

    private async Task LoadPixPaymentAsync(PaymentInstallmentFormModel installment)
    {
        if (!isPixPaymentAvailable || installment.Amount <= 0)
        {
            return;
        }

        installment.IsLoadingPixPayment = true;
        try
        {
            installment.PixPayment = await OperationExecutor.ExecuteAsync(
                (GetWorkOrderPixPaymentUseCase useCase, CancellationToken cancellationToken) =>
                    useCase.ExecuteAsync(WorkOrder.Id, installment.Amount, cancellationToken));
        }
        finally
        {
            installment.IsLoadingPixPayment = false;
        }
    }

    private decimal PaymentInstallmentsTotal => paymentInstallments.Sum(item => item.Amount);

    private static string GetPaymentMethodLabel(PaymentMethod method) => method switch
    {
        PaymentMethod.Pix => "Pix",
        PaymentMethod.Cash => "Dinheiro",
        PaymentMethod.DebitCard => "Cartão de débito",
        PaymentMethod.CreditCard => "Cartão de crédito",
        PaymentMethod.BankTransfer => "Transferência bancária",
        PaymentMethod.Other => "Outro",
        _ => method.ToString()
    };

