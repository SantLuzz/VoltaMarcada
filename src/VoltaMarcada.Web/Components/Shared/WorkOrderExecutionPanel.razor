@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using VoltaMarcada.Application.WorkOrders
@using VoltaMarcada.Application.Services
@using VoltaMarcada.Domain.Enums
@inject IComponentOperationExecutor OperationExecutor
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@inject GetWorkOrderPixPaymentUseCase GetWorkOrderPixPayment

@if (WorkOrder.Status == WorkOrderStatus.Pending)
{
    @if (WorkOrder.Capabilities.CanStart)
    {
        <MudStack Spacing="3" Class="work-order-execution-content">
            <MudButton OnClick="StartAsync" Color="Color.Primary" Variant="Variant.Filled">Iniciar atendimento</MudButton>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="3" Class="work-order-execution-content">
            <MudAlert Severity="Severity.Info">A OS precisa de um profissional habilitado antes de iniciar o atendimento.</MudAlert>
        </MudStack>
    }
}
else
{
    <MudStack Spacing="3" Class="work-order-execution-content">
        <MudText Typo="Typo.h6">Fotos antes @(WorkOrder.RequireBeforePhotos ? "(obrigatória)" : string.Empty)</MudText>
        @if (CanExecute)
        {
            <input id="@GetPhotoInputId(WorkOrderPhotoType.Before)" class="native-file-input" type="file" accept="image/jpeg,image/png,image/webp,image/heic" capture="environment" disabled="@(isSaving || isUploadingPhoto)" />
            <MudText id="@GetPhotoStatusId(WorkOrderPhotoType.Before)" Typo="Typo.caption" Color="Color.Secondary" />
        }
        <div id="@GetPhotoPreviewId(WorkOrderPhotoType.Before)" class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.Before))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Foto antes" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" Disabled="@(IsRemovingPhoto || isSaving || isUploadingPhoto)" />
                    }
                </div>
            }
        </div>

        <MudText Typo="Typo.h6">Checklist</MudText>
        @if (WorkOrder.ChecklistItems.Count == 0)
        {
            <MudText Color="Color.Secondary">Este serviço não possui checklist configurado.</MudText>
        }
        else
        {
            @foreach (var item in WorkOrder.ChecklistItems)
            {
                <MudCheckBox T="bool" Value="@progress.GetValueOrDefault(item.Id)" ValueChanged="@(value => SetProgress(item.Id, value))" Disabled="@(!CanExecute)">
                    @item.Description @(item.IsRequired ? "(obrigatório)" : string.Empty)
                </MudCheckBox>
            }
        }

        <MudText Typo="Typo.h6">Fotos depois @(WorkOrder.RequireAfterPhotos ? "(obrigatória)" : string.Empty)</MudText>
        @if (CanExecute)
        {
            <input id="@GetPhotoInputId(WorkOrderPhotoType.After)" class="native-file-input" type="file" accept="image/jpeg,image/png,image/webp,image/heic" capture="environment" disabled="@(isSaving || isUploadingPhoto)" />
            <MudText id="@GetPhotoStatusId(WorkOrderPhotoType.After)" Typo="Typo.caption" Color="Color.Secondary" />
        }
        <div id="@GetPhotoPreviewId(WorkOrderPhotoType.After)" class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.After))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Foto depois" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" Disabled="@(IsRemovingPhoto || isSaving || isUploadingPhoto)" />
                    }
                </div>
            }
        </div>

        <MudText Typo="Typo.h6">Outras fotos</MudText>
        @if (CanExecute)
        {
            <input id="@GetPhotoInputId(WorkOrderPhotoType.Other)" class="native-file-input" type="file" accept="image/jpeg,image/png,image/webp,image/heic" capture="environment" disabled="@(isSaving || isUploadingPhoto)" />
            <MudText id="@GetPhotoStatusId(WorkOrderPhotoType.Other)" Typo="Typo.caption" Color="Color.Secondary" />
        }
        <div id="@GetPhotoPreviewId(WorkOrderPhotoType.Other)" class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.Other))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Outra foto" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" Disabled="@(IsRemovingPhoto || isSaving || isUploadingPhoto)" />
                    }
                </div>
            }
        </div>

        <MudText Typo="Typo.h6">Anexos</MudText>
        @if (CanExecute)
        {
            <InputFile OnChange="UploadAttachmentAsync" accept="application/pdf,image/*" disabled="@(isSaving || isUploadingPhoto || isUploadingAttachment)" />
        }
        @if (WorkOrder.Attachments.Count == 0)
        {
            <MudText Color="Color.Secondary">Nenhum anexo adicionado.</MudText>
        }
        else
        {
            <div>
                @foreach (var attachment in WorkOrder.Attachments)
                {
                    <div>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="work-order-attachment-row">
                            <MudLink Href="@($"/work-orders/{WorkOrder.Id}/attachments/{attachment.Id}/content")" Target="_blank">@attachment.OriginalFileName</MudLink>
                            <MudText Typo="Typo.caption">@FormatFileLength(attachment.Length)</MudText>
                            @if (!string.IsNullOrWhiteSpace(attachment.Description))
                            {
                                <MudText Typo="Typo.caption">@attachment.Description</MudText>
                            }
                            @if (CanExecute)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover anexo" OnClick="@(() => RemoveAttachmentAsync(attachment.Id))" Disabled="@isUploadingAttachment" />
                            }
                        </MudStack>
                    </div>
                }
            </div>
        }

        <MudTextField @bind-Value="executionNotes" @bind-Value:after="OnExecutionNotesChanged" Label="Observações da execução" Lines="4" Variant="Variant.Outlined" Disabled="@(!CanExecute || isUploadingPhoto)" />

        @if (CanExecute)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudSwitch @bind-Value="shouldRecommendMaintenance" Color="Color.Primary">Recomendar proxima manutencao?</MudSwitch>
                @if (shouldRecommendMaintenance)
                {
                    <MudGrid Class="mt-2">
                        <MudItem xs="12" sm="6"><MudSelect T="string" Label="Quando?" Variant="Variant.Outlined" Required="true" @bind-Value="recommendationPeriod"><MudSelectItem T="string" Value="@("30")">30 dias</MudSelectItem><MudSelectItem T="string" Value="@("60")">60 dias</MudSelectItem><MudSelectItem T="string" Value="@("90")">90 dias</MudSelectItem><MudSelectItem T="string" Value="@("180")">180 dias</MudSelectItem><MudSelectItem T="string" Value="@("custom")">Personalizado</MudSelectItem><MudSelectItem T="string" Value="@("date")">Data especifica</MudSelectItem></MudSelect></MudItem>
                        @if (recommendationPeriod == "custom") { <MudItem xs="12" sm="6"><MudNumericField T="int?" Label="Intervalo em dias" Variant="Variant.Outlined" Required="true" @bind-Value="customIntervalDays" /></MudItem> }
                        @if (recommendationPeriod == "date") { <MudItem xs="12" sm="6"><MudDatePicker Label="Proxima manutencao" Variant="Variant.Outlined" Required="true" @bind-Date="recommendedDueDate" /></MudItem> }
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle1">Equipamentos incluídos na recomendação</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Escolha o serviço recomendado para cada equipamento.</MudText>
                        </MudItem>
                        @foreach (var equipment in RecommendedEquipment)
                        {
                            <MudItem xs="12">
                                <MudPaper Outlined="true" Class="pa-3 maintenance-recommendation-equipment">
                                    <MudText Typo="Typo.subtitle2">@equipment.Description</MudText>
                                    <MudSelect T="Guid?" Label="Serviço recomendado" Variant="Variant.Outlined" Required="true" FullWidth="true" @bind-Value="recommendedServiceIds[equipment.Id]">@foreach (var service in services) { <MudSelectItem Value="@((Guid?)service.Id)">@service.Name</MudSelectItem> }</MudSelect>
                                </MudPaper>
                            </MudItem>
                        }
                        <MudItem xs="12"><MudTextField Label="Observacoes da recomendacao" Variant="Variant.Outlined" Required="true" Lines="3" @bind-Value="recommendationNotes" /></MudItem>
                    </MudGrid>
                }
            </MudPaper>
            <MudDialog @bind-Visible="isCompletionDialogOpen" Options="completionDialogOptions">
                <TitleContent><MudText Typo="Typo.h6">Concluir serviço</MudText></TitleContent>
                <DialogContent>
                    <MudSwitch @bind-Value="isNoCharge" Color="Color.Primary">Este atendimento não terá cobrança</MudSwitch>
                    @if (isNoCharge)
                    {
                        <MudTextField @bind-Value="noChargeReason" Label="Motivo de não cobrança" Required="true" Lines="3" Variant="Variant.Outlined" Class="mt-3" />
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-3">Valor da OS: @WorkOrder.TotalAmount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</MudText>
                        @foreach (var installment in paymentInstallments)
                        {
                            <MudPaper Outlined="true" Class="pa-3 mt-3">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="5">
                                        <MudSelect T="PaymentMethod" Label="Forma de pagamento" Variant="Variant.Outlined" Value="@installment.PaymentMethod" ValueChanged="@(value => OnPaymentMethodChangedAsync(installment, value))" FullWidth="true">
                                            @foreach (var method in AvailablePaymentMethods) { <MudSelectItem Value="@method">@GetPaymentMethodLabel(method)</MudSelectItem> }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="10" sm="5"><BrazilianCurrencyInput Id="@($"payment-installment-{paymentInstallments.IndexOf(installment)}-amount")" Name="@($"payment-installment-{paymentInstallments.IndexOf(installment)}-amount")" Label="Valor" Required="true" Value="@installment.Amount" ValueChanged="@(value => OnPaymentAmountChangedAsync(installment, value))" /></MudItem>
                                    <MudItem xs="2" sm="2" Class="d-flex align-center justify-end"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover parcela" Disabled="@(paymentInstallments.Count == 1)" OnClick="@(() => RemovePaymentInstallment(installment))" /></MudItem>
                                    @if (installment.PaymentMethod == PaymentMethod.Other) { <MudItem xs="12"><MudTextField @bind-Value="installment.OtherPaymentMethodDescription" Label="Descreva a forma de pagamento" Required="true" Variant="Variant.Outlined" FullWidth="true" /></MudItem> }
                                </MudGrid>
                                @if (installment.PaymentMethod == PaymentMethod.Pix)
                                {
                                    @if (installment.IsLoadingPixPayment) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" /> }
                                    else if (installment.PixPayment is { } currentPixPayment)
                                    {
                                        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mt-3"><PixQrCode Payload="@currentPixPayment.CopyAndPasteCode" Size="180" /><MudText Typo="Typo.subtitle2">PIX Copia e Cola</MudText><MudTextField T="string" Value="@currentPixPayment.CopyAndPasteCode" ReadOnly="true" Lines="3" Variant="Variant.Outlined" FullWidth="true" /><MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap"><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="@(() => CopyPixAsync(currentPixPayment))">Copiar código PIX</MudButton>@if (currentPixPayment.WhatsAppShareLink is not null) { <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Send" Href="@currentPixPayment.WhatsAppShareLink" Target="_blank">Enviar no WhatsApp</MudButton> }</MudStack></MudStack>
                                    }
                                    else { <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">Configure a chave Pix da empresa para gerar a cobrança.</MudAlert> }
                                }
                            </MudPaper>
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap" Class="mt-3">
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddPaymentInstallment">Adicionar pagamento</MudButton>
                            <MudText>Subtotal: @PaymentInstallmentsTotal.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) de @WorkOrder.TotalAmount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</MudText>
                        </MudStack>
                        @if (HasInvalidPaymentInstallments)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">Informe um valor maior que zero para cada pagamento.</MudAlert>
                        }
                        else if (PaymentInstallmentsTotal > WorkOrder.TotalAmount)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">A soma dos pagamentos não pode ultrapassar o valor da OS.</MudAlert>
                        }
                        else if (PaymentInstallmentsTotal < WorkOrder.TotalAmount)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">Complete o valor restante para concluir o serviço.</MudAlert>
                        }
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">A cobrança será incluída no Caixa como pendência para confirmação posterior.</MudAlert>
                    }
                </DialogContent>
                <DialogActions><MudButton OnClick="CloseCompletionDialog">Cancelar</MudButton><MudButton OnClick="CompleteAsync" Color="Color.Success" Variant="Variant.Filled" Disabled="@isLoadingPixPayment">Concluir serviço</MudButton></DialogActions>
            </MudDialog>
            <MudStack Row="true">
                <MudButton OnClick="SaveAsync" Variant="Variant.Outlined" Disabled="@(isSaving || isUploadingPhoto)">Salvar progresso</MudButton>
                <MudButton OnClick="OpenCompletionDialogAsync" Color="Color.Success" Variant="Variant.Filled" Disabled="@(!CanComplete)">Concluir serviço</MudButton>
            </MudStack>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public WorkOrderDetailDto WorkOrder { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnSavingChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnPhotoUploadChanged { get; set; }

    private readonly Dictionary<Guid, bool> progress = [];
    private readonly SemaphoreSlim operationLock = new(1, 1);
    private CancellationTokenSource? autosaveCancellation;
    private IJSObjectReference? photoStagingModule;
    private WorkOrderDetailDto? loadedWorkOrder;
    private string? executionNotes;
    private string? observedExecutionNotes;
    private bool isSaving;
    private bool isUploadingPhoto;
    private bool isUploadingAttachment;
    private bool isDisposed;
    private Guid? photoPendingRemoval;
    private long changeVersion;
    private long savedChangeVersion;
    private IReadOnlyList<ServiceDto> services = [];
    private bool shouldRecommendMaintenance;
    private readonly DialogOptions completionDialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
    private bool isCompletionDialogOpen;
    private bool isNoCharge;
    private string? noChargeReason;
    private readonly List<PaymentInstallmentFormModel> paymentInstallments = [];
    private bool isPixPaymentAvailable;
    private bool isLoadingPixPayment => paymentInstallments.Any(item => item.IsLoadingPixPayment) ||
        (!isNoCharge && WorkOrder.PaymentControlEnabled && WorkOrder.TotalAmount > 0 && !ArePaymentInstallmentsValid);

    private bool HasInvalidPaymentInstallments => paymentInstallments.Count == 0 || paymentInstallments.Any(item => item.Amount <= 0);
    private bool ArePaymentInstallmentsValid =>
        !HasInvalidPaymentInstallments && PaymentInstallmentsTotal == WorkOrder.TotalAmount;

    private IEnumerable<PaymentMethod> AvailablePaymentMethods => !isPixPaymentAvailable
        ? Enum.GetValues<PaymentMethod>().Where(method => method != PaymentMethod.Pix)
        : Enum.GetValues<PaymentMethod>();
    private string? recommendationPeriod;
    private int? customIntervalDays;
    private DateTime? recommendedDueDate;
    private Guid? recommendedServiceId;
    private readonly Dictionary<Guid, Guid?> recommendedServiceIds = [];
    private string? recommendationNotes;
    private Guid? restoredStagedPhotosForWorkOrderId;

    private bool CanExecute => WorkOrder.Status == WorkOrderStatus.InProgress && WorkOrder.Capabilities.CanExecute;
    private bool IsRemovingPhoto => photoPendingRemoval is not null;
    private bool CanComplete => CanExecute && !isSaving && !isUploadingPhoto && !HasIncompleteRequiredChecklistItems && !HasMissingRequiredPhotos && !IsCompletionBlockedByPhotoRemoval;
    private bool HasIncompleteRequiredChecklistItems => WorkOrder.ChecklistItems.Any(item => item.IsRequired && !progress.GetValueOrDefault(item.Id));
    private bool HasMissingRequiredPhotos =>
        (WorkOrder.RequireBeforePhotos && !HasPhotoOfType(WorkOrderPhotoType.Before)) ||
        (WorkOrder.RequireAfterPhotos && !HasPhotoOfType(WorkOrderPhotoType.After));

    private bool IsCompletionBlockedByPhotoRemoval
    {
        get
        {
            if (photoPendingRemoval is not { } photoId)
            {
                return false;
            }

            var photo = WorkOrder.Photos.SingleOrDefault(item => item.Id == photoId);
            if (photo is null || !IsRequiredPhotoType(photo.Type))
            {
                return false;
            }

            return WorkOrder.Photos.Count(item => item.Type == photo.Type) == 1;
        }
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(loadedWorkOrder, WorkOrder))
        {
            return;
        }

        loadedWorkOrder = WorkOrder;
        progress.Clear();
        foreach (var item in WorkOrder.ChecklistItems)
        {
            progress[item.Id] = item.IsCompleted;
        }

        executionNotes = WorkOrder.ExecutionNotes;
        observedExecutionNotes = executionNotes;
        changeVersion = 0;
        savedChangeVersion = 0;
        recommendedServiceId = WorkOrder.ServiceId;
        recommendedServiceIds.Clear();
        foreach (var equipment in RecommendedEquipment)
        {
            recommendedServiceIds[equipment.Id] = WorkOrder.ServiceId;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        services = (await OperationExecutor.ExecuteAsync(
        (GetServicesUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(null, cancellationToken))).Where(service => service.IsActive).ToArray();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (restoredStagedPhotosForWorkOrderId == WorkOrder.Id || !CanExecute)
        {
            return;
        }

        try
        {
            var module = await GetPhotoStagingModuleAsync();
            foreach (var type in Enum.GetValues<WorkOrderPhotoType>())
            {
                await module.InvokeVoidAsync("initializePhotoInput", GetPhotoInputId(type), GetPhotoPreviewId(type), GetPhotoStatusId(type), WorkOrder.Id, type);
                await module.InvokeVoidAsync("restoreAndUploadStagedPhoto", WorkOrder.Id, type);
            }

            restoredStagedPhotosForWorkOrderId = WorkOrder.Id;
        }
        catch (JSDisconnectedException)
        {
        }
    }
    private async Task StartAsync()
    {
        var result = await OperationExecutor.ExecuteAsync(
            (StartWorkOrderUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(WorkOrder.Id, cancellationToken));
        if (result.IsSuccess)
        {
            await OnChanged.InvokeAsync();
            return;
        }

        ShowOperationError(result.Error?.Code);
    }

    private void SetProgress(Guid id, bool value)
    {
        if (progress.GetValueOrDefault(id) == value)
        {
            return;
        }

        progress[id] = value;
        RegisterChange();
    }

    private void OnExecutionNotesChanged()
    {
        if (string.Equals(executionNotes, observedExecutionNotes, StringComparison.Ordinal))
        {
            return;
        }

        observedExecutionNotes = executionNotes;
        RegisterChange();
    }

    private void RegisterChange()
    {
        changeVersion++;
        ScheduleAutoSave();
    }

    private void ScheduleAutoSave()
    {
        if (!CanExecute || isDisposed)
        {
            return;
        }

        autosaveCancellation?.Cancel();
        autosaveCancellation?.Dispose();
        autosaveCancellation = new CancellationTokenSource();
        _ = SaveAfterDelayAsync(autosaveCancellation.Token);
    }

    private async Task SaveAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1.5), cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (isDisposed)
            {
                return;
            }

            await FlushProgressAsync(false, cancellationToken);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SaveAsync()
    {
        if (changeVersion == savedChangeVersion)
        {
            Snackbar.Add("Não há alterações pendentes para salvar.", Severity.Info);
            return;
        }

        await FlushProgressAsync(true);
    }

    public async Task<bool> SavePendingChangesAsync()
    {
        autosaveCancellation?.Cancel();
        return await FlushProgressAsync(false);
    }

    private async Task<bool> FlushProgressAsync(bool showSuccess, CancellationToken cancellationToken = default)
    {
        if (!CanExecute || changeVersion == savedChangeVersion)
        {
            return true;
        }

        await operationLock.WaitAsync(cancellationToken);
        try
        {
            if (!CanExecute || changeVersion == savedChangeVersion)
            {
                return true;
            }

            autosaveCancellation?.Cancel();
            isSaving = true;
            await OnSavingChanged.InvokeAsync(true);
            var versionBeingSaved = changeVersion;
            var command = new SaveWorkOrderChecklistProgressCommand(
                progress.Select(item => new ChecklistProgressInput(item.Key, item.Value)).ToArray(),
                executionNotes);
            var result = await OperationExecutor.ExecuteAsync(
                (SaveWorkOrderChecklistProgressUseCase useCase, CancellationToken token) => useCase.ExecuteAsync(WorkOrder.Id, command, token),
                cancellationToken);
            if (!result.IsSuccess)
            {
                ShowOperationError(result.Error?.Code);
                return false;
            }

            savedChangeVersion = versionBeingSaved;
            if (showSuccess)
            {
                Snackbar.Add("Progresso salvo.", Severity.Success);
            }

            await OnChanged.InvokeAsync();
            return true;
        }
        finally
        {
            isSaving = false;
            await OnSavingChanged.InvokeAsync(false);
            operationLock.Release();
        }
    }

    private async Task OpenCompletionDialogAsync()
    {
        if (!WorkOrder.PaymentControlEnabled || WorkOrder.TotalAmount <= 0)
        {
            await CompleteAsync();
            return;
        }

        isNoCharge = false;
        noChargeReason = null;
        paymentInstallments.Clear();
        isPixPaymentAvailable = false;
        try
        {
            var pixPayment = await OperationExecutor.ExecuteAsync(
                (GetWorkOrderPixPaymentUseCase useCase, CancellationToken cancellationToken) =>
                    useCase.ExecuteAsync(WorkOrder.Id, WorkOrder.TotalAmount, cancellationToken));
            isPixPaymentAvailable = pixPayment is not null;
            paymentInstallments.Add(new PaymentInstallmentFormModel
            {
                PaymentMethod = isPixPaymentAvailable ? PaymentMethod.Pix : PaymentMethod.Cash,
                Amount = WorkOrder.TotalAmount,
                PixPayment = pixPayment
            });
        }
        catch
        {
            paymentInstallments.Add(new PaymentInstallmentFormModel { PaymentMethod = PaymentMethod.Cash, Amount = WorkOrder.TotalAmount });
        }

        isCompletionDialogOpen = true;
    }

    private void CloseCompletionDialog() => isCompletionDialogOpen = false;

    private async Task CompleteAsync()
    {
        if (!await FlushProgressAsync(false))
        {
            return;
        }

        MaintenanceRecommendationInput? recommendation = null;
        IReadOnlyList<MaintenanceRecommendationItemInput>? recommendationItems = null;
        if (shouldRecommendMaintenance && !TryCreateRecommendation(out recommendation, out recommendationItems))
        {
            Snackbar.Add("Preencha os dados da próxima manutenção.", Severity.Warning);
            return;
        }

        WorkOrderPaymentDecisionInput? paymentDecision = null;
        if (isNoCharge)
        {
            if (string.IsNullOrWhiteSpace(noChargeReason))
            {
                Snackbar.Add("Informe o motivo de não cobrança.", Severity.Warning);
                return;
            }

            paymentDecision = new WorkOrderPaymentDecisionInput(null, noChargeReason);
        }
        else if (WorkOrder.PaymentControlEnabled && WorkOrder.TotalAmount > 0)
        {
            if (paymentInstallments.Any(item => item.Amount <= 0 || (item.PaymentMethod == PaymentMethod.Other && string.IsNullOrWhiteSpace(item.OtherPaymentMethodDescription))))
            {
                Snackbar.Add("Informe valores válidos e descreva as outras formas de pagamento.", Severity.Warning);
                return;
            }

            if (PaymentInstallmentsTotal != WorkOrder.TotalAmount)
            {
                Snackbar.Add("As parcelas devem totalizar o valor da OS.", Severity.Warning);
                return;
            }

            paymentDecision = new WorkOrderPaymentDecisionInput(
                paymentInstallments.Select(item => new VoltaMarcada.Domain.ValueObjects.WorkOrderChargeInstallmentDefinition(item.PaymentMethod, item.Amount, item.OtherPaymentMethodDescription)).ToArray(),
                null);
        }

        var result = await OperationExecutor.ExecuteAsync(
            (CompleteWorkOrderUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(WorkOrder.Id, new CompleteWorkOrderCommand(recommendation, paymentDecision, recommendationItems), cancellationToken));
        if (result.IsSuccess)
        {
            isCompletionDialogOpen = false;
            Snackbar.Add("Serviço concluído.", Severity.Success);
            await OnChanged.InvokeAsync();
            return;
        }

        ShowOperationError(result.Error?.Code);
    }
