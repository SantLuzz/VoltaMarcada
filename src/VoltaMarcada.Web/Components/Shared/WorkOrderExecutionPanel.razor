    private async Task SharePixAsync(decimal amount, string payload)
    {
        var message = $"Olá! Segue o Pix para pagamento da OS no valor de {amount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))}:{Environment.NewLine}{payload}";
        if (string.IsNullOrWhiteSpace(WorkOrder.CustomerWhatsApp) || !WhatsAppLinkBuilder.TryBuild(WorkOrder.CustomerWhatsApp, message, out var link))
        {
            await CopyPixAsync(payload);
            Snackbar.Add("WhatsApp do cliente indisponível; o código Pix foi copiado.", Severity.Warning);
            return;
        }
        await JsRuntime.InvokeVoidAsync("open", link, "_blank");
    }
    private bool TryBuildPixPayload(decimal amount, out string payload)
    {
        payload = string.Empty;
        if (companyPaymentSettings is not { PixKey: { Length: > 0 } pixKey }) return false;
        var merchantAccount = PixField("00", "BR.GOV.BCB.PIX") + PixField("01", pixKey);
        var body = "000201" + PixField("26", merchantAccount) + "52040000" + "5303986" + PixField("54", amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)) + "5802BR" + PixField("59", "VOLTA MARCADA") + PixField("60", "BRASIL") + "62070503***" + "6304";
        payload = body + CalculatePixCrc16(body);
        return true;
    }

    private static string PixField(string id, string value) => $"{id}{value.Length:D2}{value}";

    private static string CalculatePixCrc16(string value)
    {
        ushort crc = 0xFFFF;
        foreach (var character in value)
        {
            crc ^= (ushort)(character << 8);
            for (var index = 0; index < 8; index++) crc = (ushort)((crc & 0x8000) != 0 ? (crc << 1) ^ 0x1021 : crc << 1);
        }
        return crc.ToString("X4");
    }

