    }
    private bool TryCreateRecommendation(out MaintenanceRecommendationInput? recommendation, out IReadOnlyList<MaintenanceRecommendationItemInput>? recommendationItems)
    {
        recommendation = null;
        recommendationItems = null;
        if (string.IsNullOrWhiteSpace(recommendationNotes)) return false;
        int? intervalDays = recommendationPeriod switch { "30" => 30, "60" => 60, "90" => 90, "180" => 180, "custom" => customIntervalDays, _ => null };
        DateOnly? dueDate = recommendationPeriod == "date" && recommendedDueDate is { } date ? DateOnly.FromDateTime(date) : null;
        if ((intervalDays is null) == (dueDate is null) || intervalDays is <= 0) return false;
        var equipment = RecommendedEquipment;
        foreach (var item in equipment) recommendedServiceIds.TryAdd(item.Id, recommendedServiceId ?? WorkOrder.ServiceId);
        if (equipment.Any(item => recommendedServiceIds.GetValueOrDefault(item.Id) is not { } serviceId || serviceId == Guid.Empty)) return false;
        recommendation = new MaintenanceRecommendationInput(intervalDays, dueDate, recommendedServiceIds[equipment[0].Id]!.Value, recommendationNotes);
        recommendationItems = equipment.Select(item => new MaintenanceRecommendationItemInput(item.Id, recommendedServiceIds[item.Id]!.Value)).ToArray();
        return true;
    }
private IReadOnlyList<(Guid Id, string Description)> RecommendedEquipment => WorkOrder.Items
        .Where(item => item.EquipmentId is not null)
        .Select(item => (Id: item.EquipmentId!.Value, Description: item.EquipmentDescription ?? "Equipamento"))
        .Append((Id: WorkOrder.EquipmentId, Description: "Equipamento principal"))
        .GroupBy(item => item.Id)
        .Select(group => (Id: group.Key, Description: group.First().Description))
        .ToArray();
private async Task UploadAsync(InputFileChangeEventArgs args, WorkOrderPhotoType type)
    {
        if (isSaving || isUploadingPhoto)
        {
            return;
        }

        var file = args.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            Snackbar.Add("A foto excede 10 MB.", Severity.Warning);
            return;
        }

        await operationLock.WaitAsync();
        isUploadingPhoto = true;
        await OnPhotoUploadChanged.InvokeAsync(true);
        try
        {
            return;
        }
        catch (Exception exception) when (exception is IOException or JSException)
        {
            Snackbar.Add("Não foi possível preparar a foto para envio. Tente novamente.", Severity.Warning);
        }
        finally
        {
            isUploadingPhoto = false;
            await OnPhotoUploadChanged.InvokeAsync(false);
            operationLock.Release();
        }
    }

    private async Task UploadAttachmentAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (isUploadingAttachment || file.Size > 10 * 1024 * 1024)
        {
            Snackbar.Add("O anexo excede 10 MB.", Severity.Warning);
            return;
        }

        isUploadingAttachment = true;
        try
        {
            await using var stream = file.OpenReadStream(10 * 1024 * 1024 + 1);
            var result = await OperationExecutor.ExecuteAsync(
                (AddWorkOrderAttachmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(
                    WorkOrder.Id, new WorkOrderAttachmentUpload(stream, file.Name, file.ContentType, file.Size, null), cancellationToken));
            if (!result.IsSuccess)
            {
                ShowOperationError(result.Error?.Code);
                return;
            }

            Snackbar.Add("Anexo enviado.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            isUploadingAttachment = false;
        }
    }

    private async Task RemoveAttachmentAsync(Guid attachmentId)
    {
        var result = await OperationExecutor.ExecuteAsync(
            (RemoveWorkOrderAttachmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(WorkOrder.Id, attachmentId, cancellationToken));
        if (!result.IsSuccess)
        {
            ShowOperationError(result.Error?.Code);
            return;
        }

        await OnChanged.InvokeAsync();
    }

    private static string FormatFileLength(long length) => length < 1024 * 1024
        ? $"{Math.Ceiling(length / 1024d):N0} KB"
        : $"{length / 1024d / 1024d:N1} MB";

    private string GetPhotoInputId(WorkOrderPhotoType type) => $"work-order-photo-{WorkOrder.Id:N}-{type}";
    private string GetPhotoPreviewId(WorkOrderPhotoType type) => $"work-order-photo-preview-{WorkOrder.Id:N}-{type}";
    private string GetPhotoStatusId(WorkOrderPhotoType type) => $"work-order-photo-status-{WorkOrder.Id:N}-{type}";

    private async Task RestoreStagedPhotosAsync()
    {
        foreach (var type in Enum.GetValues<WorkOrderPhotoType>())
        {
            try
            {
                var stagedPhoto = await RestoreStagedPhotoAsync(type);
                if (stagedPhoto is null)
                {
                    continue;
                }

                var content = Convert.FromBase64String(stagedPhoto.ContentBase64);
                if (content.Length is 0 or > 10 * 1024 * 1024)
                {
                    await ClearStagedPhotoAsync(type);
                    Snackbar.Add("Uma foto pendente não pôde ser restaurada.", Severity.Warning);
                    continue;
                }

                await operationLock.WaitAsync();
                isUploadingPhoto = true;
                await OnPhotoUploadChanged.InvokeAsync(true);
                try
                {
                    await UploadStagedPhotoAsync(type, stagedPhoto.FileName, stagedPhoto.ContentType, content);
                }
                finally
                {
                    isUploadingPhoto = false;
                    await OnPhotoUploadChanged.InvokeAsync(false);
                    operationLock.Release();
                }
            }
            catch (Exception exception) when (exception is FormatException or JSException)
            {
                Snackbar.Add("Não foi possível restaurar uma foto pendente.", Severity.Warning);
            }
        }
    }

