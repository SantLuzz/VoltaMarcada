@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using VoltaMarcada.Application.WorkOrders
@using VoltaMarcada.Application.Services
@using VoltaMarcada.Domain.Enums
@inject IComponentOperationExecutor OperationExecutor
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

@if (WorkOrder.Status == WorkOrderStatus.Pending)
{
    @if (WorkOrder.Capabilities.CanStart)
    {
        <MudStack Spacing="3" Class="work-order-execution-content">
            <MudButton OnClick="StartAsync" Color="Color.Primary" Variant="Variant.Filled">Iniciar atendimento</MudButton>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="3" Class="work-order-execution-content">
            <MudAlert Severity="Severity.Info">A OS precisa de um profissional habilitado antes de iniciar o atendimento.</MudAlert>
        </MudStack>
    }
}
else
{
    <MudStack Spacing="3" Class="work-order-execution-content">
        <MudText Typo="Typo.h6">Fotos antes @(WorkOrder.RequireBeforePhotos ? "(obrigatória)" : string.Empty)</MudText>
        @if (CanExecute)
        {
            <InputFile OnChange="@(args => UploadAsync(args, WorkOrderPhotoType.Before))" accept="image/*" capture="environment" disabled="@(isSaving || isUploadingPhoto)" />
        }
        <div class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.Before))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Foto antes" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" Disabled="@(IsRemovingPhoto || isSaving || isUploadingPhoto)" />
                    }
                </div>
            }
        </div>

        <MudText Typo="Typo.h6">Checklist</MudText>
        @if (WorkOrder.ChecklistItems.Count == 0)
        {
            <MudText Color="Color.Secondary">Este serviço não possui checklist configurado.</MudText>
        }
        else
        {
            @foreach (var item in WorkOrder.ChecklistItems)
            {
                <MudCheckBox T="bool" Value="@progress.GetValueOrDefault(item.Id)" ValueChanged="@(value => SetProgress(item.Id, value))" Disabled="@(!CanExecute)">
                    @item.Description @(item.IsRequired ? "(obrigatório)" : string.Empty)
                </MudCheckBox>
            }
        }

        <MudText Typo="Typo.h6">Fotos depois @(WorkOrder.RequireAfterPhotos ? "(obrigatória)" : string.Empty)</MudText>
        @if (CanExecute)
        {
            <InputFile OnChange="@(args => UploadAsync(args, WorkOrderPhotoType.After))" accept="image/*" capture="environment" disabled="@(isSaving || isUploadingPhoto)" />
        }
        <div class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.After))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Foto depois" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" Disabled="@(IsRemovingPhoto || isSaving || isUploadingPhoto)" />
                    }
                </div>
            }
        </div>

        <MudText Typo="Typo.h6">Outras fotos</MudText>
        @if (CanExecute)
        {
            <InputFile OnChange="@(args => UploadAsync(args, WorkOrderPhotoType.Other))" accept="image/*" capture="environment" disabled="@(isSaving || isUploadingPhoto)" />
        }
        <div class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.Other))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Outra foto" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" Disabled="@(IsRemovingPhoto || isSaving || isUploadingPhoto)" />
                    }
                </div>
            }
        </div>

        <MudTextField @bind-Value="executionNotes" @bind-Value:after="OnExecutionNotesChanged" Label="Observações da execução" Lines="4" Variant="Variant.Outlined" Disabled="@(!CanExecute || isUploadingPhoto)" />

        @if (CanExecute)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudSwitch @bind-Value="shouldRecommendMaintenance" Color="Color.Primary">Recomendar proxima manutencao?</MudSwitch>
                @if (shouldRecommendMaintenance)
                {
                    <MudGrid Class="mt-2">
                        <MudItem xs="12" sm="6"><MudSelect T="string" Label="Quando?" Variant="Variant.Outlined" Required="true" @bind-Value="recommendationPeriod"><MudSelectItem T="string" Value="@("30")">30 dias</MudSelectItem><MudSelectItem T="string" Value="@("60")">60 dias</MudSelectItem><MudSelectItem T="string" Value="@("90")">90 dias</MudSelectItem><MudSelectItem T="string" Value="@("180")">180 dias</MudSelectItem><MudSelectItem T="string" Value="@("custom")">Personalizado</MudSelectItem><MudSelectItem T="string" Value="@("date")">Data especifica</MudSelectItem></MudSelect></MudItem>
                        @if (recommendationPeriod == "custom") { <MudItem xs="12" sm="6"><MudNumericField T="int?" Label="Intervalo em dias" Variant="Variant.Outlined" Required="true" @bind-Value="customIntervalDays" /></MudItem> }
                        @if (recommendationPeriod == "date") { <MudItem xs="12" sm="6"><MudDatePicker Label="Proxima manutencao" Variant="Variant.Outlined" Required="true" @bind-Date="recommendedDueDate" /></MudItem> }
                        <MudItem xs="12" sm="6"><MudSelect T="Guid?" Label="Servico recomendado" Variant="Variant.Outlined" Required="true" @bind-Value="recommendedServiceId">@foreach (var service in services) { <MudSelectItem Value="@((Guid?)service.Id)">@service.Name</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12"><MudTextField Label="Observacoes da recomendacao" Variant="Variant.Outlined" Required="true" Lines="3" @bind-Value="recommendationNotes" /></MudItem>
                    </MudGrid>
                }
            </MudPaper>
            <MudStack Row="true">
                <MudButton OnClick="SaveAsync" Variant="Variant.Outlined" Disabled="@(isSaving || isUploadingPhoto)">Salvar progresso</MudButton>
                <MudButton OnClick="CompleteAsync" Color="Color.Success" Variant="Variant.Filled" Disabled="@(!CanComplete)">Concluir serviço</MudButton>
            </MudStack>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public WorkOrderDetailDto WorkOrder { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnSavingChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnPhotoUploadChanged { get; set; }

    private readonly Dictionary<Guid, bool> progress = [];
    private readonly SemaphoreSlim operationLock = new(1, 1);
    private CancellationTokenSource? autosaveCancellation;
    private IJSObjectReference? photoStagingModule;
    private WorkOrderDetailDto? loadedWorkOrder;
    private string? executionNotes;
    private string? observedExecutionNotes;
    private bool isSaving;
    private bool isUploadingPhoto;
    private bool isDisposed;
    private Guid? photoPendingRemoval;
    private long changeVersion;
    private long savedChangeVersion;
    private IReadOnlyList<ServiceDto> services = [];
    private bool shouldRecommendMaintenance;
    private string? recommendationPeriod;
    private int? customIntervalDays;
    private DateTime? recommendedDueDate;
    private Guid? recommendedServiceId;
    private string? recommendationNotes;
    private Guid? restoredStagedPhotosForWorkOrderId;

    private bool CanExecute => WorkOrder.Status == WorkOrderStatus.InProgress && WorkOrder.Capabilities.CanExecute;
    private bool IsRemovingPhoto => photoPendingRemoval is not null;
    private bool CanComplete => CanExecute && !isSaving && !isUploadingPhoto && !HasMissingRequiredPhotos && !IsCompletionBlockedByPhotoRemoval;
    private bool HasMissingRequiredPhotos =>
        (WorkOrder.RequireBeforePhotos && !HasPhotoOfType(WorkOrderPhotoType.Before)) ||
        (WorkOrder.RequireAfterPhotos && !HasPhotoOfType(WorkOrderPhotoType.After));

    private bool IsCompletionBlockedByPhotoRemoval
    {
        get
        {
            if (photoPendingRemoval is not { } photoId)
            {
                return false;
            }

            var photo = WorkOrder.Photos.SingleOrDefault(item => item.Id == photoId);
            if (photo is null || !IsRequiredPhotoType(photo.Type))
            {
                return false;
            }

            return WorkOrder.Photos.Count(item => item.Type == photo.Type) == 1;
        }
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(loadedWorkOrder, WorkOrder))
        {
            return;
        }

        loadedWorkOrder = WorkOrder;
        progress.Clear();
        foreach (var item in WorkOrder.ChecklistItems)
        {
            progress[item.Id] = item.IsCompleted;
        }

        executionNotes = WorkOrder.ExecutionNotes;
        observedExecutionNotes = executionNotes;
        changeVersion = 0;
        savedChangeVersion = 0;
        recommendedServiceId = WorkOrder.ServiceId;
    }

    protected override async Task OnInitializedAsync() => services = (await OperationExecutor.ExecuteAsync(
        (GetServicesUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(null, cancellationToken))).Where(service => service.IsActive).ToArray();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (restoredStagedPhotosForWorkOrderId == WorkOrder.Id || !CanExecute)
        {
            return;
        }

        await RestoreStagedPhotosAsync();
        restoredStagedPhotosForWorkOrderId = WorkOrder.Id;
    }

    private async Task StartAsync()
    {
        var result = await OperationExecutor.ExecuteAsync(
            (StartWorkOrderUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(WorkOrder.Id, cancellationToken));
        if (result.IsSuccess)
        {
            await OnChanged.InvokeAsync();
            return;
        }

        ShowOperationError(result.Error?.Code);
    }

    private void SetProgress(Guid id, bool value)
    {
        if (progress.GetValueOrDefault(id) == value)
        {
            return;
        }

        progress[id] = value;
        RegisterChange();
    }

    private void OnExecutionNotesChanged()
    {
        if (string.Equals(executionNotes, observedExecutionNotes, StringComparison.Ordinal))
        {
            return;
        }

        observedExecutionNotes = executionNotes;
        RegisterChange();
    }

    private void RegisterChange()
    {
        changeVersion++;
        ScheduleAutoSave();
    }

    private void ScheduleAutoSave()
    {
        if (!CanExecute || isDisposed)
        {
            return;
        }

        autosaveCancellation?.Cancel();
        autosaveCancellation?.Dispose();
        autosaveCancellation = new CancellationTokenSource();
        _ = SaveAfterDelayAsync(autosaveCancellation.Token);
    }

    private async Task SaveAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1.5), cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (isDisposed)
            {
                return;
            }

            await FlushProgressAsync(false, cancellationToken);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SaveAsync() => await FlushProgressAsync(true);

    public async Task<bool> SavePendingChangesAsync()
    {
        autosaveCancellation?.Cancel();
        return await FlushProgressAsync(false);
    }

    private async Task<bool> FlushProgressAsync(bool showSuccess, CancellationToken cancellationToken = default)
    {
        if (!CanExecute || changeVersion == savedChangeVersion)
        {
            return true;
        }

        await operationLock.WaitAsync(cancellationToken);
        try
        {
            if (!CanExecute || changeVersion == savedChangeVersion)
            {
                return true;
            }

            autosaveCancellation?.Cancel();
            isSaving = true;
            await OnSavingChanged.InvokeAsync(true);
            var versionBeingSaved = changeVersion;
            var command = new SaveWorkOrderChecklistProgressCommand(
                progress.Select(item => new ChecklistProgressInput(item.Key, item.Value)).ToArray(),
                executionNotes);
            var result = await OperationExecutor.ExecuteAsync(
                (SaveWorkOrderChecklistProgressUseCase useCase, CancellationToken token) => useCase.ExecuteAsync(WorkOrder.Id, command, token),
                cancellationToken);
            if (!result.IsSuccess)
            {
                ShowOperationError(result.Error?.Code);
                return false;
            }

            savedChangeVersion = versionBeingSaved;
            if (showSuccess)
            {
                Snackbar.Add("Progresso salvo.", Severity.Success);
            }

            await OnChanged.InvokeAsync();
            return true;
        }
        finally
        {
            isSaving = false;
            await OnSavingChanged.InvokeAsync(false);
            operationLock.Release();
        }
    }

    private async Task CompleteAsync()
    {
        if (!await FlushProgressAsync(false))
        {
            return;
        }

        MaintenanceRecommendationInput? recommendation = null;
        if (shouldRecommendMaintenance && !TryCreateRecommendation(out recommendation))
        {
            Snackbar.Add("Preencha os dados da proxima manutencao.", Severity.Warning);
            return;
        }

        var result = await OperationExecutor.ExecuteAsync(
            (CompleteWorkOrderUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(WorkOrder.Id, new CompleteWorkOrderCommand(recommendation), cancellationToken));
        if (result.IsSuccess)
        {
            Snackbar.Add("Serviço concluído.", Severity.Success);
            await OnChanged.InvokeAsync();
            return;
        }

        ShowOperationError(result.Error?.Code);
    }

    private bool TryCreateRecommendation(out MaintenanceRecommendationInput? recommendation)
    {
        recommendation = null;
        if (recommendedServiceId is null || string.IsNullOrWhiteSpace(recommendationNotes)) return false;
        int? intervalDays = recommendationPeriod switch { "30" => 30, "60" => 60, "90" => 90, "180" => 180, "custom" => customIntervalDays, _ => null };
        DateOnly? dueDate = recommendationPeriod == "date" && recommendedDueDate is { } date ? DateOnly.FromDateTime(date) : null;
        if ((intervalDays is null) == (dueDate is null) || intervalDays is <= 0) return false;
        recommendation = new MaintenanceRecommendationInput(intervalDays, dueDate, recommendedServiceId.Value, recommendationNotes);
        return true;
    }

    private async Task UploadAsync(InputFileChangeEventArgs args, WorkOrderPhotoType type)
    {
        if (isSaving || isUploadingPhoto)
        {
            return;
        }

        var file = args.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            Snackbar.Add("A foto excede 10 MB.", Severity.Warning);
            return;
        }

        await operationLock.WaitAsync();
        isUploadingPhoto = true;
        await OnPhotoUploadChanged.InvokeAsync(true);
        try
        {
            var content = await ReadPhotoAsync(file);
            await StagePhotoAsync(type, file.Name, file.ContentType, content);
            await UploadStagedPhotoAsync(type, file.Name, file.ContentType, content);
        }
        catch (Exception exception) when (exception is IOException or JSException)
        {
            Snackbar.Add("Não foi possível preparar a foto para envio. Tente novamente.", Severity.Warning);
        }
        finally
        {
            isUploadingPhoto = false;
            await OnPhotoUploadChanged.InvokeAsync(false);
            operationLock.Release();
        }
    }

    private async Task RestoreStagedPhotosAsync()
    {
        foreach (var type in Enum.GetValues<WorkOrderPhotoType>())
        {
            try
            {
                var stagedPhoto = await RestoreStagedPhotoAsync(type);
                if (stagedPhoto is null)
                {
                    continue;
                }

                var content = Convert.FromBase64String(stagedPhoto.ContentBase64);
                if (content.Length is 0 or > 10 * 1024 * 1024)
                {
                    await ClearStagedPhotoAsync(type);
                    Snackbar.Add("Uma foto pendente não pôde ser restaurada.", Severity.Warning);
                    continue;
                }

                await operationLock.WaitAsync();
                isUploadingPhoto = true;
                await OnPhotoUploadChanged.InvokeAsync(true);
                try
                {
                    await UploadStagedPhotoAsync(type, stagedPhoto.FileName, stagedPhoto.ContentType, content);
                }
                finally
                {
                    isUploadingPhoto = false;
                    await OnPhotoUploadChanged.InvokeAsync(false);
                    operationLock.Release();
                }
            }
            catch (Exception exception) when (exception is FormatException or JSException)
            {
                Snackbar.Add("Não foi possível restaurar uma foto pendente.", Severity.Warning);
            }
        }
    }

    private async Task<byte[]> ReadPhotoAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(10 * 1024 * 1024 + 1);
        await using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    private async Task UploadStagedPhotoAsync(WorkOrderPhotoType type, string fileName, string contentType, byte[] content)
    {
        await using var stream = new MemoryStream(content, writable: false);
        var result = await OperationExecutor.ExecuteAsync(
            (AddWorkOrderPhotoUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(
                WorkOrder.Id,
                new WorkOrderPhotoUpload(stream, fileName, contentType, content.Length, type, null),
                cancellationToken));
        if (!result.IsSuccess)
        {
            ShowOperationError(result.Error?.Code);
            return;
        }

        await ClearStagedPhotoAsync(type);
        Snackbar.Add("Foto enviada.", Severity.Success);
        await OnChanged.InvokeAsync();
    }

    private async Task StagePhotoAsync(WorkOrderPhotoType type, string fileName, string contentType, byte[] content)
    {
        var module = await GetPhotoStagingModuleAsync();
        await module.InvokeVoidAsync(
            "stagePhoto",
            WorkOrder.Id,
            type,
            fileName,
            contentType,
            Convert.ToBase64String(content));
    }

    private async Task<StagedWorkOrderPhoto?> RestoreStagedPhotoAsync(WorkOrderPhotoType type)
    {
        var module = await GetPhotoStagingModuleAsync();
        return await module.InvokeAsync<StagedWorkOrderPhoto?>("restoreStagedPhoto", WorkOrder.Id, type);
    }

    private async Task ClearStagedPhotoAsync(WorkOrderPhotoType type)
    {
        var module = await GetPhotoStagingModuleAsync();
        await module.InvokeVoidAsync("clearStagedPhoto", WorkOrder.Id, type);
    }

    private async Task<IJSObjectReference> GetPhotoStagingModuleAsync() =>
        photoStagingModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/work-order-photo-staging.js");

    private async Task RemovePhotoAsync(Guid photoId)
    {
        if (IsRemovingPhoto || isSaving || isUploadingPhoto)
        {
            return;
        }

        photoPendingRemoval = photoId;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (RemoveWorkOrderPhotoUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(WorkOrder.Id, photoId, cancellationToken));
            if (result.IsSuccess)
            {
                await OnChanged.InvokeAsync();
                return;
            }

            ShowOperationError(result.Error?.Code);
        }
        finally
        {
            photoPendingRemoval = null;
        }
    }

    private bool IsRequiredPhotoType(WorkOrderPhotoType type) => type switch
    {
        WorkOrderPhotoType.Before => WorkOrder.RequireBeforePhotos,
        WorkOrderPhotoType.After => WorkOrder.RequireAfterPhotos,
        _ => false
    };

    private bool HasPhotoOfType(WorkOrderPhotoType type) =>
        WorkOrder.Photos.Any(photo => photo.Type == type);

    private void ShowOperationError(string? code)
    {
        Snackbar.Add(OperationErrorMessages.GetMessage(code), Severity.Warning);
    }

    private sealed record StagedWorkOrderPhoto(string FileName, string ContentType, string ContentBase64);

    public async ValueTask DisposeAsync()
    {
        isDisposed = true;
        autosaveCancellation?.Cancel();
        autosaveCancellation?.Dispose();
        if (photoStagingModule is not null)
        {
            try
            {
                await photoStagingModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
