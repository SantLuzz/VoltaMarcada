@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using VoltaMarcada.Application.WorkOrders
@using VoltaMarcada.Application.Services
@using VoltaMarcada.Application.Payments
@using VoltaMarcada.Application.Abstractions.Communication
@using VoltaMarcada.Domain.Enums
@inject IComponentOperationExecutor OperationExecutor
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime
@inject IWhatsAppLinkBuilder WhatsAppLinkBuilder

@if (WorkOrder.Status == WorkOrderStatus.Pending)
{
    @if (WorkOrder.Capabilities.CanStart)
    {
        <MudStack Spacing="3" Class="work-order-execution-content">
            <MudButton OnClick="StartAsync" Color="Color.Primary" Variant="Variant.Filled">Iniciar atendimento</MudButton>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="3" Class="work-order-execution-content">
            <MudAlert Severity="Severity.Info">A OS precisa de um profissional habilitado antes de iniciar o atendimento.</MudAlert>
        </MudStack>
    }
}
else
{
    <MudStack Spacing="3" Class="work-order-execution-content">
        <MudText Typo="Typo.h6">Fotos antes @(WorkOrder.RequireBeforePhotos ? "(obrigatória)" : string.Empty)</MudText>
        @if (CanExecute)
        {
            <input id="@GetPhotoInputId(WorkOrderPhotoType.Before)" class="native-file-input" type="file" accept="image/*" capture="environment" disabled="@(isSaving || isUploadingPhoto)" />
            <MudText id="@GetPhotoStatusId(WorkOrderPhotoType.Before)" Typo="Typo.caption" Color="Color.Secondary" />
        }
        <div id="@GetPhotoPreviewId(WorkOrderPhotoType.Before)" class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.Before))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Foto antes" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" Disabled="@(IsRemovingPhoto || isSaving || isUploadingPhoto)" />
                    }
                </div>
            }
        </div>

        <MudText Typo="Typo.h6">Checklist</MudText>
        @if (WorkOrder.ChecklistItems.Count == 0)
        {
            <MudText Color="Color.Secondary">Este serviço não possui checklist configurado.</MudText>
        }
        else
        {
            @foreach (var item in WorkOrder.ChecklistItems)
            {
                <MudCheckBox T="bool" Value="@progress.GetValueOrDefault(item.Id)" ValueChanged="@(value => SetProgress(item.Id, value))" Disabled="@(!CanExecute)">
                    @item.Description @(item.IsRequired ? "(obrigatório)" : string.Empty)
                </MudCheckBox>
            }
        }

        <MudText Typo="Typo.h6">Fotos depois @(WorkOrder.RequireAfterPhotos ? "(obrigatória)" : string.Empty)</MudText>
        @if (CanExecute)
        {
            <input id="@GetPhotoInputId(WorkOrderPhotoType.After)" class="native-file-input" type="file" accept="image/*" capture="environment" disabled="@(isSaving || isUploadingPhoto)" />
            <MudText id="@GetPhotoStatusId(WorkOrderPhotoType.After)" Typo="Typo.caption" Color="Color.Secondary" />
        }
        <div id="@GetPhotoPreviewId(WorkOrderPhotoType.After)" class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.After))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Foto depois" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" Disabled="@(IsRemovingPhoto || isSaving || isUploadingPhoto)" />
                    }
                </div>
            }
        </div>

        <MudText Typo="Typo.h6">Outras fotos</MudText>
        @if (CanExecute)
        {
            <input id="@GetPhotoInputId(WorkOrderPhotoType.Other)" class="native-file-input" type="file" accept="image/*" capture="environment" disabled="@(isSaving || isUploadingPhoto)" />
            <MudText id="@GetPhotoStatusId(WorkOrderPhotoType.Other)" Typo="Typo.caption" Color="Color.Secondary" />
        }
        <div id="@GetPhotoPreviewId(WorkOrderPhotoType.Other)" class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.Other))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Outra foto" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" Disabled="@(IsRemovingPhoto || isSaving || isUploadingPhoto)" />
                    }
                </div>
            }
        </div>

        <MudText Typo="Typo.h6">Anexos</MudText>
        @if (CanExecute)
        {
            <InputFile OnChange="UploadAttachmentAsync" accept="application/pdf,image/*" disabled="@(isSaving || isUploadingPhoto || isUploadingAttachment)" />
        }
        @if (WorkOrder.Attachments.Count == 0)
        {
            <MudText Color="Color.Secondary">Nenhum anexo adicionado.</MudText>
        }
        else
        {
            <div>
                @foreach (var attachment in WorkOrder.Attachments)
                {
                    <div>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="work-order-attachment-row">
                            <MudLink Href="@($"/work-orders/{WorkOrder.Id}/attachments/{attachment.Id}/content")" Target="_blank">@attachment.OriginalFileName</MudLink>
                            <MudText Typo="Typo.caption">@FormatFileLength(attachment.Length)</MudText>
                            @if (!string.IsNullOrWhiteSpace(attachment.Description))
                            {
                                <MudText Typo="Typo.caption">@attachment.Description</MudText>
                            }
                            @if (CanExecute)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover anexo" OnClick="@(() => RemoveAttachmentAsync(attachment.Id))" Disabled="@isUploadingAttachment" />
                            }
                        </MudStack>
                    </div>
                }
            </div>
        }

        <MudTextField @bind-Value="executionNotes" @bind-Value:after="OnExecutionNotesChanged" Label="Observações da execução" Lines="4" Variant="Variant.Outlined" Disabled="@(!CanExecute || isUploadingPhoto)" />

        @if (CanExecute)
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudSwitch @bind-Value="shouldRecommendMaintenance" Color="Color.Primary">Recomendar proxima manutencao?</MudSwitch>
                @if (shouldRecommendMaintenance)
                {
                    <MudGrid Class="mt-2">
                        <MudItem xs="12" sm="6"><MudSelect T="string" Label="Quando?" Variant="Variant.Outlined" Required="true" @bind-Value="recommendationPeriod"><MudSelectItem T="string" Value="@("30")">30 dias</MudSelectItem><MudSelectItem T="string" Value="@("60")">60 dias</MudSelectItem><MudSelectItem T="string" Value="@("90")">90 dias</MudSelectItem><MudSelectItem T="string" Value="@("180")">180 dias</MudSelectItem><MudSelectItem T="string" Value="@("custom")">Personalizado</MudSelectItem><MudSelectItem T="string" Value="@("date")">Data especifica</MudSelectItem></MudSelect></MudItem>
                        @if (recommendationPeriod == "custom") { <MudItem xs="12" sm="6"><MudNumericField T="int?" Label="Intervalo em dias" Variant="Variant.Outlined" Required="true" @bind-Value="customIntervalDays" /></MudItem> }
                        @if (recommendationPeriod == "date") { <MudItem xs="12" sm="6"><MudDatePicker Label="Proxima manutencao" Variant="Variant.Outlined" Required="true" @bind-Date="recommendedDueDate" /></MudItem> }
                        <MudItem xs="12" sm="6"><MudSelect T="Guid?" Label="Servico recomendado" Variant="Variant.Outlined" Required="true" @bind-Value="recommendedServiceId">@foreach (var service in services) { <MudSelectItem Value="@((Guid?)service.Id)">@service.Name</MudSelectItem> }</MudSelect></MudItem>
                        <MudItem xs="12"><MudTextField Label="Observacoes da recomendacao" Variant="Variant.Outlined" Required="true" Lines="3" @bind-Value="recommendationNotes" /></MudItem>
                    </MudGrid>
                }
            </MudPaper>
            @if (WorkOrder.PaymentControlEnabled && WorkOrder.TotalAmount > 0)
            {
                <MudDialog @bind-Visible="isPaymentDialogOpen" Options="paymentDialogOptions">
                    <TitleContent><MudText Typo="Typo.h6">Cobrança da OS</MudText></TitleContent>
                    <DialogContent>
                    <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.h6">Cobrança</MudText>
                    <MudSwitch @bind-Value="isNoCharge" Color="Color.Primary">Sem cobrança</MudSwitch>
                    @if (isNoCharge)
                    {
                        <MudTextField @bind-Value="noChargeReason" Label="Motivo" Required="true" Lines="3" Variant="Variant.Outlined" />
                    }
                    else
                    {
                        @foreach (var installment in paymentInstallments)
                        {
                            <MudGrid Class="mt-2">
                                <MudItem xs="12" sm="5"><MudSelect T="PaymentMethod" Label="Forma de pagamento" Variant="Variant.Outlined" @bind-Value="installment.PaymentMethod">@foreach (var method in Enum.GetValues<PaymentMethod>()) { <MudSelectItem Value="@method">@GetPaymentMethodLabel(method, null)</MudSelectItem> }</MudSelect></MudItem>
                                <MudItem xs="10" sm="5"><MudNumericField T="decimal" @bind-Value="installment.Amount" Label="Valor" Min="0.01m" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="2"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover parcela" Disabled="@(paymentInstallments.Count == 1)" OnClick="@(() => RemovePaymentInstallment(installment))" /></MudItem>
                                @if (installment.PaymentMethod == PaymentMethod.Other) { <MudItem xs="12"><MudTextField @bind-Value="installment.OtherPaymentMethodDescription" Label="Descreva a forma de pagamento" Required="true" Variant="Variant.Outlined" /></MudItem> }
                                @if (installment.PaymentMethod == PaymentMethod.Pix && TryBuildPixPayload(installment.Amount, out var pixPayload)) { <MudItem xs="12"><MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"><PixQrCode Payload="@pixPayload" /><MudTextField T="string" Value="@pixPayload" Label="Pix Copia e Cola" ReadOnly="true" Variant="Variant.Outlined" FullWidth="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy" OnAdornmentClick="@(() => CopyPixAsync(pixPayload))" /></MudStack><MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Share" OnClick="@(() => SharePixAsync(installment.Amount, pixPayload))">Compartilhar no WhatsApp</MudButton></MudItem> }
                            </MudGrid>
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3"><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddPaymentInstallment">Adicionar parcela</MudButton><MudText>Subtotal: @PaymentInstallmentsTotal.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) de @WorkOrder.TotalAmount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</MudText></MudStack>
                    }
                    </MudPaper></DialogContent><DialogActions><MudButton OnClick="ClosePaymentDialog">Cancelar</MudButton><MudButton OnClick="CompleteAsync" Color="Color.Success" Variant="Variant.Filled">Concluir serviço</MudButton></DialogActions></MudDialog>
            }            <MudStack Row="true">
                <MudButton OnClick="SaveAsync" Variant="Variant.Outlined" Disabled="@(isSaving || isUploadingPhoto)">Salvar progresso</MudButton>
                <MudButton OnClick="OpenPaymentDialog" Color="Color.Success" Variant="Variant.Filled" Disabled="@(!CanComplete)">Concluir serviço</MudButton>
            </MudStack>
        }
        @if (WorkOrder.PaymentControlEnabled && WorkOrder.ChargeInstallments is { Count: > 0 })
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6">Parcelas de cobrança</MudText>
                <MudTable Items="WorkOrder.ChargeInstallments" Dense="true">
                    <HeaderContent><MudTh>Forma</MudTh><MudTh>Valor</MudTh><MudTh>Status</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd>@GetPaymentMethodLabel(context.PaymentMethod, context.OtherPaymentMethodDescription)</MudTd>
                        <MudTd>@context.Amount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</MudTd>
                        <MudTd><MudChip T="string" Size="Size.Small" Color="@GetInstallmentColor(context.Status)">@GetInstallmentStatusLabel(context.Status)</MudChip></MudTd>
                        <MudTd>
                            @if (WorkOrder.Capabilities.CanManagePayments && context.Status != WorkOrderChargeInstallmentStatus.Deleted)
                            {
                                @if (context.Status == WorkOrderChargeInstallmentStatus.Pending) { <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" AriaLabel="Confirmar parcela" OnClick="@(() => ConfirmInstallmentAsync(context.Id))" /> }
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" AriaLabel="Editar parcela" OnClick="@(() => OpenEditInstallment(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Excluir parcela" OnClick="@(() => DeleteInstallmentAsync(context.Id))" />
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    </MudStack>
}

<MudDialog @bind-Visible="isEditInstallmentDialogOpen" Options="editInstallmentDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Editar parcela</MudText></TitleContent>
    <DialogContent>
        <MudNumericField T="decimal" @bind-Value="editInstallmentAmount" Label="Valor" Min="0.01m" Variant="Variant.Outlined" FullWidth="true" />
        <MudSelect T="PaymentMethod" @bind-Value="editInstallmentPaymentMethod" Label="Forma de pagamento" Variant="Variant.Outlined" FullWidth="true" Class="mt-3">
            @foreach (var method in Enum.GetValues<PaymentMethod>()) { <MudSelectItem Value="@method">@GetPaymentMethodLabel(method, null)</MudSelectItem> }
        </MudSelect>
        @if (editInstallmentPaymentMethod == PaymentMethod.Other) { <MudTextField @bind-Value="editInstallmentOtherDescription" Label="Descreva a forma" Variant="Variant.Outlined" FullWidth="true" Class="mt-3" /> }
    </DialogContent>
    <DialogActions><MudButton OnClick="CloseEditInstallment">Cancelar</MudButton><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveInstallmentAsync">Salvar</MudButton></DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired]
    public WorkOrderDetailDto WorkOrder { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnSavingChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnPhotoUploadChanged { get; set; }

    private readonly Dictionary<Guid, bool> progress = [];
    private readonly SemaphoreSlim operationLock = new(1, 1);
    private CancellationTokenSource? autosaveCancellation;
    private IJSObjectReference? photoStagingModule;
    private WorkOrderDetailDto? loadedWorkOrder;
    private string? executionNotes;
    private string? observedExecutionNotes;
    private bool isSaving;
    private bool isUploadingPhoto;
    private bool isUploadingAttachment;
    private bool isDisposed;
    private Guid? photoPendingRemoval;
    private long changeVersion;
    private long savedChangeVersion;
    private IReadOnlyList<ServiceDto> services = [];
    private CompanyPaymentSettingsDto? companyPaymentSettings;
    private bool shouldRecommendMaintenance;
    private readonly DialogOptions paymentDialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
    private bool isPaymentDialogOpen;
    private bool isNoCharge;
    private readonly List<PaymentInstallmentFormModel> paymentInstallments = [new()];
    private string? noChargeReason;
    private readonly DialogOptions editInstallmentDialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
    private bool isEditInstallmentDialogOpen;
    private Guid? editingInstallmentId;
    private decimal editInstallmentAmount;
    private PaymentMethod editInstallmentPaymentMethod;
    private string? editInstallmentOtherDescription;
    private string? recommendationPeriod;
    private int? customIntervalDays;
    private DateTime? recommendedDueDate;
    private Guid? recommendedServiceId;
    private string? recommendationNotes;
    private Guid? restoredStagedPhotosForWorkOrderId;

    private bool CanExecute => WorkOrder.Status == WorkOrderStatus.InProgress && WorkOrder.Capabilities.CanExecute;
    private bool IsRemovingPhoto => photoPendingRemoval is not null;
    private bool CanComplete => CanExecute && !isSaving && !isUploadingPhoto && !HasMissingRequiredPhotos && !IsCompletionBlockedByPhotoRemoval;
    private bool HasMissingRequiredPhotos =>
        (WorkOrder.RequireBeforePhotos && !HasPhotoOfType(WorkOrderPhotoType.Before)) ||
        (WorkOrder.RequireAfterPhotos && !HasPhotoOfType(WorkOrderPhotoType.After));

    private bool IsCompletionBlockedByPhotoRemoval
    {
        get
        {
            if (photoPendingRemoval is not { } photoId)
            {
                return false;
            }

            var photo = WorkOrder.Photos.SingleOrDefault(item => item.Id == photoId);
            if (photo is null || !IsRequiredPhotoType(photo.Type))
            {
                return false;
            }

            return WorkOrder.Photos.Count(item => item.Type == photo.Type) == 1;
        }
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(loadedWorkOrder, WorkOrder))
        {
            return;
        }

        loadedWorkOrder = WorkOrder;
        progress.Clear();
        foreach (var item in WorkOrder.ChecklistItems)
        {
            progress[item.Id] = item.IsCompleted;
        }

        executionNotes = WorkOrder.ExecutionNotes;
        observedExecutionNotes = executionNotes;
        changeVersion = 0;
        savedChangeVersion = 0;
        recommendedServiceId = WorkOrder.ServiceId;
    }

    protected override async Task OnInitializedAsync()
    {
        companyPaymentSettings = await OperationExecutor.ExecuteAsync((GetCompanyPaymentSettingsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(cancellationToken));
        services = (await OperationExecutor.ExecuteAsync(
        (GetServicesUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(null, cancellationToken))).Where(service => service.IsActive).ToArray();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (restoredStagedPhotosForWorkOrderId == WorkOrder.Id || !CanExecute)
        {
            return;
        }

        var module = await GetPhotoStagingModuleAsync();
        foreach (var type in Enum.GetValues<WorkOrderPhotoType>())
        {
            await module.InvokeVoidAsync("initializePhotoInput", GetPhotoInputId(type), GetPhotoPreviewId(type), GetPhotoStatusId(type), WorkOrder.Id, type);
            await module.InvokeVoidAsync("restoreAndUploadStagedPhoto", WorkOrder.Id, type);
        }
        restoredStagedPhotosForWorkOrderId = WorkOrder.Id;
    }

    private async Task StartAsync()
    {
        var result = await OperationExecutor.ExecuteAsync(
            (StartWorkOrderUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(WorkOrder.Id, cancellationToken));
        if (result.IsSuccess)
        {
            await OnChanged.InvokeAsync();
            return;
        }

        ShowOperationError(result.Error?.Code);
    }

    private void SetProgress(Guid id, bool value)
    {
        if (progress.GetValueOrDefault(id) == value)
        {
            return;
        }

        progress[id] = value;
        RegisterChange();
    }

    private void OnExecutionNotesChanged()
    {
        if (string.Equals(executionNotes, observedExecutionNotes, StringComparison.Ordinal))
        {
            return;
        }

        observedExecutionNotes = executionNotes;
        RegisterChange();
    }

    private void RegisterChange()
    {
        changeVersion++;
        ScheduleAutoSave();
    }

    private void ScheduleAutoSave()
    {
        if (!CanExecute || isDisposed)
        {
            return;
        }

        autosaveCancellation?.Cancel();
        autosaveCancellation?.Dispose();
        autosaveCancellation = new CancellationTokenSource();
        _ = SaveAfterDelayAsync(autosaveCancellation.Token);
    }

    private async Task SaveAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1.5), cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            if (isDisposed)
            {
                return;
            }

            await FlushProgressAsync(false, cancellationToken);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SaveAsync()
    {
        if (changeVersion == savedChangeVersion)
        {
            Snackbar.Add("Não há alterações pendentes para salvar.", Severity.Info);
            return;
        }

        await FlushProgressAsync(true);
    }

    public async Task<bool> SavePendingChangesAsync()
    {
        autosaveCancellation?.Cancel();
        return await FlushProgressAsync(false);
    }

    private async Task<bool> FlushProgressAsync(bool showSuccess, CancellationToken cancellationToken = default)
    {
        if (!CanExecute || changeVersion == savedChangeVersion)
        {
            return true;
        }

        await operationLock.WaitAsync(cancellationToken);
        try
        {
            if (!CanExecute || changeVersion == savedChangeVersion)
            {
                return true;
            }

            autosaveCancellation?.Cancel();
            isSaving = true;
            await OnSavingChanged.InvokeAsync(true);
            var versionBeingSaved = changeVersion;
            var command = new SaveWorkOrderChecklistProgressCommand(
                progress.Select(item => new ChecklistProgressInput(item.Key, item.Value)).ToArray(),
                executionNotes);
            var result = await OperationExecutor.ExecuteAsync(
                (SaveWorkOrderChecklistProgressUseCase useCase, CancellationToken token) => useCase.ExecuteAsync(WorkOrder.Id, command, token),
                cancellationToken);
            if (!result.IsSuccess)
            {
                ShowOperationError(result.Error?.Code);
                return false;
            }

            savedChangeVersion = versionBeingSaved;
            if (showSuccess)
            {
                Snackbar.Add("Progresso salvo.", Severity.Success);
            }

            await OnChanged.InvokeAsync();
            return true;
        }
        finally
        {
            isSaving = false;
            await OnSavingChanged.InvokeAsync(false);
            operationLock.Release();
        }
    }

    private void OpenPaymentDialog() => isPaymentDialogOpen = true;

    private void ClosePaymentDialog() => isPaymentDialogOpen = false;

    private async Task CompleteAsync()
    {
        if (!await FlushProgressAsync(false))
        {
            return;
        }

        MaintenanceRecommendationInput? recommendation = null;
        if (shouldRecommendMaintenance && !TryCreateRecommendation(out recommendation))
        {
            Snackbar.Add("Preencha os dados da proxima manutencao.", Severity.Warning);
            return;
        }

        WorkOrderPaymentDecisionInput? paymentDecision = null;
        if (WorkOrder.PaymentControlEnabled && WorkOrder.TotalAmount > 0)
        {
            if (isNoCharge)
            {
                if (string.IsNullOrWhiteSpace(noChargeReason))
                {
                    Snackbar.Add("Informe o motivo de sem cobrança.", Severity.Warning);
                    return;
                }

                paymentDecision = new WorkOrderPaymentDecisionInput(null, noChargeReason);
            }
            else
            {
                if (PaymentInstallmentsTotal != WorkOrder.TotalAmount || paymentInstallments.Any(item => item.Amount <= 0 || (item.PaymentMethod == PaymentMethod.Other && string.IsNullOrWhiteSpace(item.OtherPaymentMethodDescription))))
                {
                    Snackbar.Add("As parcelas devem totalizar o valor da OS.", Severity.Warning);
                    return;
                }

                paymentDecision = new WorkOrderPaymentDecisionInput(paymentInstallments.Select(item => new global::VoltaMarcada.Domain.ValueObjects.WorkOrderChargeInstallmentDefinition(item.PaymentMethod, item.Amount, item.OtherPaymentMethodDescription)).ToArray(), null);
            }
        }
        var result = await OperationExecutor.ExecuteAsync(
            (CompleteWorkOrderUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(WorkOrder.Id, new CompleteWorkOrderCommand(recommendation, paymentDecision), cancellationToken));
        if (result.IsSuccess)
        {
            Snackbar.Add("Serviço concluído.", Severity.Success);
            await OnChanged.InvokeAsync();
            return;
        }

        ShowOperationError(result.Error?.Code);
    }

    private bool TryCreateRecommendation(out MaintenanceRecommendationInput? recommendation)
    {
        recommendation = null;
        if (recommendedServiceId is null || string.IsNullOrWhiteSpace(recommendationNotes)) return false;
        int? intervalDays = recommendationPeriod switch { "30" => 30, "60" => 60, "90" => 90, "180" => 180, "custom" => customIntervalDays, _ => null };
        DateOnly? dueDate = recommendationPeriod == "date" && recommendedDueDate is { } date ? DateOnly.FromDateTime(date) : null;
        if ((intervalDays is null) == (dueDate is null) || intervalDays is <= 0) return false;
        recommendation = new MaintenanceRecommendationInput(intervalDays, dueDate, recommendedServiceId.Value, recommendationNotes);
        return true;
    }

    private async Task UploadAsync(InputFileChangeEventArgs args, WorkOrderPhotoType type)
    {
        if (isSaving || isUploadingPhoto)
        {
            return;
        }

        var file = args.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            Snackbar.Add("A foto excede 10 MB.", Severity.Warning);
            return;
        }

        await operationLock.WaitAsync();
        isUploadingPhoto = true;
        await OnPhotoUploadChanged.InvokeAsync(true);
        try
        {
            return;
        }
        catch (Exception exception) when (exception is IOException or JSException)
        {
            Snackbar.Add("Não foi possível preparar a foto para envio. Tente novamente.", Severity.Warning);
        }
        finally
        {
            isUploadingPhoto = false;
            await OnPhotoUploadChanged.InvokeAsync(false);
            operationLock.Release();
        }
    }

    private async Task UploadAttachmentAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (isUploadingAttachment || file.Size > 10 * 1024 * 1024)
        {
            Snackbar.Add("O anexo excede 10 MB.", Severity.Warning);
            return;
        }

        isUploadingAttachment = true;
        try
        {
            await using var stream = file.OpenReadStream(10 * 1024 * 1024 + 1);
            var result = await OperationExecutor.ExecuteAsync(
                (AddWorkOrderAttachmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(
                    WorkOrder.Id, new WorkOrderAttachmentUpload(stream, file.Name, file.ContentType, file.Size, null), cancellationToken));
            if (!result.IsSuccess)
            {
                ShowOperationError(result.Error?.Code);
                return;
            }

            Snackbar.Add("Anexo enviado.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            isUploadingAttachment = false;
        }
    }

    private async Task RemoveAttachmentAsync(Guid attachmentId)
    {
        var result = await OperationExecutor.ExecuteAsync(
            (RemoveWorkOrderAttachmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(WorkOrder.Id, attachmentId, cancellationToken));
        if (!result.IsSuccess)
        {
            ShowOperationError(result.Error?.Code);
            return;
        }

        await OnChanged.InvokeAsync();
    }

    private static string FormatFileLength(long length) => length < 1024 * 1024
        ? $"{Math.Ceiling(length / 1024d):N0} KB"
        : $"{length / 1024d / 1024d:N1} MB";

