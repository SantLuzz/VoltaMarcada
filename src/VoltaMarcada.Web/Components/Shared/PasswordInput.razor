<MudTextField T="string"
              Id="@Id"
              Name="@Name"
              Label="@Label"
              InputType="@(isVisible ? InputType.Text : InputType.Password)"
              AutoComplete="@Autocomplete"
              Pattern="@MinimumLengthPattern"
              Required="@Required"
              RequiredError="Campo obrigatório."
              InputMode="InputMode.text"
              Variant="Variant.Outlined"
              FullWidth="true"
              Adornment="Adornment.End"
              AdornmentIcon="@(isVisible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
              AdornmentAriaLabel="@ToggleLabel"
              OnAdornmentClick="ToggleVisibility" />

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Autocomplete { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public int? MinLength { get; set; }

    [Parameter]
    public bool Required { get; set; }

    private bool isVisible;

    private string ToggleLabel => isVisible ? "Ocultar senha" : "Mostrar senha";

    private string? MinimumLengthPattern => MinLength is null ? null : $".{{{MinLength.Value},}}";

    private void ToggleVisibility() => isVisible = !isVisible;
}
