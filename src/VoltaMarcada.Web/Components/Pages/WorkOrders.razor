@page "/ordens-servico"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyMember)]
@using VoltaMarcada.Application.WorkOrders
@using VoltaMarcada.Domain.Enums
@inject IComponentOperationExecutor OperationExecutor

<PageTitle>Ordens de serviÃ§o | VoltaMarcada</PageTitle>
<PageHeader Title="Ordens de serviÃ§o" Description="Acompanhe os atendimentos e a execuÃ§Ã£o dos serviÃ§os.">
    <Actions><MudButton Href="/ordens-servico/registro" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Nova OS</MudButton></Actions>
</PageHeader>

<MudPaper Class="pa-4">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Class="work-order-list-toolbar">
        <MudTextField @bind-Value="searchFilter" Label="Buscar cliente ou serviÃ§o" Immediate="true" />
        <MudSelect T="WorkOrderStatus?" @bind-Value="statusFilter" Label="Status" Clearable="true">
            @foreach (var status in Enum.GetValues<WorkOrderStatus>())
            {
                <MudSelectItem Value="@((WorkOrderStatus?)status)">@GetStatusName(status)</MudSelectItem>
            }
        </MudSelect>
        <MudButton OnClick="LoadAsync" Variant="Variant.Outlined">Filtrar</MudButton>
    </MudStack>

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (orders.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.Assignment"
                    Title="Nenhuma ordem de serviÃ§o encontrada"
                    Description="Ajuste os filtros ou crie uma nova ordem de serviÃ§o para comeÃ§ar." />
    }
    else
    {
        <MudTable Items="@orders" Hover="true" Breakpoint="Breakpoint.Md" Class="servicesync-data-grid">
            <HeaderContent>
                <MudTh>Cliente</MudTh>
                <MudTh>Equipamento</MudTh>
                <MudTh>ServiÃ§o</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Prioridade</MudTh>
                <MudTh aria-label="Abrir ordem de serviÃ§o"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Cliente"><GridTextCell Value="@context.CustomerName" /></MudTd>
                <MudTd DataLabel="Equipamento"><GridTextCell Value="@context.EquipmentDescription" /></MudTd>
                <MudTd DataLabel="ServiÃ§o"><GridTextCell Value="@context.ServiceName" /></MudTd>
                <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@GetStatusName(context.Status)</MudChip></MudTd>
                <MudTd DataLabel="Prioridade"><MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(context.Priority)">@GetPriorityName(context.Priority)</MudChip></MudTd>
                <MudTd><MudIconButton Href="@($"/ordens-servico/registro?id={context.Id}")" Icon="@Icons.Material.Filled.OpenInNew" AriaLabel="Abrir ordem de serviÃ§o" /></MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusQuery { get; set; }

    private IReadOnlyList<WorkOrderListItem> orders = [];
    private string? searchFilter;
    private WorkOrderStatus? statusFilter;
    private bool isLoading = true;
    private bool showOnlyOpenStatuses;

    protected override async Task OnInitializedAsync()
    {
        showOnlyOpenStatuses = string.Equals(StatusQuery, "Open", StringComparison.OrdinalIgnoreCase);
        if (!showOnlyOpenStatuses && Enum.TryParse<WorkOrderStatus>(StatusQuery, true, out var queryStatus))
        {
            statusFilter = queryStatus;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        orders = await OperationExecutor.ExecuteAsync(
            (GetWorkOrdersUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(new GetWorkOrdersQuery(searchFilter, showOnlyOpenStatuses ? null : statusFilter), cancellationToken));
        if (showOnlyOpenStatuses)
        {
            orders = orders.Where(order => order.Status is WorkOrderStatus.Pending or WorkOrderStatus.InProgress).ToArray();
        }
        isLoading = false;
    }

    private static string GetStatusName(WorkOrderStatus value) => value switch
    {
        WorkOrderStatus.InProgress => "Em execuÃ§Ã£o",
        WorkOrderStatus.Completed => "ConcluÃ­da",
        WorkOrderStatus.Cancelled => "Cancelada",
        _ => "Pendente"
    };

    private static string GetPriorityName(WorkOrderPriority value) => value switch
    {
        WorkOrderPriority.Low => "Baixa",
        WorkOrderPriority.High => "Alta",
        WorkOrderPriority.Urgent => "Urgente",
        _ => "Normal"
    };

    private static Color GetPriorityColor(WorkOrderPriority value) => value switch
    {
        WorkOrderPriority.Urgent => Color.Error,
        WorkOrderPriority.High => Color.Warning,
        WorkOrderPriority.Low => Color.Info,
        _ => Color.Default
    };

    private static Color GetStatusColor(WorkOrderStatus value) => value switch
    {
        WorkOrderStatus.Completed => Color.Success,
        WorkOrderStatus.InProgress => Color.Info,
        WorkOrderStatus.Cancelled => Color.Default,
        _ => Color.Warning
    };
}
