@page "/solicitacoes/{Token}"
@layout PublicLayout
@using VoltaMarcada.Application.PublicBooking
@inject IComponentOperationExecutor OperationExecutor
@inject TimeProvider TimeProvider
@inject ILogger<PublicAppointmentRequestResponse> Logger

<PageTitle>Responder proposta | VoltaMarcada</PageTitle>

@if (isLoading) { <MudProgressLinear Indeterminate="true" /> }
else if (context is null) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Este link é inválido, expirou ou já foi utilizado.</MudAlert> }
else
{
    <MudPaper Class="public-booking-section" Elevation="0" Outlined="true">
        @if (isSubmitted)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">Sua resposta foi enviada para a empresa.</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.h4">@context.CompanyTradeName</MudText>
            <MudText Typo="Typo.h6" Class="mt-4">Olá, @context.CustomerName.</MudText>
            <MudText Class="mt-2">A empresa sugeriu um novo horário para <strong>@context.ServiceName</strong>:</MudText>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
                @context.ProposedDate.ToString("dd/MM/yyyy") às @context.ProposedStartTime.ToString("HH:mm")
            </MudAlert>
            @if (error is not null) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@error</MudAlert> }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="@true" OnClick="AcceptProposalAsync" Disabled="@isSubmitting">Aceitar horário sugerido</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="@true" Class="mt-4" OnClick="DeclineProposalAsync" Disabled="@isSubmitting">Recusar horário sugerido</MudButton>
        }
    </MudPaper>
}

@code {
    [Parameter] public string? Token { get; set; }
    private AppointmentRequestResponseDto? context;
    private string? error;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool isSubmitted;

    protected override async Task OnParametersSetAsync()
    {
        context = await OperationExecutor.ExecuteAsync(
            (GetAppointmentRequestResponseUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(Token, cancellationToken));
        isLoading = false;
    }

    private Task AcceptProposalAsync() => SubmitAsync(true);
    private Task DeclineProposalAsync() => SubmitAsync(false);
    private async Task SubmitAsync(bool acceptProposal)
    {
        if (Token is null) return;
        isSubmitting = true; error = null;
        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (RespondToAppointmentRequestUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(new(Token, acceptProposal), cancellationToken));
            if (result.IsSuccess) { isSubmitted = true; return; }
            error = "Não foi possível confirmar a proposta. A empresa entrará em contato.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to submit a public appointment request response");
            error = "Não foi possível enviar sua resposta. Tente novamente.";
        }
        finally { isSubmitting = false; }
    }
}
