    private async Task SuggestRequestAsync()
    {
        if (requestToSuggest is null || suggestionProfessionalId is not { } professionalId || suggestionDate is null || suggestionStartTime is null) return;
        var request = requestToSuggest;
        var selectedDate = DateOnly.FromDateTime(suggestionDate.Value);
        var selectedStartTime = suggestionStartTime.Value;
        isSuggestingRequest = true;
        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (SuggestAppointmentRequestTimeUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(request.Id, new(professionalId, selectedDate, selectedStartTime), cancellationToken));
            if (!result.IsSuccess) { Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error); await LoadSuggestionSlotsAsync(); return; }
            var link = ApplicationUrlBuilder.BuildApplicationUrl($"solicitacoes/{result.Value}");
            var message = CreateSuggestedTimeWhatsAppMessage(request, selectedDate, selectedStartTime, link);
            if (WhatsAppLinkBuilder.TryBuild(request.CustomerWhatsApp, message, out var whatsAppLink))
            {
                await JsRuntime.InvokeVoidAsync("open", whatsAppLink, "_blank");
                Snackbar.Add("Mensagem pronta aberta no WhatsApp.", Severity.Success);
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("serviceSync.copyText", link);
                Snackbar.Add("O WhatsApp do cliente é inválido. O link foi copiado.", Severity.Warning);
            }
            isRequestSuggestionDialogOpen = false;
            requestToSuggest = null;
            await LoadAsync();
        }
        finally { isSuggestingRequest = false; }
    }

    private static string CreateSuggestedTimeWhatsAppMessage(AppointmentRequestDto request, DateOnly date, TimeOnly startTime, string link) =>
        $"Olá, {request.CustomerName}!\n\nA empresa propôs um horário para {request.ServiceName}: {date:dd/MM/yyyy} às {startTime:HH:mm}.\n\nPara aceitar ou recusar, acesse:\n{link}";

