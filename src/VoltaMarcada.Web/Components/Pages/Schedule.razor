    private async Task ShowTodayAsync()
    {
        var today = GetCurrentDate();
        startDate = today.ToDateTime(TimeOnly.MinValue);
        endDate = startDate;
        await LoadAsync();
    }

    private async Task ShowWeekAsync()
    {
        var today = GetCurrentDate();
        var monday = today.AddDays(-((int)(today.DayOfWeek + 6) % 7));
        startDate = monday.ToDateTime(TimeOnly.MinValue);
        endDate = monday.AddDays(6).ToDateTime(TimeOnly.MinValue);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (startDate is null || endDate is null || endDate < startDate)
        {
            appointments = [];
            appointmentRequests = await OperationExecutor.ExecuteAsync(
                (GetAppointmentRequestsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(cancellationToken));
            return;
        }

        isLoading = true;
        try
        {
            var range = AppointmentCalendarTime.GetUtcRange(
                DateOnly.FromDateTime(startDate.Value),
                DateOnly.FromDateTime(endDate.Value.AddDays(1)),
                SchedulingConfiguration.AllowedTimeZoneIds);
            var result = accessScope is { } currentAccessScope
                ? await OperationExecutor.ExecuteAsync(
                    (GetAppointmentsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(currentAccessScope, range.StartAtUtc, range.EndAtUtc, cancellationToken))
                : [];
            appointments = selectedProfessionalId is { } professionalId
                ? result.Where(appointment => appointment.ProfessionalId == professionalId).ToArray()
                : result;
            appointmentRequests = await OperationExecutor.ExecuteAsync(
                (GetAppointmentRequestsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(cancellationToken));
        }
        finally
        {
            isLoading = false;
        }
    }

