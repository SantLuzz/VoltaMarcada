    protected override async Task OnInitializedAsync()
    {
        displayTimeZone = await CurrentDisplayTimeZone.GetTimeZoneAsync();
        var today = GetCurrentDate();
        startDate = today.ToDateTime(TimeOnly.MinValue);
        endDate = today.AddDays(6).ToDateTime(TimeOnly.MinValue);
        accessScope = await OperationExecutor.ExecuteAsync(
            (WorkOrderAuthorization authorization, CancellationToken cancellationToken) => authorization.GetAccessScopeAsync(cancellationToken));
        isOwner = accessScope.IsOwner;
        if (isOwner)
        {
            agendaProfessionals = (await OperationExecutor.ExecuteAsync(
                (GetProfessionalsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(null, cancellationToken)))
                .Where(professional => professional.IsActive)
                .ToArray();
        }
        await LoadAsync();
        if (MaintenanceOpportunityId is { } opportunityId && isOwner)
        {
            var context = await OperationExecutor.ExecuteAsync(
                (GetMaintenanceOpportunityForSchedulingUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(opportunityId, cancellationToken));
            if (context.IsSuccess)
            {
                await OpenAppointmentDialogAsync();
                appointmentCustomerId = context.Value!.CustomerId;
                appointmentEquipmentId = context.Value.EquipmentId;
                appointmentServiceId = context.Value.RecommendedServiceId;
                appointmentWorkOrderId = null;
                appointmentEquipment = (await OperationExecutor.ExecuteAsync(
                    (GetCustomerEquipmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(context.Value.CustomerId, cancellationToken))).Where(equipment => equipment.IsActive).ToArray();
            }
        }
        if (OpenNewAppointment && (isOwner || accessScope?.ProfessionalId is not null))
