@page "/agenda"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyMember)]
@using VoltaMarcada.Application.Scheduling
@using VoltaMarcada.Application.WorkOrders
@using VoltaMarcada.Application.Customers
@using VoltaMarcada.Application.Equipment
@using VoltaMarcada.Application.Professionals
@using VoltaMarcada.Application.Services
@using VoltaMarcada.Application.MaintenanceOpportunities
@using VoltaMarcada.Application.ServiceRequests
@using VoltaMarcada.Application.Abstractions.Routing
@using VoltaMarcada.Application.Abstractions.Communication
@using VoltaMarcada.Web.Formatting
@using Microsoft.JSInterop
@inject IComponentOperationExecutor OperationExecutor
@inject ISnackbar Snackbar
@inject ISchedulingConfiguration SchedulingConfiguration
@inject TimeProvider TimeProvider
@inject NavigationManager NavigationManager
@inject IApplicationUrlBuilder ApplicationUrlBuilder
@inject IWhatsAppLinkBuilder WhatsAppLinkBuilder
@inject IJSRuntime JsRuntime
@inject ICurrentDisplayTimeZone CurrentDisplayTimeZone
@inject IBrazilianDisplayFormatter DisplayFormatter

<PageTitle>Agenda | VoltaMarcada</PageTitle>

<PageHeader Title="Agenda" Description="Consulte os atendimentos no período selecionado.">
    <Actions>
        @if (isOwner || accessScope?.ProfessionalId is not null)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenAppointmentEditor">Novo agendamento</MudButton>
        }
        <MudButton Variant="Variant.Outlined" OnClick="ShowTodayAsync">Hoje</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ShowWeekAsync">Esta semana</MudButton>
    </Actions>
</PageHeader>

@if (isOwner && appointmentRequests.Count > 0)
{
    <MudPaper Outlined="true" Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">Solicitações externas pendentes</MudText>
        <MudList T="AppointmentRequestDto">
            @foreach (var request in appointmentRequests)
            {
                <MudListItem T="AppointmentRequestDto" Value="@request" Icon="@Icons.Material.Filled.EventAvailable">
                    <MudText Typo="Typo.subtitle2">@request.CustomerName · @request.ServiceName</MudText>
                    <MudText Typo="Typo.body2">@request.Date.ToString("dd/MM/yyyy") às @request.StartTime.ToString("HH:mm")</MudText>
                    @if (!string.IsNullOrWhiteSpace(request.EquipmentDescription))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Equipamento: @request.EquipmentDescription</MudText>
                    }
                    <MudStack Spacing="1" Class="my-1">
                        <MudChip T="string" Size="Size.Small" Color="@(request.Status == VoltaMarcada.Domain.Enums.AppointmentRequestStatus.Pending ? Color.Warning : Color.Info)">@(request.Status == VoltaMarcada.Domain.Enums.AppointmentRequestStatus.Pending ? "Aguardando empresa" : "Aguardando cliente")</MudChip>
                        @if (request.Status == VoltaMarcada.Domain.Enums.AppointmentRequestStatus.Pending && request.RequestedTimeProfessionals.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Success">Disponíveis no horário solicitado: @string.Join(", ", request.RequestedTimeProfessionals.Select(item => item.ProfessionalName))</MudText>
                        }
                    </MudStack>
                    @if (request.HasCustomerProfileProposal)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            Dados informados pelo cliente: @request.ProposedCustomerName · @request.ProposedCustomerWhatsApp
                            @if (!string.IsNullOrWhiteSpace(request.ProposedCustomerEmail)) { <text> · @request.ProposedCustomerEmail</text> }
                            @if (!string.IsNullOrWhiteSpace(request.ProposedAddress)) { <br /><text>@request.ProposedAddress</text> }
                            @if (isOwner)
                            {
                                <MudCheckBox T="bool" Value="@ShouldApplyCustomerProfile(request.Id)" ValueChanged="@(value => SetApplyCustomerProfile(request.Id, value))" Color="Color.Primary">Aplicar estes dados ao cadastro ao confirmar</MudCheckBox>
                            }
                        </MudAlert>
                    }
                    @if (request.Status == VoltaMarcada.Domain.Enums.AppointmentRequestStatus.Pending)
                    {
                        @if (request.RequiresCommercialResolution)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenCommercialResolutionDialogAsync(request))">Definir próxima etapa</MudButton>
                        }
                        else
                        {
                            @if (request.RequestedTimeProfessionals.Count == 0 && request.Alternatives.Count > 0)
                            {
                                @foreach (var alternative in request.Alternatives)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenSuggestionForAlternativeAsync(request, alternative))">Propor horário: @alternative.Date.ToString("dd/MM") às @alternative.StartTime.ToString("HH:mm") · @alternative.ProfessionalName</MudButton>
                                }
                            }
                            else if (request.Alternatives.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">Alternativas: @string.Join(" · ", request.Alternatives.Select(item => $"{item.Date:dd/MM HH:mm} - {item.ProfessionalName}"))</MudText>
                                @foreach (var alternative in request.Alternatives)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenSuggestionForAlternativeAsync(request, alternative))">@alternative.Date.ToString("dd/MM") às @alternative.StartTime.ToString("HH:mm") · @alternative.ProfessionalName</MudButton>
                                }
                            }
                            @if (request.RequestedTimeProfessionals.Count > 0)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="agenda-request-actions">
                                    <MudSelect T="Guid?" Label="Profissional para confirmar" Value="@GetSelectedRequestProfessional(request)" ValueChanged="@(value => SetSelectedRequestProfessional(request.Id, value))" Dense="true" Class="agenda-request-professional-select">
                                        <MudSelectItem Value="@((Guid?)null)">Selecione um profissional</MudSelectItem>
                                        @foreach (var professional in request.RequestedTimeProfessionals)
                                        {
                                            <MudSelectItem Value="@((Guid?)professional.ProfessionalId)">@professional.ProfessionalName</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(GetSelectedRequestProfessional(request) is null)" OnClick="@(() => AcceptRequestAsync(request))">Confirmar horário</MudButton>
                                </MudStack>
                            }
                            <MudStack Row="true" Spacing="1" Class="agenda-request-actions">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenSuggestionDialogAsync(request))">Escolher outro horário</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => OpenRequestRejectionDialog(request))">Recusar</MudButton>
                            </MudStack>
                        }
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => OpenRequestRejectionDialog(request))">Recusar solicitação</MudButton>
                    }
                </MudListItem>
            }
        </MudList>
    </MudPaper>
}

<MudPaper Outlined="true" Class="pa-4 mt-4">
    <MudGrid>
        <MudItem xs="12" sm="6"><MudDatePicker Label="Data inicial" @bind-Date="startDate" /></MudItem>
        <MudItem xs="12" sm="6"><MudDatePicker Label="Data final" @bind-Date="endDate" /></MudItem>
        @if (isOwner)
        {
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" Label="Profissional" Clearable="true" @bind-Value="selectedProfessionalId">
                    @foreach (var professional in agendaProfessionals)
                    {
                        <MudSelectItem Value="@((Guid?)professional.Id)">@professional.CompanyMemberName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
        <MudItem xs="12"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadAsync">Aplicar período</MudButton></MudItem>
    </MudGrid>
</MudPaper>

@if (!isOwner)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">Sua agenda pessoal: veja os atendimentos de hoje, da semana ou de outro período.</MudAlert>
}

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="mt-4" />
}
else if (appointments.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.EventBusy" Title="Nenhum atendimento" Description="Não há agendamentos para este período." />
}
else
{
    <MudList T="AppointmentDto" Class="mt-4">
        @foreach (var appointment in appointments)
        {
            <MudListItem T="AppointmentDto" Value="@appointment" Icon="@Icons.Material.Filled.Event" OnClick="@(() => OpenAppointmentDetails(appointment.Id))">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2">@DisplayFormatter.FormatDateTime(appointment.StartAtUtc, displayTimeZone) — @GetStatusName(appointment.Status)</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(appointment.Origin == VoltaMarcada.Domain.Enums.AppointmentOrigin.External ? Color.Info : Color.Default)">@(appointment.Origin == VoltaMarcada.Domain.Enums.AppointmentOrigin.External ? "Externo" : "Interno")</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@GetAppointmentTypeName(appointment.Type)</MudChip>
                    <MudText Typo="Typo.body2">@(appointment.CustomerName ?? "Cliente não informado") · @(appointment.ServiceName ?? "Serviço não informado")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@appointment.ProfessionalName@(string.IsNullOrWhiteSpace(appointment.EquipmentName) ? string.Empty : $" · {appointment.EquipmentName}")</MudText>
                    @if (!string.IsNullOrWhiteSpace(appointment.Description))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@appointment.Description</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@appointment.Notes</MudText>
                    }
                    <div @onclick:stopPropagation="true">
                        <MudStack Row="true" Spacing="1">
                        @if (appointment.WorkOrderId is { } workOrderId)
                        {
                            <MudButton Href="@($"/ordens-servico/registro?id={workOrderId}")" Size="Size.Small" Variant="Variant.Text">Abrir OS</MudButton>
                        }
                        @if (appointment.Status == VoltaMarcada.Domain.Enums.AppointmentStatus.Scheduled)
                        {
                            @if (isOwner)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => OpenAdjustmentDialogAsync(appointment))">Ajustar</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => OpenNotesDialog(appointment))">Editar</MudButton>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => StartAppointmentAsync(appointment.Id))">Iniciar</MudButton>
                        }
                        else if (appointment.Status == VoltaMarcada.Domain.Enums.AppointmentStatus.InProgress)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="@(() => CompleteAppointmentAsync(appointment.Id))">Concluir</MudButton>
                        }
                        @if (isOwner && (appointment.Status is VoltaMarcada.Domain.Enums.AppointmentStatus.Scheduled or VoltaMarcada.Domain.Enums.AppointmentStatus.InProgress))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => OpenCancelDialog(appointment))">Cancelar</MudButton>
                        }
                        </MudStack>
                    </div>
                </MudStack>
            </MudListItem>
        }
    </MudList>
}

@if (isInitialLoadComplete && accessScope is { } currentAccessScope)
{
    <ScheduleBlockRequestPanel AccessScope="@currentAccessScope" />
}

<AppointmentEditor @bind-Visible="isAppointmentEditorOpen" Created="OnAppointmentCreatedAsync" />
<AppointmentDetailsDialog AppointmentId="@selectedAppointmentId" @bind-Visible="isAppointmentDetailsDialogOpen" />

<MudDialog @bind-Visible="isNotesDialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Editar agendamento</MudText></TitleContent>
    <DialogContent>
        <MudTextField Label="Observações" Lines="3" @bind-Value="editedNotes" Disabled="@isSavingNotes" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseNotesDialog" Disabled="@isSavingNotes">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveNotesAsync" Disabled="@isSavingNotes">@(isSavingNotes ? "Salvando..." : "Salvar")</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="isAppointmentDialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Novo agendamento</MudText></TitleContent>
    <DialogContent>
        @if (isAppointmentOptionsLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudGrid>
                @if (isOwner)
                {
                <MudItem xs="12" sm="6">
                    <MudSelect T="VoltaMarcada.Domain.Enums.AppointmentType" Label="Tipo de agendamento" @bind-Value="appointmentType" @bind-Value:after="OnAppointmentTypeChangedAsync" Disabled="@isCreatingAppointment">
                        @foreach (var type in Enum.GetValues<VoltaMarcada.Domain.Enums.AppointmentType>())
                        {
                            <MudSelectItem Value="@type">@GetAppointmentTypeName(type)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="Guid?" Label="Ordem de serviço" Placeholder="Opcional: vincule a uma OS" Clearable="true" @bind-Value="appointmentWorkOrderId" @bind-Value:after="OnAppointmentWorkOrderChangedAsync" Disabled="@isCreatingAppointment">
                        @foreach (var workOrder in appointmentWorkOrders)
                        {
                            <MudSelectItem Value="@((Guid?)workOrder.Id)">@workOrder.CustomerName — @workOrder.ServiceName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Cliente" Placeholder="Selecione um cliente" Clearable="true" @bind-Value="appointmentCustomerId" @bind-Value:after="LoadAppointmentEquipmentAsync" Disabled="@(isCreatingAppointment || appointmentWorkOrderId is not null || MaintenanceOpportunityId is not null)">
                        @foreach (var customer in appointmentCustomers)
                        {
                            <MudSelectItem Value="@((Guid?)customer.Id)">@customer.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Equipamento" Placeholder="Selecione um equipamento" Clearable="true" @bind-Value="appointmentEquipmentId" Disabled="@(isCreatingAppointment || appointmentCustomerId is null || appointmentWorkOrderId is not null || MaintenanceOpportunityId is not null)">
                        @foreach (var equipment in appointmentEquipment)
                        {
                            <MudSelectItem Value="@((Guid?)equipment.Id)">@GetEquipmentName(equipment)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Serviço" Placeholder="Selecione um serviço" @bind-Value="appointmentServiceId" @bind-Value:after="OnAppointmentServiceChangedAsync" Disabled="@(isCreatingAppointment || appointmentWorkOrderId is not null || MaintenanceOpportunityId is not null)">
                        @foreach (var service in appointmentServices)
                        {
                            <MudSelectItem Value="@((Guid?)service.Id)">@service.Name (@service.DurationMinutes min)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Profissional" Placeholder="Selecione um profissional" @bind-Value="appointmentProfessionalId" @bind-Value:after="LoadAvailableAppointmentSlotsAsync" Disabled="@(isCreatingAppointment || appointmentServiceId is null || appointmentWorkOrderId is not null)">
                        @foreach (var professional in availableAppointmentProfessionals)
                        {
                            <MudSelectItem Value="@((Guid?)professional.Id)">@professional.CompanyMemberName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudSelect T="Guid?" Label="Ordem de serviço" Placeholder="Selecione uma ordem de serviço" @bind-Value="appointmentWorkOrderId" @bind-Value:after="OnAppointmentWorkOrderChangedAsync" Disabled="@isCreatingAppointment">
                            @foreach (var workOrder in appointmentWorkOrders)
                            {
                                <MudSelectItem Value="@((Guid?)workOrder.Id)">@workOrder.CustomerName — @workOrder.ServiceName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data" @bind-Date="appointmentDate" @bind-Date:after="LoadAvailableAppointmentSlotsAsync" Disabled="@isCreatingAppointment" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="TimeOnly?" Label="Horário" Placeholder="Selecione um horário" @bind-Value="appointmentStartTime" Disabled="@(isCreatingAppointment || availableAppointmentSlots.Count == 0)">
                        @foreach (var slot in availableAppointmentSlots)
                        {
                            <MudSelectItem Value="@((TimeOnly?)slot.StartTime)">@slot.StartTime.ToString("HH:mm")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Observações" Lines="3" @bind-Value="appointmentNotes" Disabled="@isCreatingAppointment" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAppointmentDialog" Disabled="@isCreatingAppointment">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAppointmentAsync" Disabled="@(isAppointmentOptionsLoading || isCreatingAppointment)">@(isCreatingAppointment ? "Agendando..." : "Agendar")</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="isAdjustmentDialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Ajustar agendamento</MudText></TitleContent>
    <DialogContent>
        @if (isAdjustmentOptionsLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Profissional" @bind-Value="adjustmentProfessionalId" @bind-Value:after="LoadAdjustmentSlotsAsync" Disabled="@isAdjusting">
                        @foreach (var professional in adjustmentProfessionals)
                        {
                            <MudSelectItem Value="@((Guid?)professional.Id)">@professional.CompanyMemberName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Ordem de serviço" Placeholder="Opcional" Clearable="true" @bind-Value="adjustmentWorkOrderId" @bind-Value:after="OnAdjustmentWorkOrderChangedAsync" Disabled="@isAdjusting">
                        @foreach (var workOrder in adjustmentWorkOrders)
                        {
                            <MudSelectItem Value="@((Guid?)workOrder.Id)">@workOrder.CustomerName — @workOrder.ServiceName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Data" @bind-Date="adjustmentDate" @bind-Date:after="LoadAdjustmentSlotsAsync" Disabled="@isAdjusting" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="TimeOnly?" Label="Horário" @bind-Value="adjustmentStartTime" Disabled="@(isAdjusting || adjustmentSlots.Count == 0)">
                        @foreach (var slot in adjustmentSlots)
                        {
                            <MudSelectItem Value="@((TimeOnly?)slot.StartTime)">@slot.StartTime.ToString("HH:mm")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Motivo do ajuste" Lines="2" Required="true" @bind-Value="adjustmentReason" Disabled="@isAdjusting" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAdjustmentDialog" Disabled="@isAdjusting">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AdjustAppointmentAsync" Disabled="@(isAdjustmentOptionsLoading || isAdjusting)">@(isAdjusting ? "Salvando..." : "Salvar ajuste")</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="isCancelDialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Cancelar agendamento</MudText></TitleContent>
    <DialogContent>
        <MudText>Deseja cancelar este agendamento? Esta ação não poderá ser desfeita.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseCancelDialog" Disabled="@isChangingStatus">Voltar</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="CancelAppointmentAsync" Disabled="@isChangingStatus">@(isChangingStatus ? "Cancelando..." : "Cancelar agendamento")</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="isRequestRejectionDialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Recusar solicitação</MudText></TitleContent>
    <DialogContent>
        @if (requestToReject is not null)
        {
            <MudText Typo="Typo.body2" Class="mb-4">@requestToReject.CustomerName · @requestToReject.ServiceName</MudText>
            <MudTextField Label="Motivo da recusa"
                          Lines="3"
                          Required="true"
                          RequiredError="Informe o motivo da recusa."
                          MaxLength="1000"
                          Immediate="true"
                          @bind-Value="requestRejectionReason"
                          Disabled="@isRejectingRequest" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">A recusa será registrada e uma mensagem será preparada no WhatsApp do cliente.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseRequestRejectionDialog" Disabled="@isRejectingRequest">Cancelar</MudButton>
        <MudButton Color="Color.Error"
                   Variant="Variant.Filled"
                   OnClick="RejectRequestAsync"
                   Disabled="@(isRejectingRequest || string.IsNullOrWhiteSpace(requestRejectionReason))">
            @(isRejectingRequest ? "Recusando..." : "Recusar e avisar cliente")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="isRequestSuggestionDialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Sugerir outro horário</MudText></TitleContent>
    <DialogContent>
        @if (requestToSuggest is not null)
        {
            <MudText Typo="Typo.body2" Class="mb-4">@requestToSuggest.CustomerName · @requestToSuggest.ServiceName</MudText>
            <MudGrid Spacing="2">
                @if (isOwner)
                {
                    <MudItem xs="12">
                        <MudSelect T="Guid?" Label="Profissional" @bind-Value="suggestionProfessionalId" @bind-Value:after="LoadSuggestionSlotsAsync" Variant="Variant.Outlined" FullWidth="@true">
                            @foreach (var professional in agendaProfessionals.Where(item => item.ServiceIds.Contains(requestToSuggest.ServiceId)))
                            {
                                <MudSelectItem Value="@((Guid?)professional.Id)">@professional.CompanyMemberName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12"><MudDatePicker Label="Data" @bind-Date="suggestionDate" @bind-Date:after="LoadSuggestionSlotsAsync" MinDate="@TimeProvider.GetLocalNow().Date" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12">
                    <MudSelect T="TimeOnly?" Label="Horário" @bind-Value="suggestionStartTime" Variant="Variant.Outlined" FullWidth="@true" Disabled="@(suggestionSlots.Count == 0)">
                        @foreach (var slot in suggestionSlots) { <MudSelectItem Value="@((TimeOnly?)slot.StartTime)">@slot.StartTime.ToString("HH:mm")</MudSelectItem> }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseSuggestionDialog" Disabled="@isSuggestingRequest">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SuggestRequestAsync" Disabled="@(isSuggestingRequest || suggestionProfessionalId is null || suggestionDate is null || suggestionStartTime is null)">@(isSuggestingRequest ? "Gerando..." : "Gerar link para o cliente")</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="isCommercialResolutionDialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Definir próxima etapa</MudText></TitleContent>
    <DialogContent>
        @if (serviceRequestToResolve is not null)
        {
            <MudStack Spacing="2">
                <MudText>@serviceRequestToResolve.CustomerName · @serviceRequestToResolve.ServiceName</MudText>
                <MudSelect T="Guid" Label="Equipamento" @bind-Value="commercialEquipmentId" Required="true">
                    <MudSelectItem Value="@Guid.Empty">Selecione um equipamento</MudSelectItem>
                    @foreach (var item in commercialEquipment)
                    {
                        <MudSelectItem Value="@item.Id">@item.Type @item.Manufacturer @item.Model</MudSelectItem>
                    }
                </MudSelect>
                <MudRadioGroup T="ServiceRequestResolution" @bind-Value="commercialResolution">
                    <MudRadio Value="ServiceRequestResolution.PrepareQuote">Gerar orçamento</MudRadio>
                    <MudRadio Value="ServiceRequestResolution.ScheduleVisit">Agendar visita técnica</MudRadio>
