        if (requestToSuggest is null || suggestionProfessionalId is not { } professionalId || suggestionDate is null) return;
        suggestionSlots = await OperationExecutor.ExecuteAsync(
            (GetAvailableAppointmentSlotsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(professionalId, DateOnly.FromDateTime(suggestionDate.Value), requestToSuggest.DurationMinutes, null, cancellationToken));
