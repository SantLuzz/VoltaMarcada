    private async Task RejectRequestAsync()
    {
        if (requestToReject is not { } request || string.IsNullOrWhiteSpace(requestRejectionReason)) return;

        var reason = requestRejectionReason.Trim();
        isRejectingRequest = true;
        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (RejectAppointmentRequestUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(request.Id, reason, cancellationToken));
            if (!result.IsSuccess)
            {
                Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error);
                return;
            }

            var message = AppointmentRequestRejectionMessage.Create(request, reason);
            if (WhatsAppLinkBuilder.TryBuild(request.CustomerWhatsApp, message, out var whatsAppLink))
            {
                await JsRuntime.InvokeVoidAsync("open", whatsAppLink, "_blank");
                Snackbar.Add("Recusa registrada e mensagem aberta no WhatsApp.", Severity.Success);
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("serviceSync.copyText", message);
                Snackbar.Add("Recusa registrada. O WhatsApp do cliente é inválido e a mensagem foi copiada.", Severity.Warning);
            }

            isRequestRejectionDialogOpen = false;
            requestToReject = null;
            requestRejectionReason = null;
            await LoadAsync();
        }
        finally
        {
            isRejectingRequest = false;
        }
    }

