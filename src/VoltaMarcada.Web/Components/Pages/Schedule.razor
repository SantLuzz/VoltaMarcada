                    <MudTextField @bind-Value="commercialAppointmentDescription" Label="Descrição para o cliente" Required="true" MaxLength="1000" />
                }
                <MudNumericField T="decimal?" @bind-Value="commercialServiceUnitPrice" Label="Valor do serviço" Adornment="Adornment.Start" AdornmentText="R$" />
                @if (serviceRequestToResolve.HasCustomerProfileProposal)
                {
                    <MudCheckBox T="bool" @bind-Value="applyCommercialCustomerProfileProposal" Color="Color.Primary">Aplicar os dados propostos pelo cliente ao cadastro</MudCheckBox>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
