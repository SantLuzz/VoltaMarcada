        <MudButton Color="Color.Primary" Disabled="@isResolvingCommercialRequest" OnClick="ResolveCommercialRequestAsync">@(isResolvingCommercialRequest ? "Salvando..." : "Confirmar")</MudButton>
    </DialogActions>
</MudDialog>

