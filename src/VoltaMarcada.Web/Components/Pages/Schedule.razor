            return;
        }

        var result = await OperationExecutor.ExecuteAsync(
            (AcceptAppointmentRequestUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(
                request.Id,
                selectedProfessionalId.Value,
                request.HasCustomerProfileProposal && isOwner && ShouldApplyCustomerProfile(request.Id),
                cancellationToken));
        if (!result.IsSuccess)
        {
            Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error);
            return;
        }

        Snackbar.Add("Solicitação confirmada.", Severity.Success);
        await LoadAsync();
