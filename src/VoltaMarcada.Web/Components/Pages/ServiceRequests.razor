@page "/solicitacoes"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyMember)]
@using VoltaMarcada.Application.Equipment
@using VoltaMarcada.Application.Professionals
@using VoltaMarcada.Application.ServiceRequests
@inject GetServiceRequestsUseCase GetServiceRequestsUseCase
@inject GetCustomerEquipmentUseCase GetCustomerEquipmentUseCase
@inject GetProfessionalsUseCase GetProfessionalsUseCase
@inject ResolveServiceRequestUseCase ResolveServiceRequestUseCase
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Solicitações | VoltaMarcada</PageTitle>
<PageHeader Title="Solicitações" Description="Avalie pedidos públicos e defina o próximo passo do atendimento." />

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (requests.Count == 0)
{
    <EmptyState Title="Nenhuma solicitação pendente" Description="Novos pedidos de agendamento aparecerão aqui." />
}
else
{
    <MudTable Items="requests" Hover="true" Class="servicesync-data-grid">
        <HeaderContent><MudTh>Cliente</MudTh><MudTh>Serviço</MudTh><MudTh>Horário solicitado</MudTh><MudTh>Ação</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Cliente"><MudText Typo="Typo.subtitle2">@context.CustomerName</MudText>@if (!string.IsNullOrWhiteSpace(context.ProblemDescription)) { <MudText Typo="Typo.caption">@context.ProblemDescription</MudText> }</MudTd>
            <MudTd DataLabel="Serviço">@context.ServiceName</MudTd>
            <MudTd DataLabel="Horário solicitado">@context.RequestedDate.ToString("dd/MM/yyyy") às @context.RequestedStartTime.ToString("HH:mm")</MudTd>
            <MudTd DataLabel="Ação"><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => OpenResolutionAsync(context))">Avaliar</MudButton></MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDialog @bind-Visible="isDialogOpen">
    <TitleContent><MudText Typo="Typo.h6">Definir próximo passo</MudText></TitleContent>
    <DialogContent>
        @if (selectedRequest is not null)
        {
            <MudStack Spacing="2">
                <MudText>@selectedRequest.CustomerName · @selectedRequest.ServiceName</MudText>
                <MudSelect T="Guid" Label="Equipamento" @bind-Value="equipmentId" Required="true"><MudSelectItem Value="@Guid.Empty">Selecione um equipamento</MudSelectItem>@foreach (var item in equipment) { <MudSelectItem Value="@item.Id">@item.Type @item.Manufacturer @item.Model</MudSelectItem> }</MudSelect>
                <MudSelect T="Guid" Label="Profissional" @bind-Value="professionalId" Required="true"><MudSelectItem Value="@Guid.Empty">Selecione um profissional</MudSelectItem>@foreach (var item in professionals) { <MudSelectItem Value="@item.Id">@item.CompanyMemberName</MudSelectItem> }</MudSelect>
                <MudRadioGroup T="ServiceRequestResolution" @bind-Value="resolution"><MudRadio Value="ServiceRequestResolution.PrepareQuote">Visita técnica e orçamento</MudRadio><MudRadio Value="ServiceRequestResolution.CreateWorkOrder">Criar OS direta</MudRadio></MudRadioGroup>
                <MudTextField @bind-Value="appointmentDescription" Label="Descrição para o cliente" Required="true" MaxLength="1000" />
                <MudNumericField T="decimal?" @bind-Value="serviceUnitPrice" Label="Valor do serviço" Adornment="Adornment.Start" AdornmentText="R$" />
                @if (selectedRequest.HasCustomerProfileProposal)
                {
                    <MudCheckBox T="bool" @bind-Value="applyCustomerProfileProposal" Color="Color.Primary">Aplicar os dados propostos pelo cliente ao cadastro</MudCheckBox>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="CloseDialog">Cancelar</MudButton><MudButton Color="Color.Primary" Disabled="@isResolving" OnClick="ResolveAsync">@(isResolving ? "Salvando..." : "Confirmar")</MudButton></DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<ServiceRequestDto> requests = [];
    private IReadOnlyList<EquipmentDto> equipment = [];
    private IReadOnlyList<ProfessionalDto> professionals = [];
    private ServiceRequestDto? selectedRequest;
    private ServiceRequestResolution resolution = ServiceRequestResolution.PrepareQuote;
    private Guid equipmentId;
    private Guid professionalId;
    private string appointmentDescription = string.Empty;
    private decimal? serviceUnitPrice;
    private bool applyCustomerProfileProposal;
    private bool isLoading = true;
    private bool isDialogOpen;
    private bool isResolving;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() { isLoading = true; requests = await GetServiceRequestsUseCase.ExecuteAsync(); isLoading = false; }

    private async Task OpenResolutionAsync(ServiceRequestDto request)
    {
        selectedRequest = request;
        equipment = (await GetCustomerEquipmentUseCase.ExecuteAsync(request.CustomerId)).Where(item => item.IsActive).ToArray();
        professionals = (await GetProfessionalsUseCase.ExecuteAsync())
            .Where(item => item.IsActive && item.ServiceIds.Contains(request.ServiceId))
            .ToArray();
        equipmentId = Guid.Empty;
        professionalId = Guid.Empty;
        resolution = ServiceRequestResolution.PrepareQuote;
        appointmentDescription = $"Visita técnica para {request.ServiceName}";
        serviceUnitPrice = null;
        applyCustomerProfileProposal = false;
        isDialogOpen = true;
    }

    private async Task ResolveAsync()
    {
        if (selectedRequest is null) return;
        isResolving = true;
        try
        {
            var result = await ResolveServiceRequestUseCase.ExecuteAsync(new ResolveServiceRequestCommand(selectedRequest.AppointmentRequestId, professionalId, resolution, equipmentId, appointmentDescription, serviceUnitPrice, applyCustomerProfileProposal));
            if (!result.IsSuccess) { Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error); return; }
            isDialogOpen = false;
            Snackbar.Add(resolution == ServiceRequestResolution.PrepareQuote ? "Visita técnica e orçamento preparados." : "OS criada e agendada.", Severity.Success);
            if (result.Value?.QuoteId is { } quoteId) { NavigationManager.NavigateTo($"/orcamentos/registro?id={quoteId}"); return; }
            await LoadAsync();
        }
        finally { isResolving = false; }
    }

    private void CloseDialog() => isDialogOpen = false;
}
