@page "/onboarding/company"
@attribute [Authorize]
@layout AuthLayout
@using Microsoft.EntityFrameworkCore
@using VoltaMarcada.Infrastructure.Identity
@using VoltaMarcada.Infrastructure.Persistence
@using VoltaMarcada.Web.Routing
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject NavigationManager NavigationManager

<PageTitle>Cadastrar empresa | VoltaMarcada</PageTitle>

@if (!isRedirecting)
{
    <section class="onboarding-content" aria-labelledby="company-onboarding-title">
        <header class="auth-page-header">
            <MudText id="company-onboarding-title" Typo="Typo.h4">Cadastre sua empresa</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Estas informações serão usadas para identificar sua empresa e organizar a operação.</MudText>
        </header>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@Error</MudAlert>
        }

        <form method="post" action="/onboarding/company" enctype="multipart/form-data" class="onboarding-form">
            <AntiforgeryToken />
            <input name="returnUrl" type="hidden" value="@ReturnUrl" />

            <section class="onboarding-section" aria-labelledby="company-information-title">
                <MudText id="company-information-title" Typo="Typo.h6">Informações da empresa</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField T="string" Id="legal-name" Name="legalName" Label="Razão social" AutoComplete="organization" Required="true" RequiredError="Campo obrigatório." Variant="Variant.Outlined" FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Id="trade-name" Name="tradeName" Label="Nome fantasia" Required="true" RequiredError="Campo obrigatório." Variant="Variant.Outlined" FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <BrazilianDocumentInput Id="document" Name="document" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <BrazilianPhoneInput Id="whats-app" Name="whatsApp" Required="true" />
                    </MudItem>
                </MudGrid>
            </section>

            <section class="onboarding-section" aria-labelledby="address-title">
                <MudText id="address-title" Typo="Typo.h6">Localização</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField T="string" Id="address" Name="address" Label="Endereço" AutoComplete="street-address" Required="true" RequiredError="Campo obrigatório." Variant="Variant.Outlined" FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <BrazilianPostalCodeInput Id="postal-code" Name="postalCode" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <input name="stateId" type="hidden" value="@selectedStateId" />
                        <MudSelect T="Guid" Id="state" Label="Estado" @bind-Value="selectedStateId" @bind-Value:after="LoadCitiesAsync" Required="true" RequiredError="Campo obrigatório." Variant="Variant.Outlined" FullWidth="true">
                            <MudSelectItem Value="@Guid.Empty">Selecione o estado</MudSelectItem>
                            @foreach (var state in states)
                            {
                                <MudSelectItem Value="@state.Id">@state.Abbreviation - @state.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <input name="cityId" type="hidden" value="@selectedCityId" />
                        <MudSelect T="Guid" Id="city" Label="Cidade" @bind-Value="selectedCityId" Disabled="@(selectedStateId == Guid.Empty)" Required="true" RequiredError="Campo obrigatório." Variant="Variant.Outlined" FullWidth="true">
                            <MudSelectItem Value="@Guid.Empty">Selecione a cidade</MudSelectItem>
                            @foreach (var city in cities)
                            {
                                <MudSelectItem Value="@city.Id">@city.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </section>

            <section class="onboarding-section" aria-labelledby="logo-title">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText id="logo-title" Typo="Typo.h6">Logo</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">(opcional)</MudText>
                </MudStack>
                <input id="logo" name="logo" type="file" accept="image/png,image/jpeg,image/webp" class="native-file-input" aria-describedby="logo-hint" />
                <MudText id="logo-hint" Typo="Typo.caption" Color="Color.Secondary">PNG, JPEG ou WebP de até 5 MB.</MudText>
            </section>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">
                <span data-loading-label>Cadastrar empresa</span>
                <MudProgressCircular data-loading-spinner Indeterminate="true" Size="Size.Small" aria-hidden="true" />
            </MudButton>
        </form>
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool isRedirecting;
    private Guid selectedStateId;
    private Guid selectedCityId;
    private IReadOnlyList<StateOption> states = [];
    private IReadOnlyList<CityOption> cities = [];

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateTask;
        var user = authenticationState.User;

        if (user.IsInRole(PlatformRoles.PlatformAdministrator))
        {
            RedirectToReturnUrl();
            return;
        }

        var userIdValue = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdValue, out var userId))
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var hasMembership = await dbContext.CompanyUsers.AsNoTracking().AnyAsync(companyUser => companyUser.UserId == userId);
        if (hasMembership)
        {
            RedirectToReturnUrl();
            return;
        }

        states = await dbContext.States.AsNoTracking().OrderBy(state => state.Abbreviation)
            .Select(state => new StateOption(state.Id, state.Name, state.Abbreviation)).ToListAsync();
    }

    private async Task LoadCitiesAsync()
    {
        selectedCityId = Guid.Empty;
        cities = selectedStateId == Guid.Empty ? [] : await GetCitiesAsync();
    }

    private async Task<IReadOnlyList<CityOption>> GetCitiesAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        return await dbContext.Cities.AsNoTracking().Where(city => city.StateId == selectedStateId)
            .OrderBy(city => city.Name).Select(city => new CityOption(city.Id, city.Name)).ToListAsync();
    }

    private void RedirectToReturnUrl()
    {
        isRedirecting = true;
        NavigationManager.NavigateTo(LocalReturnUrl.Normalize(ReturnUrl, "/"), forceLoad: true);
    }

    private sealed record StateOption(Guid Id, string Name, string Abbreviation);
    private sealed record CityOption(Guid Id, string Name);
}
