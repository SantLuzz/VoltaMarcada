                @if (context.GeneratedWorkOrderId is { } workOrderId) { <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => NavigationManager.NavigateTo($"/ordens-servico/registro?id={workOrderId}"))">Abrir OS</MudButton> }
            </MudTd>
