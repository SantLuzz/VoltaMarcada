@page "/orcamentos"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyMember)]
@using Microsoft.JSInterop
@using VoltaMarcada.Application.Quotes
@using VoltaMarcada.Domain.Enums
@inject IComponentOperationExecutor OperationExecutor
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

<PageTitle>OrÃ§amentos | VoltaMarcada</PageTitle>
<PageHeader Title="OrÃ§amentos" Description="Prepare, envie e acompanhe as decisÃµes dos clientes."><Actions><MudButton Color="Color.Primary" OnClick="@(() => NavigationManager.NavigateTo("/orcamentos/registro"))">Novo orÃ§amento</MudButton></Actions></PageHeader>

@if (isLoading) { <MudProgressLinear Indeterminate="true" /> }
else if (quotes.Count == 0) { <EmptyState Title="Nenhum orÃ§amento" Description="Os orÃ§amentos preparados a partir de solicitaÃ§Ãµes aparecerÃ£o aqui." /> }
else
{
    <MudTable Items="quotes" Hover="true" Class="servicesync-data-grid">
        <HeaderContent><MudTh>Cliente</MudTh><MudTh>Equipamento</MudTh><MudTh>Status</MudTh><MudTh>Validade</MudTh><MudTh>Total</MudTh><MudTh>AÃ§Ãµes</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Cliente">@context.CustomerName</MudTd>
            <MudTd DataLabel="Equipamento">@context.EquipmentDescription</MudTd>
            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@GetStatusName(context.Status)</MudChip></MudTd>
            <MudTd DataLabel="Validade">@context.ValidUntil.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Total">@context.TotalAmount.ToString("C")</MudTd>
            <MudTd DataLabel="AÃ§Ãµes">
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => NavigationManager.NavigateTo($"/orcamentos/registro?id={context.Id}"))">Abrir</MudButton>
                @if (context.Status == QuoteStatus.Draft) { <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SendAsync(context.Id))">Enviar</MudButton> }
