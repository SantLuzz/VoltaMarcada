@page "/q/{Token}"
@layout PublicLayout
@using VoltaMarcada.Application.Quotes
@inject GetPublicQuoteUseCase GetPublicQuoteUseCase
@inject ApprovePublicQuoteUseCase ApprovePublicQuoteUseCase

<PageTitle>Orçamento | VoltaMarcada</PageTitle>

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (quote is null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Este orçamento não está disponível.</MudAlert>
}
else
{
    <MudPaper Class="pa-6" Outlined="true">
        <MudText Typo="Typo.h4">Orçamento</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">Válido até @quote.ValidUntil.ToString("dd/MM/yyyy")</MudText>
        @foreach (var item in quote.Items)
        {
            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="py-2">
                <MudText>@item.Description (@item.Quantity)</MudText><MudText>@item.TotalAmount.ToString("C")</MudText>
            </MudStack>
        }
        @if (quote.DiscountAmount > 0) { <MudText>Desconto: -@quote.DiscountAmount.ToString("C")</MudText> }
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.h6">Total: @quote.TotalAmount.ToString("C")</MudText>
        @if (quote.Status == VoltaMarcada.Domain.Enums.QuoteStatus.Sent)
        {
            <MudButton Color="Color.Success" Variant="Variant.Filled" Class="mt-4" Disabled="@isApproving" OnClick="ApproveAsync">@(isApproving ? "Aprovando..." : "Aprovar orçamento")</MudButton>
        }
        @if (!string.IsNullOrWhiteSpace(quote.Notes)) { <MudText Class="mt-3">@quote.Notes</MudText> }
    </MudPaper>
}

@code {
    [Parameter] public string? Token { get; set; }
    private PublicQuoteDto? quote;
    private bool isLoading = true;
    private bool isApproving;
    private string? actionError;
    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        quote = await GetPublicQuoteUseCase.ExecuteAsync(Token);
        isLoading = false;
    }
    private async Task ApproveAsync()
    {
        isApproving = true;
        var result = await ApprovePublicQuoteUseCase.ExecuteAsync(Token);
        actionError = result.IsSuccess ? null : "Não foi possível aprovar este orçamento.";
        quote = await GetPublicQuoteUseCase.ExecuteAsync(Token);
        isApproving = false;
    }
}
