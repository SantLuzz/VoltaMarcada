@page "/equipamentos"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyMember)]
@using VoltaMarcada.Application.Equipment
@inject IComponentOperationExecutor OperationExecutor
@inject ISnackbar Snackbar
@inject ILogger<Equipment> Logger

<PageTitle>Equipamentos | VoltaMarcada</PageTitle>

<PageHeader Title="Equipamentos" Description="Gerencie os equipamentos vinculados aos seus clientes." />

<MudPaper Class="equipment-type-list-surface" Elevation="0" Outlined="true">
    <div class="equipment-type-list-toolbar">
        <MudTextField @bind-Value="searchFilter"
                      @bind-Value:after="LoadEquipmentAsync"
                      Variant="Variant.Outlined"
                      Placeholder="Pesquise por equipamento, cliente ou número de série"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Immediate="true" />

        <AuthorizeView Policy="@AuthorizationPolicies.CompanyOwner">
            <Authorized Context="authorizationState">
        <MudButton Href="/equipamentos/registro"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add">
            Novo equipamento
        </MudButton>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
    else if (loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            <MudText Typo="Typo.body2">@loadError</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LoadEquipmentAsync">Tentar novamente</MudButton>
        </MudAlert>
    }
    else if (equipment.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.Hvac"
                    Title="Nenhum equipamento encontrado"
                    Description="Ajuste os filtros ou cadastre um equipamento para começar." />
    }
    else
    {
        <MudTable Items="@equipment" Class="servicesync-data-grid" Hover="true" Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh>Equipamento</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Número de série</MudTh>
                <MudTh>Local de instalação</MudTh>
                <MudTh aria-label="Ações"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Equipamento">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <GridTextCell Value="@GetEquipmentDescription(context)" />
                        <MudTooltip Text="Ver hist?rico t?cnico">
                            <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Primary" aria-label="Ver hist?rico t?cnico" OnClick="@(() => OpenHistory(context.Id))" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Cliente"><GridTextCell Value="@context.CustomerName" /></MudTd>
                <MudTd DataLabel="Número de série"><GridTextCell Value="@(context.SerialNumber ?? string.Empty)" /></MudTd>
                <MudTd DataLabel="Local de instalação"><GridTextCell Value="@(context.LocationDescription ?? string.Empty)" /></MudTd>
                <AuthorizeView Policy="@AuthorizationPolicies.CompanyOwner">
                    <Authorized Context="authorizationState">
                <MudTd DataLabel="Ações" Class="equipment-type-actions">
                    <MudTooltip Text="Editar equipamento">
                        <MudIconButton Href="@GetEquipmentRegistrationUrl(context.Id)"
                                       Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       aria-label="Editar equipamento" />
                    </MudTooltip>
                    <MudTooltip Text="Inativar equipamento">
                        <MudIconButton Icon="@Icons.Material.Filled.Block"
                                       Color="Color.Error"
                                       aria-label="Inativar equipamento"
                                       OnClick="@(() => OpenDeleteDialog(context))" />
                    </MudTooltip>
                </MudTd>
                    </Authorized>
                </AuthorizeView>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<MudDialog @bind-Visible="isDeleteDialogOpen" Options="deleteDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Inativar equipamento</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Tem certeza que deseja inativar o equipamento <strong>@GetEquipmentDescription(equipmentPendingDeletion)</strong>?</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Esta ação não poderá ser desfeita.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseDeleteDialog" Disabled="@isDeleting">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Block" OnClick="DeleteEquipmentAsync" Disabled="@isDeleting">
            @(isDeleting ? "Inativando..." : "Inativar equipamento")
        </MudButton>
    </DialogActions>
</MudDialog>

<EquipmentHistoryDrawer EquipmentId="@selectedEquipmentId" @bind-Open="isHistoryDrawerOpen" />

@code {
    private readonly DialogOptions deleteDialogOptions = new()
    {
        CloseButton = true,
        MaxWidth = MaxWidth.ExtraSmall,
        FullWidth = true
    };

    private IReadOnlyList<EquipmentDto> equipment = [];
    private EquipmentDto? equipmentPendingDeletion;
    private Guid? selectedEquipmentId;
    private bool isHistoryDrawerOpen;
    private string? searchFilter;
    private string? loadError;
    private bool isLoading = true;
    private bool isDeleteDialogOpen;
    private bool isDeleting;
    private int loadVersion;

    protected override Task OnInitializedAsync() => LoadEquipmentAsync();

    private async Task LoadEquipmentAsync()
    {
        var currentLoadVersion = ++loadVersion;
        isLoading = true;
        loadError = null;

        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (GetEquipmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(new GetEquipmentQuery(searchFilter), cancellationToken));
            if (currentLoadVersion == loadVersion)
            {
                equipment = result;
            }
        }
        catch (Exception exception)
        {
            if (currentLoadVersion != loadVersion)
            {
                return;
            }

            Logger.LogError(exception, "Unable to load equipment for the current company");
            loadError = "Não foi possível carregar os equipamentos. Tente novamente.";
        }
        finally
        {
            if (currentLoadVersion == loadVersion)
            {
                isLoading = false;
            }
        }
    }

    private void OpenHistory(Guid equipmentId)
    {
        selectedEquipmentId = equipmentId;
        isHistoryDrawerOpen = true;
    }

    private void OpenDeleteDialog(EquipmentDto equipmentToDelete)
    {
        equipmentPendingDeletion = equipmentToDelete;
        isDeleteDialogOpen = true;
    }

    private void CloseDeleteDialog()
    {
        isDeleteDialogOpen = false;
        equipmentPendingDeletion = null;
    }

    private async Task DeleteEquipmentAsync()
    {
        if (equipmentPendingDeletion is null)
        {
            return;
        }

        isDeleting = true;
        var equipmentToDelete = equipmentPendingDeletion;

        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (DeleteEquipmentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(equipmentToDelete.Id, cancellationToken));
            if (result.IsSuccess)
            {
                equipment = equipment.Where(item => item.Id != equipmentToDelete.Id).ToArray();
                Snackbar.Add("Equipamento inativado com sucesso.", Severity.Success);
                CloseDeleteDialog();
                return;
            }

            Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Warning);
            CloseDeleteDialog();
            await LoadEquipmentAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to delete equipment {EquipmentId}", equipmentToDelete.Id);
            Snackbar.Add("Não foi possível excluir o equipamento. Tente novamente.", Severity.Error);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private static string GetEquipmentRegistrationUrl(Guid equipmentId) =>
        $"/equipamentos/registro?id={equipmentId}";

    private static string GetEquipmentDescription(EquipmentDto? item) =>
        item is null
            ? string.Empty
            : string.IsNullOrWhiteSpace(item.Manufacturer) || string.IsNullOrWhiteSpace(item.Model)
                ? item.Type
                : $"{item.Type} - {item.Manufacturer} {item.Model}";
}
