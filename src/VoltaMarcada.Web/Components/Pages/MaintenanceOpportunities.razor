@page "/manutencoes"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyOwner)]
@using Microsoft.JSInterop
@using VoltaMarcada.Application.MaintenanceOpportunities
@using VoltaMarcada.Application.PublicBooking
@using VoltaMarcada.Domain.Enums
@using VoltaMarcada.Web.Formatting
@inject IComponentOperationExecutor OperationExecutor
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject ICurrentDisplayTimeZone CurrentDisplayTimeZone
@inject IBrazilianDisplayFormatter DisplayFormatter

<PageTitle>Manutenções | VoltaMarcada</PageTitle>
<PageHeader Title="Oportunidades de retorno" Description="Acompanhe o momento recomendado para trazer cada cliente de volta." />

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="mt-4" />
}
else
{
    <MudGrid Class="mt-4">
        <MudItem xs="6" sm="3"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.caption">Vencidas</MudText><MudText Typo="Typo.h5" Color="Color.Error">@summary.OverdueCount</MudText></MudPaper></MudItem>
        <MudItem xs="6" sm="3"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.caption">Próximos 7 dias</MudText><MudText Typo="Typo.h5" Color="Color.Warning">@summary.NextSevenDaysCount</MudText></MudPaper></MudItem>
        <MudItem xs="6" sm="3"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.caption">Próximos 30 dias</MudText><MudText Typo="Typo.h5">@summary.NextThirtyDaysCount</MudText></MudPaper></MudItem>
        <MudItem xs="6" sm="3"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.caption">Aguardando cliente</MudText><MudText Typo="Typo.h5" Color="Color.Info">@summary.AwaitingCustomerCount</MudText></MudPaper></MudItem>
    </MudGrid>

    <MudPaper Outlined="true" Class="pa-4 mt-4">
        <MudGrid Class="maintenance-filters">
            <MudItem xs="12" sm="6">
                <MudSelect T="MaintenanceOpportunityStatus?" Label="Status da oportunidade" Clearable="true" @bind-Value="status" @bind-Value:after="LoadAsync">
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.Pending)">Pendente</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.Contacted)">Contato realizado</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.AwaitingCustomer)">Aguardando cliente</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.Converted)">Convertida</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.ClosedWithoutConversion)">Encerrada sem conversão</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="MaintenanceOpportunityUrgency?" Label="Prioridade" Clearable="true" @bind-Value="urgency" @bind-Value:after="LoadAsync">
                    <MudSelectItem Value="@((MaintenanceOpportunityUrgency?)MaintenanceOpportunityUrgency.Overdue)">Vencidas</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityUrgency?)MaintenanceOpportunityUrgency.NextSevenDays)">Próximos 7 dias</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityUrgency?)MaintenanceOpportunityUrgency.NextThirtyDays)">Próximos 30 dias</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityUrgency?)MaintenanceOpportunityUrgency.Future)">Futuras</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-5" />

        @if (items.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.BuildCircle" Title="Nenhuma oportunidade encontrada" Description="As recomendações criadas ao concluir uma OS aparecerão aqui." />
        }
        else
        {
            <MudStack Spacing="2" Class="mt-4">
                @foreach (var item in items)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle1">@item.CustomerName</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@GetUrgencyColor(item.Urgency)">@GetUrgencyName(item.Urgency)</MudChip>
                            </MudStack>
                            <MudText Typo="Typo.body2">@item.EquipmentDescription · @item.RecommendedServiceName</MudText>
                            <MudText Typo="Typo.caption">Última manutenção: @(item.PreviousWorkOrderCompletedAtUtc is { } previousWorkOrderCompletedAtUtc ? FormatDate(previousWorkOrderCompletedAtUtc) : "-") · Recomendada: @item.DueDate.ToString("dd/MM/yyyy")</MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(item.Status)">@GetStatusName(item.Status)</MudChip>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => selectedOpportunity = item)">Detalhes</MudButton>
                            </MudStack>

                            @if (IsOpen(item.Status))
                            {
                                <MudStack Row="true" Wrap="Wrap.Wrap" Class="maintenance-actions">
                                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Send" Disabled="@IsContactActionPending(item.Id)" OnClick="@(() => PrepareWhatsAppAsync(item.Id))">Preparar contato</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CalendarMonth" OnClick="@(() => ScheduleAsync(item.Id))">Agendar atendimento</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RequestQuote" OnClick="@(() => CreateQuote(item.Id))">Gerar orçamento</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => OpenDiscardDialog(item))">Descartar</MudButton>
                                </MudStack>
                            }
                            else if (item.Status == MaintenanceOpportunityStatus.Converted)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Success">@GetConversionText(item)</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Encerrada sem conversão em @(item.ClosedAtUtc is { } closedAtUtc ? FormatDateTime(closedAtUtc) : "-"). Motivo: @item.ClosureReason</MudText>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
    </MudPaper>
}

<MudDialog @bind-Visible="isDetailsDialogOpen" Options="dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Detalhes da oportunidade</MudText></TitleContent>
    <DialogContent>
        @if (selectedOpportunity is { } item)
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">@item.CustomerName</MudText>
                <MudText>@item.EquipmentDescription · @item.RecommendedServiceName</MudText>
                <MudText Typo="Typo.body2">Última manutenção: @(item.PreviousWorkOrderCompletedAtUtc is { } previousWorkOrderCompletedAtUtc ? FormatDate(previousWorkOrderCompletedAtUtc) : "-")</MudText>
                <MudText Typo="Typo.body2">Próxima recomendada: @item.DueDate.ToString("dd/MM/yyyy")</MudText>
                @if (!string.IsNullOrWhiteSpace(item.Notes))
                {
                    <MudText Typo="Typo.body2">@item.Notes</MudText>
                }
                <MudDivider />
                <MudText Typo="Typo.subtitle2">Histórico de contatos</MudText>
                @if (item.Contacts.Count == 0)
                {
                    <MudText Typo="Typo.body2">Nenhum contato preparado ainda.</MudText>
                }
                else
                {
                    @foreach (var contact in item.Contacts)
                    {
                        <MudPaper Outlined="true" Class="pa-2">
                            <MudText Typo="Typo.body2">WhatsApp · @GetContactStatusName(contact.Status)</MudText>
                            <MudText Typo="Typo.caption">Preparado em @FormatDateTime(contact.CreatedAtUtc)</MudText>
                            @if (contact.SentAtUtc is { } sentAtUtc)
                            {
                                <MudText Typo="Typo.caption">Enviado em @FormatDateTime(sentAtUtc)</MudText>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@IsContactActionPending(contact.Id)" OnClick="@(() => ConfirmContactSentAsync(item.Id, contact.Id))">Confirmar envio</MudButton>
                            }
                        </MudPaper>
                    }
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        @if (selectedOpportunity is { Status: MaintenanceOpportunityStatus.AwaitingCustomer } awaiting)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RevokeBookingLinkAsync(awaiting.Id))">Revogar link</MudButton>
        }
        <MudButton Variant="Variant.Text" OnClick="CloseDetailsDialog">Fechar</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="isDiscardDialogOpen" Options="dialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Descartar oportunidade</MudText></TitleContent>
    <DialogContent><MudTextField @bind-Value="discardReason" Label="Motivo" Required="true" Lines="3" /></DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseDiscardDialog" Disabled="@isDiscarding">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DiscardAsync" Disabled="@isDiscarding">@(isDiscarding ? "Descartando..." : "Descartar")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [SupplyParameterFromQuery(Name = "urgency")]
    public string? UrgencyQuery { get; set; }

    private readonly DialogOptions dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
    private MaintenanceOpportunitySummary summary = new(0, 0, 0, 0);
    private IReadOnlyList<MaintenanceOpportunityListItem> items = [];
    private readonly HashSet<Guid> contactActionIds = [];
    private MaintenanceOpportunityStatus? status;
    private MaintenanceOpportunityUrgency? urgency;
    private MaintenanceOpportunityListItem? selectedOpportunity;
    private MaintenanceOpportunityListItem? opportunityToDiscard;
    private string? discardReason;
    private bool isLoading = true;
    private bool isDiscarding;
    private TimeZoneInfo displayTimeZone = TimeZoneInfo.Utc;
    private bool isDetailsDialogOpen { get => selectedOpportunity is not null; set { if (!value) selectedOpportunity = null; } }
    private bool isDiscardDialogOpen { get => opportunityToDiscard is not null; set { if (!value) CloseDiscardDialog(); } }

    protected override async Task OnInitializedAsync()
    {
        if (Enum.TryParse<MaintenanceOpportunityUrgency>(UrgencyQuery, true, out var queryUrgency))
        {
            urgency = queryUrgency;
        }

        displayTimeZone = await CurrentDisplayTimeZone.GetTimeZoneAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var summaryResult = await OperationExecutor.ExecuteAsync(
                (GetMaintenanceOpportunitySummaryUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(cancellationToken));
            var listResult = await OperationExecutor.ExecuteAsync(
                (GetMaintenanceOpportunitiesUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(new GetMaintenanceOpportunitiesQuery(status, urgency), cancellationToken));
            if (summaryResult.IsSuccess) summary = summaryResult.Value!;
            if (listResult.IsSuccess) items = listResult.Value!;
            else Snackbar.Add(OperationErrorMessages.GetMessage(listResult.Error?.Code), Severity.Warning);
        }
        finally { isLoading = false; }
    }

    private async Task PrepareWhatsAppAsync(Guid opportunityId)
    {
        contactActionIds.Add(opportunityId);
        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (PrepareMaintenanceOpportunityWhatsAppContactUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(opportunityId, cancellationToken));
            if (!result.IsSuccess) { Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Warning); return; }
            await LoadAsync();
            await JsRuntime.InvokeVoidAsync("open", result.Value!.Link, "_blank");
        }
        finally { contactActionIds.Remove(opportunityId); }
    }

    private async Task ConfirmContactSentAsync(Guid opportunityId, Guid contactId)
    {
        contactActionIds.Add(contactId);
        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (ConfirmMaintenanceOpportunityContactSentUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(opportunityId, contactId, cancellationToken));
            if (result.IsSuccess) await LoadAsync();
            else Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Warning);
        }
        finally { contactActionIds.Remove(contactId); }
    }

    private void ScheduleAsync(Guid id) => NavigationManager.NavigateTo($"/agenda?maintenanceOpportunityId={id}");
    private void CreateQuote(Guid id) => NavigationManager.NavigateTo($"/orcamentos/registro?maintenanceOpportunityId={id}");
    private void OpenDiscardDialog(MaintenanceOpportunityListItem item) { opportunityToDiscard = item; discardReason = null; }
    private void CloseDiscardDialog() { opportunityToDiscard = null; discardReason = null; }
    private void CloseDetailsDialog() => selectedOpportunity = null;

    private async Task DiscardAsync()
    {
        if (opportunityToDiscard is null || string.IsNullOrWhiteSpace(discardReason)) { Snackbar.Add("Informe o motivo do descarte.", Severity.Warning); return; }
        isDiscarding = true;
        try
        {
            var result = await OperationExecutor.ExecuteAsync(
                (DiscardMaintenanceOpportunityUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(opportunityToDiscard.Id, new DiscardMaintenanceOpportunityCommand(discardReason), cancellationToken));
            if (!result.IsSuccess) { Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Warning); return; }
            CloseDiscardDialog();
            await LoadAsync();
        }
        finally { isDiscarding = false; }
    }

    private async Task RevokeBookingLinkAsync(Guid id)
    {
        var result = await OperationExecutor.ExecuteAsync(
            (RevokeMaintenanceBookingLinkUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(id, cancellationToken));
        Snackbar.Add(result.IsSuccess ? "Link revogado." : OperationErrorMessages.GetMessage(result.Error?.Code), result.IsSuccess ? Severity.Success : Severity.Warning);
        if (result.IsSuccess) { CloseDetailsDialog(); await LoadAsync(); }
    }

    private bool IsContactActionPending(Guid id) => contactActionIds.Contains(id);
    private static bool IsOpen(MaintenanceOpportunityStatus value) => value is not MaintenanceOpportunityStatus.Converted and not MaintenanceOpportunityStatus.ClosedWithoutConversion;
    private static Color GetUrgencyColor(MaintenanceOpportunityUrgency value) => value switch { MaintenanceOpportunityUrgency.Overdue => Color.Error, MaintenanceOpportunityUrgency.NextSevenDays => Color.Warning, _ => Color.Primary };
    private static string GetUrgencyName(MaintenanceOpportunityUrgency value) => value switch { MaintenanceOpportunityUrgency.Overdue => "Vencida", MaintenanceOpportunityUrgency.NextSevenDays => "Próximos 7 dias", MaintenanceOpportunityUrgency.NextThirtyDays => "Próximos 30 dias", _ => "Futura" };
    private static Color GetStatusColor(MaintenanceOpportunityStatus value) => value switch { MaintenanceOpportunityStatus.Converted => Color.Success, MaintenanceOpportunityStatus.ClosedWithoutConversion => Color.Default, MaintenanceOpportunityStatus.AwaitingCustomer => Color.Info, MaintenanceOpportunityStatus.Contacted => Color.Warning, _ => Color.Primary };
    private static string GetStatusName(MaintenanceOpportunityStatus value) => value switch { MaintenanceOpportunityStatus.Contacted => "Contato realizado", MaintenanceOpportunityStatus.AwaitingCustomer => "Aguardando cliente", MaintenanceOpportunityStatus.Converted => "Convertida", MaintenanceOpportunityStatus.ClosedWithoutConversion => "Encerrada sem conversão", _ => "Pendente" };
    private static string GetContactStatusName(CustomerContactStatus value) => value == CustomerContactStatus.Prepared ? "Preparado" : "Enviado";
    private string FormatDateTime(DateTimeOffset value) => DisplayFormatter.FormatDateTime(value, displayTimeZone);
    private string FormatDate(DateTimeOffset value) => FormatDateTime(value)[..10];
    private string GetConversionText(MaintenanceOpportunityListItem item)
    {
        if (item.ConversionReference is { } reference && item.ConversionType == MaintenanceOpportunityConversionType.Appointment)
            return $"Convertida em agendamento → Agendamento #{reference.EntityId.ToString()[..8]} → {(reference.AppointmentStartAtUtc is { } startAtUtc ? FormatDateTime(startAtUtc) : "-")}";
        if (item.ConversionReference is { } quoteReference && item.ConversionType == MaintenanceOpportunityConversionType.Quote)
            return $"Convertida em orçamento → Orçamento #{quoteReference.EntityId.ToString()[..8]} → {GetQuoteStatusName(quoteReference.QuoteStatus)}";
        return "Convertida em fluxo externo.";
    }
    private static string GetQuoteStatusName(QuoteStatus? value) => value switch { QuoteStatus.Draft => "Rascunho", QuoteStatus.Sent => "Aguardando aprovação", QuoteStatus.Approved => "Aprovado", QuoteStatus.Rejected => "Recusado", QuoteStatus.Expired => "Expirado", _ => "Acompanhamento indisponível" };
}
