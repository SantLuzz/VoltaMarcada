@page "/manutencoes"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyOwner)]
@using VoltaMarcada.Application.MaintenanceOpportunities
@using VoltaMarcada.Application.PublicBooking
@using VoltaMarcada.Domain.Enums
@using Microsoft.JSInterop
@inject GetMaintenanceOpportunitiesUseCase GetMaintenanceOpportunitiesUseCase
@inject GetMaintenanceOpportunitySummaryUseCase GetMaintenanceOpportunitySummaryUseCase
@inject PrepareMaintenanceOpportunityWhatsAppContactUseCase PrepareWhatsAppContactUseCase
@inject ConfirmMaintenanceOpportunityContactSentUseCase ConfirmContactSentUseCase
@inject MarkMaintenanceOpportunityAsBookingRequestedUseCase MarkBookingRequestedUseCase
@inject CompleteMaintenanceOpportunityUseCase CompleteUseCase
@inject DismissMaintenanceOpportunityUseCase DismissUseCase
@inject RevokeMaintenanceBookingLinkUseCase RevokeMaintenanceBookingLinkUseCase
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<PageTitle>@($"{MaintenanceTitle} | VoltaMarcada")</PageTitle>
<PageHeader Title="@MaintenanceTitle" Description="@MaintenanceDescription" />

@if (isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="mt-4" />
}
else
{
    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="4"><MudPaper Outlined="true" Class="pa-4"><MudText Typo="Typo.caption">Vencidas</MudText><MudText Typo="Typo.h4" Color="Color.Error">@summary.OverdueCount</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="4"><MudPaper Outlined="true" Class="pa-4"><MudText Typo="Typo.caption">Nos proximos 7 dias</MudText><MudText Typo="Typo.h4" Color="Color.Warning">@summary.NextSevenDaysCount</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="4"><MudPaper Outlined="true" Class="pa-4"><MudText Typo="Typo.caption">Nos proximos 30 dias</MudText><MudText Typo="Typo.h4">@summary.NextThirtyDaysCount</MudText></MudPaper></MudItem>
    </MudGrid>

    <MudPaper Outlined="true" Class="pa-4 mt-4">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="MaintenanceOpportunityStatus?" Label="Situacao" Clearable="true" @bind-Value="status" @bind-Value:after="LoadAsync">
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.Pending)">Pendente</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.Contacted)">Contatado</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.BookingRequested)">Agendamento solicitado</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.Booked)">Agendado</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.Completed)">Concluido</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityStatus?)MaintenanceOpportunityStatus.Dismissed)">Ignorado</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="MaintenanceOpportunityUrgency?" Label="Urgencia" Clearable="true" @bind-Value="urgency" @bind-Value:after="LoadAsync">
                    <MudSelectItem Value="@((MaintenanceOpportunityUrgency?)MaintenanceOpportunityUrgency.Overdue)">Vencidas</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityUrgency?)MaintenanceOpportunityUrgency.NextSevenDays)">Proximos 7 dias</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityUrgency?)MaintenanceOpportunityUrgency.NextThirtyDays)">Proximos 30 dias</MudSelectItem>
                    <MudSelectItem Value="@((MaintenanceOpportunityUrgency?)MaintenanceOpportunityUrgency.Future)">Futuras</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (items.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.BuildCircle" Title="Nenhuma manutencao encontrada" Description="As recomendacoes criadas ao concluir uma OS aparecerao aqui." />
        }
        else
        {
            <MudList T="MaintenanceOpportunityListItem">
                @foreach (var item in items)
                {
                    <MudListItem T="MaintenanceOpportunityListItem" Value="@item">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">@item.CustomerName</MudText>
                            <MudText>@item.EquipmentDescription - @item.RecommendedServiceName</MudText>
                            <MudText Typo="Typo.caption">Ultima manutencao: @item.PreviousWorkOrderCompletedAtUtc.LocalDateTime.ToString("dd/MM/yyyy") | Proxima: @item.DueDate.ToString("dd/MM/yyyy")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@GetUrgencyColor(item.Urgency)">@GetUrgencyName(item.Urgency)</MudChip>
                            <MudStack Row="true">
                                @if (item.Status is MaintenanceOpportunityStatus.Pending or MaintenanceOpportunityStatus.Contacted)
                                {
                                    <MudButton Variant="Variant.Text" Disabled="@IsContactActionPending(item.Id)" OnClick="@(() => PrepareWhatsAppAsync(item.Id))">Enviar link pelo WhatsApp</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => ScheduleAsync(item.Id))">Agendar</MudButton>
                                }
                                @if (item.Status == MaintenanceOpportunityStatus.BookingRequested)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@IsContactActionPending(item.Id)" OnClick="@(() => PrepareWhatsAppAsync(item.Id))">Enviar novo link pelo WhatsApp</MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RevokeBookingLinkAsync(item.Id))">Revogar link</MudButton>
                                }
                                @if (item.Status == MaintenanceOpportunityStatus.Booked)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Success" OnClick="@(() => CompleteAsync(item.Id))">Concluir</MudButton>
                                }
                                @if (item.Status is not MaintenanceOpportunityStatus.Completed and not MaintenanceOpportunityStatus.Dismissed)
                                {
                                    @if (dismissalConfirmationId == item.Id)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DismissAsync(item.Id))">Confirmar ignorar</MudButton>
                                        <MudButton Variant="Variant.Text" OnClick="CancelDismiss">Cancelar</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => dismissalConfirmationId = item.Id)">Ignorar</MudButton>
                                    }
                                }
                            </MudStack>

                            <MudPaper Outlined="true" Class="pa-2 mt-2">
                                <MudText Typo="Typo.subtitle2">Historico de contatos</MudText>
                                    @if (item.Contacts.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2">Nenhum contato preparado ainda.</MudText>
                                    }
                                    else
                                    {
                                        <MudList T="CustomerContactHistoryItem">
                                            @foreach (var contact in item.Contacts)
                                            {
                                                <MudListItem T="CustomerContactHistoryItem" Value="@contact">
                                                    <MudStack Spacing="1">
                                                        <MudStack Row="true">
                                                            <MudText Typo="Typo.body2">WhatsApp</MudText>
                                                            <MudChip T="string" Size="Size.Small" Color="@GetContactStatusColor(contact.Status)">@GetContactStatusName(contact.Status)</MudChip>
                                                        </MudStack>
                                                        <MudText Typo="Typo.body2">@contact.Message</MudText>
                                                        <MudText Typo="Typo.caption">Preparado em @contact.CreatedAtUtc.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</MudText>
                                                        @if (contact.SentAtUtc is { } sentAtUtc)
                                                        {
                                                            <MudText Typo="Typo.caption">Enviado em @sentAtUtc.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</MudText>
                                                        }
                                                        else
                                                        {
                                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@IsContactActionPending(contact.Id)" OnClick="@(() => ConfirmContactSentAsync(item.Id, contact.Id))">Confirmar envio</MudButton>
                                                        }
                                                    </MudStack>
                                                </MudListItem>
                                            }
                                        </MudList>
                                    }
                            </MudPaper>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
    </MudPaper>
}

@code {
    private const string MaintenanceTitle = "Manuten\u00E7\u00F5es";
    private const string MaintenanceDescription = "Acompanhe os clientes que podem gerar novos atendimentos.";
    private MaintenanceOpportunitySummary summary = new(0, 0, 0);
    private IReadOnlyList<MaintenanceOpportunityListItem> items = [];
    private readonly HashSet<Guid> contactActionIds = [];
    private MaintenanceOpportunityStatus? status;
    private MaintenanceOpportunityUrgency? urgency;
    private Guid? dismissalConfirmationId;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var summaryResult = await GetMaintenanceOpportunitySummaryUseCase.ExecuteAsync();
            var listResult = await GetMaintenanceOpportunitiesUseCase.ExecuteAsync(new GetMaintenanceOpportunitiesQuery(status, urgency));
            if (summaryResult.IsSuccess)
            {
                summary = summaryResult.Value!;
            }

            if (listResult.IsSuccess)
            {
                items = listResult.Value!;
            }
            else
            {
                Snackbar.Add(OperationErrorMessages.GetMessage(listResult.Error?.Code), Severity.Warning);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PrepareWhatsAppAsync(Guid opportunityId)
    {
        contactActionIds.Add(opportunityId);
        try
        {
            var result = await PrepareWhatsAppContactUseCase.ExecuteAsync(opportunityId);
            if (!result.IsSuccess)
            {
                Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Warning);
                return;
            }

            await LoadAsync();
            await JsRuntime.InvokeVoidAsync("open", result.Value!.Link, "_blank");
        }
        finally
        {
            contactActionIds.Remove(opportunityId);
        }
    }

    private async Task ConfirmContactSentAsync(Guid opportunityId, Guid contactId)
    {
        contactActionIds.Add(contactId);
        try
        {
            var result = await ConfirmContactSentUseCase.ExecuteAsync(opportunityId, contactId);
            if (result.IsSuccess)
            {
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Warning);
            }
        }
        finally
        {
            contactActionIds.Remove(contactId);
        }
    }

    private async Task ScheduleAsync(Guid id)
    {
        var result = await MarkBookingRequestedUseCase.ExecuteAsync(id);
        if (result.IsSuccess)
        {
            NavigationManager.NavigateTo($"/agenda?maintenanceOpportunityId={id}");
        }
        else
        {
            Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Warning);
        }
    }

    private async Task RevokeBookingLinkAsync(Guid id)
    {
        var result = await RevokeMaintenanceBookingLinkUseCase.ExecuteAsync(id);
        Snackbar.Add(result.IsSuccess ? "Link revogado." : OperationErrorMessages.GetMessage(result.Error?.Code), result.IsSuccess ? Severity.Success : Severity.Warning);
        if (result.IsSuccess) await LoadAsync();
    }

    private async Task CompleteAsync(Guid id)
    {
        var result = await CompleteUseCase.ExecuteAsync(id);
        if (result.IsSuccess)
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Warning);
        }
    }

    private async Task DismissAsync(Guid id)
    {
        var result = await DismissUseCase.ExecuteAsync(id);
        if (result.IsSuccess)
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Warning);
        }
    }

    private bool IsContactActionPending(Guid id) => contactActionIds.Contains(id);

    private void CancelDismiss() => dismissalConfirmationId = null;

    private static Color GetUrgencyColor(MaintenanceOpportunityUrgency value) => value switch
    {
        MaintenanceOpportunityUrgency.Overdue => Color.Error,
        MaintenanceOpportunityUrgency.NextSevenDays => Color.Warning,
        _ => Color.Primary
    };

    private static string GetUrgencyName(MaintenanceOpportunityUrgency value) => value switch
    {
        MaintenanceOpportunityUrgency.Overdue => "Vencida",
        MaintenanceOpportunityUrgency.NextSevenDays => "Proximos 7 dias",
        MaintenanceOpportunityUrgency.NextThirtyDays => "Proximos 30 dias",
        _ => "Futura"
    };

    private static Color GetContactStatusColor(CustomerContactStatus value) => value switch
    {
        CustomerContactStatus.Prepared => Color.Warning,
        _ => Color.Success
    };

    private static string GetContactStatusName(CustomerContactStatus value) => value switch
    {
        CustomerContactStatus.Prepared => "Preparado",
        _ => "Enviado"
    };
}
