@page "/plataforma/licencas"
@attribute [Authorize(Policy = AuthorizationPolicies.PlatformAdministrator)]
@layout PlatformLayout
@using VoltaMarcada.Application.Licensing
@using VoltaMarcada.Domain.Enums
@using VoltaMarcada.Infrastructure.Licensing
@using Microsoft.Extensions.Options
@using VoltaMarcada.Web.Configuration
@inject GetPlatformLicensePaymentsUseCase GetPayments
@inject ReviewLicensePaymentUseCase ReviewPayment
@inject ReleaseCompanyLicenseManuallyUseCase ReleaseLicense
@inject IOptions<LicenseBillingOptions> BillingOptions
@inject IComponentOperationExecutor OperationExecutor
@inject ISnackbar Snackbar
@inject OverdueLicenseNotificationService OverdueNotifications

<PageTitle>Licenças</PageTitle>

<PageHeader Title="Licenças" Description="Acompanhe todas as empresas, o status das licenças e os comprovantes de renovação." />

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
    <MudDatePicker Label="Mês do comprovante" @bind-Date="selectedMonth" Clearable="true" />
    <MudButton Color="Color.Primary" Variant="Variant.Outlined" Disabled="@sendingNotifications" OnClick="SendOverdueNotificationsAsync">Enviar avisos vencidos</MudButton>
</MudStack>

<MudCheckBox @bind-Value="pendingOnly" Label="Somente comprovantes pendentes" Color="Color.Warning" />

@if (loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@FilteredPayments" Hover="true" Breakpoint="Breakpoint.Md" Class="servicesync-data-grid">
        <HeaderContent>
            <MudTh Style="width: 18%;">Empresa</MudTh>
            <MudTh Style="width: 22%;">Responsável</MudTh>
            <MudTh>Licença</MudTh>
            <MudTh Style="width: 10%;">Vencimento</MudTh>
            <MudTh>Valor</MudTh>
            <MudTh>Enviado em</MudTh>
            <MudTh>Comprovante</MudTh>
            <MudTh>Análise</MudTh>
            <MudTh Style="width: 5%;">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Empresa" Style="max-width: 0;"><MudText Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" Title="@context.CompanyName">@context.CompanyName</MudText></MudTd>
            <MudTd DataLabel="Responsável" Style="max-width: 0;"><MudText Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" Title="@(context.OwnerName ?? context.OwnerEmail)">@(context.OwnerName ?? context.OwnerEmail)</MudText><MudText Typo="Typo.caption" Style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" Title="@context.OwnerEmail">@context.OwnerEmail</MudText></MudTd>
            <MudTd DataLabel="Licença"><MudChip T="string" Color="@LicenseStatusColor(context.LicenseStatus)">@LicenseStatusText(context.LicenseStatus)</MudChip></MudTd>
            <MudTd DataLabel="Vencimento">@LicenseExpirationText(context)</MudTd>
            <MudTd DataLabel="Valor">@(context.Id == Guid.Empty ? "—" : context.Amount.ToString("C"))</MudTd>
            <MudTd DataLabel="Enviado em">@(context.Id == Guid.Empty ? "—" : context.SubmittedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</MudTd>
            <MudTd DataLabel="Comprovante"><MudChip T="string" Color="@StatusColor(context.Status)" Style="white-space: nowrap;">@StatusText(context.Status)</MudChip></MudTd>
            <MudTd DataLabel="Análise">@(context.ReviewerName ?? "-")<br />@(context.DecidedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</MudTd>
            <MudTd DataLabel="Ações">
                @if (context.Id != Guid.Empty)
                {
                    <MudStack Row="true" Spacing="1">
                        <MudButton Href="@($"/platform/licenses/payments/{context.Id}/proof")" Target="_blank" Variant="Variant.Outlined">Comprovante</MudButton>
                        @if (context.Status == LicensePaymentStatus.PendingReview)
                        {
                            <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="@processing" OnClick="@(() => DecideAsync(context, LicensePaymentReviewDecision.Approve))">Aprovar</MudButton>
                            <MudButton Color="Color.Error" Variant="Variant.Outlined" Disabled="@processing" OnClick="@(() => SelectForRejection(context))">Rejeitar</MudButton>
                        }
                    </MudStack>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.LockOpen" Color="Color.Primary" Title="Liberar licença" OnClick="@(() => SelectForManualRelease(context))" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (selectedForManualRelease is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.h6">Liberar licença</MudText>
            <MudDatePicker Label="Válida até" @bind-Date="manualReleaseExpiration" Required="true" />
            <MudStack Row="true" Class="mt-3">
                <MudButton OnClick="ReleaseSelectedManuallyAsync" Color="Color.Success" Disabled="@(processing || manualReleaseExpiration is null)">Confirmar liberação</MudButton>
                <MudButton OnClick="CancelManualRelease" Variant="Variant.Text">Cancelar</MudButton>
            </MudStack>
        </MudPaper>
    }
    @if (selectedForRejection is not null)
    {
        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.h6">Rejeitar comprovante</MudText>
            <MudTextField @bind-Value="rejectionReason" Label="Motivo da rejeição" Variant="Variant.Outlined" Required="true" FullWidth="true" />
            <MudStack Row="true" Class="mt-3"><MudButton OnClick="RejectSelectedAsync" Color="Color.Error" Disabled="@(processing || string.IsNullOrWhiteSpace(rejectionReason))">Confirmar rejeição</MudButton><MudButton OnClick="CancelRejection" Variant="Variant.Text">Cancelar</MudButton></MudStack>
        </MudPaper>
    }
}

@code {
    private IReadOnlyList<PlatformLicensePaymentDto> payments = [];
    private PlatformLicensePaymentDto? selectedForRejection;
    private PlatformLicensePaymentDto? selectedForManualRelease;
    private DateTime? manualReleaseExpiration;
    private string? rejectionReason;
    private bool loading = true;
    private bool processing;
    private bool sendingNotifications;

    private DateTime? selectedMonth;
    private bool pendingOnly;

    private IEnumerable<PlatformLicensePaymentDto> FilteredPayments =>
        PlatformLicensePaymentFilter.Apply(payments, selectedMonth, pendingOnly);

    protected override async Task OnInitializedAsync()
    {
        payments = await GetPayments.ExecuteAsync();
        loading = false;
    }

    private async Task SendOverdueNotificationsAsync()
    {
        sendingNotifications = true;
        try { await OverdueNotifications.SendOverdueNotificationsAsync(CancellationToken.None); Snackbar.Add("Avisos vencidos processados.", Severity.Success); }
        catch { Snackbar.Add("Não foi possível processar os avisos.", Severity.Error); }
        finally { sendingNotifications = false; }
    }

    private async Task DecideAsync(PlatformLicensePaymentDto payment, LicensePaymentReviewDecision decision, string? reason = null)
    {
        processing = true;
        try
        {
            var result = await ReviewPayment.ExecuteAsync(payment.Id, new(decision, reason));
            if (result.IsSuccess) { Snackbar.Add("Comprovante revisado.", Severity.Success); payments = await GetPayments.ExecuteAsync(); }
            else { Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error); }
        }
        finally { processing = false; }
    }

    private void SelectForManualRelease(PlatformLicensePaymentDto license)
    {
        selectedForManualRelease = license;
        manualReleaseExpiration = DateTime.Today.AddDays(BillingOptions.Value.ManualReleaseDefaultValidityDays);
    }

    private async Task ReleaseSelectedManuallyAsync()
    {
        processing = true;
        try
        {
            var expiration = new DateTimeOffset(manualReleaseExpiration!.Value.Date.AddDays(1).AddTicks(-1), TimeZoneInfo.Local.GetUtcOffset(manualReleaseExpiration.Value));
            var result = await ReleaseLicense.ExecuteAsync(new(selectedForManualRelease!.CompanyId, expiration));
            if (result.IsSuccess) { Snackbar.Add("Licença liberada.", Severity.Success); payments = await GetPayments.ExecuteAsync(); CancelManualRelease(); }
            else { Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error); }
        }
        finally { processing = false; }
    }

    private void CancelManualRelease() { selectedForManualRelease = null; manualReleaseExpiration = null; }
    private void SelectForRejection(PlatformLicensePaymentDto payment) { selectedForRejection = payment; rejectionReason = null; }
    private async Task RejectSelectedAsync() { await DecideAsync(selectedForRejection!, LicensePaymentReviewDecision.Reject, rejectionReason); selectedForRejection = null; rejectionReason = null; }
    private void CancelRejection() { selectedForRejection = null; rejectionReason = null; }
    private static string StatusText(LicensePaymentStatus? status) => status is null ? "NÃO" : "SIM";
    private static Color StatusColor(LicensePaymentStatus? status) => status is null ? Color.Default : Color.Success;
    private static string LicenseStatusText(CompanyLicenseStatus? status) => status switch { CompanyLicenseStatus.Trial => "Trial", CompanyLicenseStatus.Paid => "Ativa", _ => "Não configurada" };
    private static Color LicenseStatusColor(CompanyLicenseStatus? status) => status switch { CompanyLicenseStatus.Trial => Color.Info, CompanyLicenseStatus.Paid => Color.Success, _ => Color.Default };
    private static string LicenseExpirationText(PlatformLicensePaymentDto license) => license.PaidUntilUtc is { } paidUntilUtc
        ? paidUntilUtc.ToLocalTime().ToString("dd/MM/yyyy")
        : license.TrialEndsAtUtc is { } trialEndsAtUtc
            ? $"{trialEndsAtUtc.ToLocalTime():dd/MM/yyyy}"
            : "—";
}