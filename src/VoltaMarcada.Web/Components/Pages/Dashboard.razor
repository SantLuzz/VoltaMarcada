@page "/"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyMember)]
@using VoltaMarcada.Application.Scheduling
@using VoltaMarcada.Application.WorkOrders
@using VoltaMarcada.Application.MaintenanceOpportunities
@inject WorkOrderAuthorization WorkOrderAuthorization
@inject GetAppointmentsUseCase GetAppointmentsUseCase
@inject GetAppointmentRequestsUseCase GetAppointmentRequestsUseCase
@inject GetScheduleBlockRequestsUseCase GetScheduleBlockRequestsUseCase
@inject GetWorkOrdersUseCase GetWorkOrdersUseCase
@inject GetMaintenanceOpportunitySummaryUseCase GetMaintenanceOpportunitySummaryUseCase
@inject ISchedulingConfiguration SchedulingConfiguration
@inject TimeProvider TimeProvider

<PageTitle>Painel | VoltaMarcada</PageTitle>

<PageHeader Title="@(isOwner ? "Painel operacional" : "Minha agenda")" Description="@(isOwner ? "Acompanhe o que precisa de ação na sua operação." : "Veja onde precisa ir e o que precisa fazer.")">
    <Actions>
        @if (isOwner || accessScope?.ProfessionalId is not null)
        {
            <MudStack Row="true" Spacing="2">
                <MudButton Href="/agenda?new=true" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">Novo agendamento</MudButton>
                <MudButton Href="/ordens-servico/registro" Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add">Nova OS</MudButton>
            </MudStack>
        }
    </Actions>
</PageHeader>

@if (isOwner)
{
    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="6" md="3" Class="dashboard-kpi-item"><MudPaper Outlined="true" Class="pa-3 dashboard-kpi-card"><MudText Typo="Typo.caption">Agendamentos no período</MudText><MudText Typo="Typo.h5">@appointments.Count</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3" Class="dashboard-kpi-item"><MudPaper Outlined="true" Class="pa-3 dashboard-kpi-card"><MudText Typo="Typo.caption">OS abertas</MudText><MudText Typo="Typo.h5">@openWorkOrders</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3" Class="dashboard-kpi-item"><MudPaper Outlined="true" Class="pa-3 dashboard-kpi-card"><MudText Typo="Typo.caption">Bloqueios aguardando ação</MudText><MudText Typo="Typo.h5">@pendingBlockRequests</MudText></MudPaper></MudItem>
        <MudItem xs="12" sm="6" md="3" Class="dashboard-kpi-item">
            <a class="dashboard-kpi-link" href="/agenda" aria-label="Ver solicitações externas pendentes na agenda">
                <MudPaper Outlined="true" Class="pa-3 dashboard-kpi-card dashboard-kpi-external-request">
                    <MudText Typo="Typo.caption">Solicitações externas pendentes</MudText>
                    <MudText Typo="Typo.h5">@pendingExternalAppointmentRequests</MudText>
                </MudPaper>
            </a>
        </MudItem>
    </MudGrid>
    <MudPaper Outlined="true" Class="pa-3 mt-4"><MudText Typo="Typo.h6">Manutencoes</MudText><MudText>@maintenanceSummary.OverdueCount vencidas | @maintenanceSummary.NextSevenDaysCount nos proximos 7 dias | @maintenanceSummary.NextThirtyDaysCount nos proximos 30 dias</MudText><MudButton Href="/manutencoes" Variant="Variant.Text" Color="Color.Primary">Ver manutencoes</MudButton></MudPaper>
}

<MudPaper Outlined="true" Class="dashboard-agenda mt-4">
    <div class="dashboard-agenda-toolbar">
        <div>
            <MudText Typo="Typo.h6">@(isOwner ? "Agenda semanal" : "Minha agenda diária")</MudText>
            <MudText Color="Color.Secondary">@GetPeriodDescription()</MudText>
        </div>
        <MudStack Row="true" Spacing="1">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" AriaLabel="Período anterior" OnClick="ShowPreviousPeriodAsync" Disabled="@isLoading" />
            <MudButton Variant="Variant.Outlined" OnClick="ShowTodayAsync" Disabled="@isLoading">Hoje</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" AriaLabel="Próximo período" OnClick="ShowNextPeriodAsync" Disabled="@isLoading" />
        </MudStack>
    </div>

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-4" />
    }
    else if (isOwner)
    {
        <div class="dashboard-week-calendar">
            @foreach (var day in GetVisibleDays())
            {
                var dayAppointments = GetAppointmentsForDay(day);
                <section class="dashboard-calendar-day @(day == today ? "dashboard-calendar-day-current" : null)">
                    <header class="dashboard-calendar-day-header">
                        <MudText Typo="Typo.subtitle2">@day.ToString("ddd", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</MudText>
                        <MudText Typo="Typo.caption">@day.ToString("dd/MM")</MudText>
                        @if (day == today)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="dashboard-calendar-today-chip">Hoje</MudChip>
                        }
                    </header>
                    @if (dayAppointments.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dashboard-calendar-empty">Sem compromissos</MudText>
                    }
                    else
                    {
                        <div class="dashboard-calendar-appointments">
                            @foreach (var appointment in dayAppointments)
                            {
                                <AppointmentCard Appointment="appointment" OnSelected="OpenAppointmentDetailsAsync" />
                            }
                        </div>
                    }
                </section>
            }
        </div>
    }
    else
    {
        var dayAppointments = GetAppointmentsForDay(visibleStartDate);
        <section class="dashboard-day-calendar">
            @if (dayAppointments.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.EventBusy" Title="Nenhum atendimento" Description="Você não tem compromissos neste dia." />
            }
            else
            {
                <div class="dashboard-calendar-appointments">
                    @foreach (var appointment in dayAppointments)
                    {
                        <AppointmentCard Appointment="appointment" OnSelected="OpenAppointmentDetailsAsync" />
                    }
                </div>
            }
        </section>
    }
</MudPaper>

@if (isOwner && pendingBlockRequests > 0)
{
    <a class="dashboard-block-request-alert" href="/agenda" aria-label="Ver solicitações de bloqueio na agenda">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
            @pendingBlockRequests solicitação(ões) de bloqueio aguardam sua análise. Ver na agenda.
        </MudAlert>
    </a>
}

<AppointmentDetailsDialog AppointmentId="@selectedAppointmentId" @bind-Visible="isAppointmentDetailsDialogOpen" />

@code {
    private IReadOnlyList<AppointmentDto> appointments = [];
    private WorkOrderAccessScope? accessScope;
    private DateOnly currentDate;
    private DateOnly today;
    private DateOnly visibleStartDate;
    private bool isLoading = true;
    private bool isAppointmentDetailsDialogOpen;
    private bool isOwner;
    private int pendingBlockRequests;
    private int pendingExternalAppointmentRequests;
    private int openWorkOrders;
    private Guid? selectedAppointmentId;
    private MaintenanceOpportunitySummary maintenanceSummary = new(0, 0, 0);

    protected override async Task OnInitializedAsync()
    {
        today = DateOnly.FromDateTime(AppointmentCalendarTime.ToLocalDateTime(TimeProvider.GetUtcNow(), SchedulingConfiguration.DefaultTimeZoneId));
        currentDate = today;
        accessScope = await WorkOrderAuthorization.GetAccessScopeAsync();
        isOwner = accessScope.IsOwner;
        await LoadAsync();
    }

    private async Task ShowPreviousPeriodAsync()
    {
        currentDate = currentDate.AddDays(isOwner ? -7 : -1);
        await LoadAsync();
    }

    private async Task ShowNextPeriodAsync()
    {
        currentDate = currentDate.AddDays(isOwner ? 7 : 1);
        await LoadAsync();
    }

    private async Task ShowTodayAsync()
    {
        currentDate = today;
        await LoadAsync();
    }

    private void OpenAppointmentDetailsAsync(Guid appointmentId)
    {
        selectedAppointmentId = appointmentId;
        isAppointmentDetailsDialogOpen = true;
    }

    private async Task LoadAsync()
    {
        if (accessScope is not { } currentAccessScope)
        {
            return;
        }

        isLoading = true;
        try
        {
            visibleStartDate = isOwner
                ? currentDate.AddDays(-((int)(currentDate.DayOfWeek + 6) % 7))
                : currentDate;
            var endDate = isOwner ? visibleStartDate.AddDays(7) : visibleStartDate.AddDays(1);
            var range = AppointmentCalendarTime.GetUtcRange(visibleStartDate, endDate, SchedulingConfiguration.AllowedTimeZoneIds);
            appointments = await GetAppointmentsUseCase.ExecuteAsync(currentAccessScope, range.StartAtUtc, range.EndAtUtc);

            if (isOwner)
            {
                pendingExternalAppointmentRequests = (await GetAppointmentRequestsUseCase.ExecuteAsync())
                    .Count(request => request.Status == VoltaMarcada.Domain.Enums.AppointmentRequestStatus.Pending);
                pendingBlockRequests = (await GetScheduleBlockRequestsUseCase.ExecuteAsync(currentAccessScope))
                    .Count(request => request.Status is VoltaMarcada.Domain.Enums.ScheduleBlockRequestStatus.Pending or VoltaMarcada.Domain.Enums.ScheduleBlockRequestStatus.RequiresAppointmentResolution);
                openWorkOrders = (await GetWorkOrdersUseCase.ExecuteAsync(new GetWorkOrdersQuery(null, null)))
                    .Count(workOrder => workOrder.Status is VoltaMarcada.Domain.Enums.WorkOrderStatus.Pending or VoltaMarcada.Domain.Enums.WorkOrderStatus.InProgress);
                var summaryResult = await GetMaintenanceOpportunitySummaryUseCase.ExecuteAsync();
                if (summaryResult.IsSuccess) maintenanceSummary = summaryResult.Value!;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private IReadOnlyList<DateOnly> GetVisibleDays() => Enumerable.Range(0, 7).Select(offset => visibleStartDate.AddDays(offset)).ToArray();

    private IReadOnlyList<AppointmentDto> GetAppointmentsForDay(DateOnly day) => appointments
        .Where(appointment => DateOnly.FromDateTime(AppointmentCalendarTime.ToLocalDateTime(appointment.StartAtUtc, appointment.ProfessionalTimeZoneId)) == day)
        .OrderBy(appointment => appointment.StartAtUtc)
        .ToArray();

    private string GetPeriodDescription() => isOwner
        ? $"{visibleStartDate:dd/MM} a {visibleStartDate.AddDays(6):dd/MM}"
        : visibleStartDate.ToString("dddd, dd 'de' MMMM", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));

}
