@page "/"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyMember)]
@using VoltaMarcada.Application.Dashboard
@using VoltaMarcada.Application.Licensing
@using VoltaMarcada.Application.Scheduling
@using VoltaMarcada.Application.WorkOrders
@using VoltaMarcada.Domain.Enums
@using VoltaMarcada.Web.Formatting
@inject IComponentOperationExecutor OperationExecutor
@inject ISchedulingConfiguration SchedulingConfiguration
@inject TimeProvider TimeProvider
@inject IBrazilianDisplayFormatter DisplayFormatter
@inject NavigationManager NavigationManager
@inject ILogger<Dashboard> Logger

<PageTitle>Painel | VoltaMarcada</PageTitle>

<PageHeader Title="@(isOwner ? "Painel operacional" : "Minha agenda")" Description="@(isOwner ? "Acompanhe o que precisa de ação na sua operação." : "Veja onde precisa ir e o que precisa fazer.")">
    <Actions>
        @if (licenseAccess?.AccessMode == CompanyLicenseAccessMode.Operational && (isOwner || accessScope?.ProfessionalId is not null))
        {
            <MudStack Row="true" Spacing="2">
                <MudButton Href="/agenda?new=true" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">Novo agendamento</MudButton>
                <MudButton Href="/ordens-servico/registro" Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add">Nova OS</MudButton>
            </MudStack>
        }
    </Actions>
</PageHeader>

@if (isOwner && licenseAccess is { } currentLicense)
{
    <MudAlert Severity="@GetLicenseSeverity(currentLicense)" Variant="Variant.Outlined" Class="mt-4" Style="cursor: pointer;" @onclick="NavigateToLicenseRenewal">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
            <div>
                <MudText Typo="Typo.subtitle2">@GetLicenseTitle(currentLicense)</MudText>
                <MudText Typo="Typo.body2">@GetLicensePeriodDescription(currentLicense)</MudText>
                @if (currentLicense.AccessMode != CompanyLicenseAccessMode.Operational)
                {
                    <MudText Typo="Typo.caption">A conta está em modo somente leitura. Regularize a licença para voltar a operar.</MudText>
                }
            </div>
            @if (currentLicense.Action != CompanyLicenseAction.None)
            {
                <MudButton Href="/licenca/renovar" Color="Color.Primary" Variant="Variant.Filled">@GetLicenseActionLabel(currentLicense.Action)</MudButton>
            }
        </MudStack>
    </MudAlert>
}
@if (loadError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@loadError</MudAlert>
}

@if (isOwner)
{
    @if (ownerDashboard is { } dashboard)
    {
        <section class="dashboard-owner-actions mt-4" aria-labelledby="owner-actions-title">
            <MudText Typo="Typo.h6" id="owner-actions-title">O que precisa da sua atenção hoje</MudText>
            <div class="dashboard-owner-action-grid">
                <a class="dashboard-owner-action-link" href="/agenda" aria-label="Ver agendamentos de hoje na agenda">
                    <MudPaper Outlined="true" Class="pa-3 dashboard-owner-action-card">
                        <MudText Typo="Typo.caption">Agendamentos de hoje</MudText>
                        <MudText Typo="Typo.h5">@dashboard.Actions.TodayAppointmentCount</MudText>
                    </MudPaper>
                </a>
                <a class="dashboard-owner-action-link" href="/manutencoes?urgency=Overdue" aria-label="Ver manutenções vencidas">
                    <MudPaper Outlined="true" Class="@GetOwnerActionCardClass(dashboard.Actions.OverdueOpportunityCount, OwnerActionErrorClass)">
                        <MudText Typo="Typo.caption">Manutenções vencidas</MudText>
                        <MudText Typo="Typo.h5" Color="@GetOwnerActionColor(dashboard.Actions.OverdueOpportunityCount, Color.Error)">@dashboard.Actions.OverdueOpportunityCount</MudText>
                    </MudPaper>
                </a>
                <a class="dashboard-owner-action-link" href="/manutencoes?urgency=NextSevenDays" aria-label="Ver manutenções próximas">
                    <MudPaper Outlined="true" Class="@GetOwnerActionCardClass(dashboard.Actions.DueSoonOpportunityCount, OwnerActionWarningClass)">
                        <MudText Typo="Typo.caption">Manutenções próximas</MudText>
                        <MudText Typo="Typo.h5" Color="@GetOwnerActionColor(dashboard.Actions.DueSoonOpportunityCount, Color.Warning)">@dashboard.Actions.DueSoonOpportunityCount</MudText>
                    </MudPaper>
                </a>
                <a class="dashboard-owner-action-link" href="/agenda?pendingRequests=true" aria-label="Ver solicitações pendentes na agenda">
                    <MudPaper Outlined="true" Class="@GetOwnerActionCardClass(dashboard.Actions.PendingAppointmentRequestCount, OwnerActionWarningClass)">
                        <MudText Typo="Typo.caption">Solicitações pendentes</MudText>
                        <MudText Typo="Typo.h5" Color="@GetOwnerActionColor(dashboard.Actions.PendingAppointmentRequestCount, Color.Warning)">@dashboard.Actions.PendingAppointmentRequestCount</MudText>
                    </MudPaper>
                </a>
                <a class="dashboard-owner-action-link" href="/orcamentos?status=Sent" aria-label="Ver orçamentos aguardando resposta">
                    <MudPaper Outlined="true" Class="pa-3 dashboard-owner-action-card">
                        <MudText Typo="Typo.caption">Orçamentos aguardando resposta</MudText>
                        <MudText Typo="Typo.h5">@dashboard.Actions.QuotesAwaitingResponseCount</MudText>
                    </MudPaper>
                </a>
                <a class="dashboard-owner-action-link" href="/ordens-servico?status=Open" aria-label="Ver ordens de serviço abertas">
                    <MudPaper Outlined="true" Class="pa-3 dashboard-owner-action-card">
                        <MudText Typo="Typo.caption">Ordens de serviço abertas</MudText>
                        <MudText Typo="Typo.h5">@dashboard.Actions.OpenWorkOrderCount</MudText>
                    </MudPaper>
                </a>
            </div>
        </section>

        <section class="dashboard-value-funnel" aria-labelledby="value-funnel-title">
            <MudText Typo="Typo.h6" id="value-funnel-title">Resultados das manutenções neste mês</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Acompanhe as oportunidades de retorno identificadas e convertidas no mês atual.</MudText>
            <div class="dashboard-value-funnel-grid">
                <MudPaper Outlined="true" Class="pa-3 dashboard-value-funnel-card"><MudText Typo="Typo.caption">Oportunidades identificadas</MudText><MudText Typo="Typo.h6">@dashboard.ValueFunnel.IdentifiedOpportunityCount</MudText></MudPaper>
                <MudPaper Outlined="true" Class="pa-3 dashboard-value-funnel-card"><MudText Typo="Typo.caption">Clientes contatados distintos</MudText><MudText Typo="Typo.h6">@dashboard.ValueFunnel.ContactedCustomerCount</MudText></MudPaper>
                <MudPaper Outlined="true" Class="pa-3 dashboard-value-funnel-card"><MudText Typo="Typo.caption">Solicitações originadas de manutenção</MudText><MudText Typo="Typo.h6">@dashboard.ValueFunnel.MaintenanceRequestCount</MudText></MudPaper>
                <MudPaper Outlined="true" Class="pa-3 dashboard-value-funnel-card"><MudText Typo="Typo.caption">Agendamentos recuperados</MudText><MudText Typo="Typo.h6">@dashboard.ValueFunnel.RecoveredBookingCount</MudText></MudPaper>
                <MudPaper Outlined="true" Class="pa-3 dashboard-value-funnel-card"><MudText Typo="Typo.caption">Serviços concluídos</MudText><MudText Typo="Typo.h6">@dashboard.ValueFunnel.CompletedServiceCount</MudText></MudPaper>
                <MudPaper Outlined="true" Class="pa-3 dashboard-value-funnel-card"><MudText Typo="Typo.caption">Receita recuperada</MudText><MudText Typo="Typo.h6">@DisplayFormatter.FormatCurrency(dashboard.ValueFunnel.RecoveredRevenue)</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Valor das OS concluídas originadas de manutenção; não representa pagamento.</MudText></MudPaper>
                <MudPaper Outlined="true" Class="pa-3 dashboard-value-funnel-card"><MudText Typo="Typo.caption">Oportunidades em aberto</MudText><MudText Typo="Typo.h6">@dashboard.ValueFunnel.OpenOpportunityCount</MudText></MudPaper>
                <MudPaper Outlined="true" Class="pa-3 dashboard-value-funnel-card"><MudText Typo="Typo.caption">Potencial estimado em aberto</MudText><MudText Typo="Typo.h6">@DisplayFormatter.FormatCurrency(dashboard.ValueFunnel.EstimatedPotentialRevenue)</MudText></MudPaper>
            </div>
        </section>
    }
}
<MudPaper Outlined="true" Class="dashboard-agenda mt-4">
    <div class="dashboard-agenda-toolbar">
        <div>
            <MudText Typo="Typo.h6">@(isOwner ? "Agenda semanal" : "Minha agenda diária")</MudText>
            <MudText Color="Color.Secondary">@GetPeriodDescription()</MudText>
        </div>
        <MudStack Row="true" Spacing="1">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" AriaLabel="Período anterior" OnClick="ShowPreviousPeriodAsync" Disabled="@isLoading" />
            <MudButton Variant="Variant.Outlined" OnClick="ShowTodayAsync" Disabled="@isLoading">Hoje</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" AriaLabel="Próximo período" OnClick="ShowNextPeriodAsync" Disabled="@isLoading" />
        </MudStack>
    </div>

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-4" />
    }
    else if (isOwner)
    {
        <div class="dashboard-week-calendar">
            @foreach (var day in GetVisibleDays())
            {
                var dayAppointments = GetAppointmentsForDay(day);
                <section class="dashboard-calendar-day @(day == today ? "dashboard-calendar-day-current" : null)">
                    <header class="dashboard-calendar-day-header">
                        <MudText Typo="Typo.subtitle2">@day.ToString("ddd", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</MudText>
                        <MudText Typo="Typo.caption">@day.ToString("dd/MM")</MudText>
                        @if (day == today)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="dashboard-calendar-today-chip">Hoje</MudChip>
                        }
                    </header>
                    @if (dayAppointments.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dashboard-calendar-empty">Sem compromissos</MudText>
                    }
                    else
                    {
                        <div class="dashboard-calendar-appointments">
                            @foreach (var appointment in dayAppointments)
                            {
                                <AppointmentCard Appointment="appointment" OnSelected="OpenAppointmentDetailsAsync" />
                            }
                        </div>
                    }
                </section>
            }
        </div>
    }
    else
    {
        var dayAppointments = GetAppointmentsForDay(visibleStartDate);
        <section class="dashboard-day-calendar">
            @if (dayAppointments.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.EventBusy" Title="Nenhum atendimento" Description="Você não tem compromissos neste dia." />
            }
            else
            {
                <div class="dashboard-calendar-appointments">
                    @foreach (var appointment in dayAppointments)
                    {
                        <AppointmentCard Appointment="appointment" OnSelected="OpenAppointmentDetailsAsync" />
                    }
                </div>
            }
        </section>
    }
</MudPaper>

@if (isOwner && pendingBlockRequests > 0)
{
    <a class="dashboard-block-request-alert" href="/agenda" aria-label="Ver solicitações de bloqueio na agenda">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
            @pendingBlockRequests solicitação(ões) de bloqueio aguardam sua análise. Ver na agenda.
        </MudAlert>
    </a>
}

<AppointmentDetailsDialog AppointmentId="@selectedAppointmentId" @bind-Visible="isAppointmentDetailsDialogOpen" OnChanged="LoadAsync" />

@code {
    private const string OwnerActionErrorClass = "dashboard-owner-action-card-error";
    private const string OwnerActionWarningClass = "dashboard-owner-action-card-warning";
    private IReadOnlyList<AppointmentDto> appointments = [];
    private WorkOrderAccessScope? accessScope;
    private DateOnly currentDate;
    private DateOnly today;
    private DateOnly visibleStartDate;
    private bool isLoading = true;
    private bool isAppointmentDetailsDialogOpen;
    private bool isOwner;
    private int pendingBlockRequests;
    private Guid? selectedAppointmentId;
    private OwnerDashboardDto? ownerDashboard;
    private CompanyLicenseAccessDto? licenseAccess;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            today = DateOnly.FromDateTime(AppointmentCalendarTime.ToLocalDateTime(TimeProvider.GetUtcNow(), SchedulingConfiguration.DefaultTimeZoneId));
            currentDate = today;
            accessScope = await OperationExecutor.ExecuteAsync(
                (WorkOrderAuthorization authorization, CancellationToken cancellationToken) => authorization.GetAccessScopeAsync(cancellationToken));
            isOwner = accessScope.IsOwner;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to initialize the dashboard");
            loadError = "Não foi possível carregar o painel. Tente novamente.";
            isLoading = false;
        }
    }

    private async Task ShowPreviousPeriodAsync()
    {
        currentDate = currentDate.AddDays(isOwner ? -7 : -1);
        await LoadAsync();
    }

    private async Task ShowNextPeriodAsync()
    {
        currentDate = currentDate.AddDays(isOwner ? 7 : 1);
        await LoadAsync();
    }

    private async Task ShowTodayAsync()
    {
        currentDate = today;
        await LoadAsync();
    }

    private void OpenAppointmentDetailsAsync(Guid appointmentId)
    {
        selectedAppointmentId = appointmentId;
        isAppointmentDetailsDialogOpen = true;
    }

    private async Task LoadAsync()
    {
        if (accessScope is not { } currentAccessScope)
        {
            return;
        }

        isLoading = true;
        loadError = null;
        ownerDashboard = null;
        pendingBlockRequests = 0;
        try
        {
            licenseAccess = await OperationExecutor.ExecuteAsync(
                (GetCurrentCompanyLicenseUseCase useCase, CancellationToken cancellationToken) =>
                    useCase.ExecuteAsync(cancellationToken));
            if (!isOwner && licenseAccess?.AccessMode != CompanyLicenseAccessMode.Operational)
            {
                NavigationManager.NavigateTo("/conta-bloqueada", forceLoad: true);
                return;
            }

            visibleStartDate = isOwner
                ? currentDate.AddDays(-((int)(currentDate.DayOfWeek + 6) % 7))
                : currentDate;
            var endDate = isOwner ? visibleStartDate.AddDays(7) : visibleStartDate.AddDays(1);
            var range = AppointmentCalendarTime.GetUtcRange(visibleStartDate, endDate, SchedulingConfiguration.AllowedTimeZoneIds);
            appointments = await OperationExecutor.ExecuteAsync(
                (GetAppointmentsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(currentAccessScope, range.StartAtUtc, range.EndAtUtc, cancellationToken));

            if (isOwner)
            {
                var dashboardResult = await OperationExecutor.ExecuteAsync(
                    (GetOwnerDashboardUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(cancellationToken));
                if (!dashboardResult.IsSuccess || dashboardResult.Value is null)
                {
                    loadError = "Não foi possível atualizar os dados do painel. Tente novamente.";
                    return;
                }

                ownerDashboard = dashboardResult.Value;
                pendingBlockRequests = (await OperationExecutor.ExecuteAsync(
                    (GetScheduleBlockRequestsUseCase useCase, CancellationToken cancellationToken) => useCase.ExecuteAsync(currentAccessScope, cancellationToken)))
                    .Count(request => request.Status is VoltaMarcada.Domain.Enums.ScheduleBlockRequestStatus.Pending or VoltaMarcada.Domain.Enums.ScheduleBlockRequestStatus.RequiresAppointmentResolution);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load dashboard data for {CurrentDate}", currentDate);
            loadError = "Não foi possível atualizar os dados do painel. Tente novamente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToLicenseRenewal() => NavigationManager.NavigateTo("/licenca/renovar");

    private static string GetLicenseTitle(CompanyLicenseAccessDto license) => license.Status switch
    {
        CompanyLicenseStatus.Trial => "Período de teste",
        CompanyLicenseStatus.Paid => "Licença ativa",
        _ => "Licença"
    };

    private static string GetLicensePeriodDescription(CompanyLicenseAccessDto license)
    {
        if (license.DaysRemaining == 0)
        {
            return "Vence hoje.";
        }

        if (license.IsOverdue)
        {
            var overdueDays = Math.Abs(license.DaysRemaining);
            return overdueDays == 1 ? "1 dia em atraso." : $"{overdueDays} dias em atraso.";
        }

        return license.DaysRemaining == 1
            ? "1 dia restante."
            : $"{license.DaysRemaining} dias restantes.";
    }

    private static string GetLicenseActionLabel(CompanyLicenseAction action) => action switch
    {
        CompanyLicenseAction.Join => "Aderir",
        CompanyLicenseAction.Renew => "Renovar licença",
        _ => string.Empty
    };

    private static Severity GetLicenseSeverity(CompanyLicenseAccessDto license)
    {
        if (license.AccessMode != CompanyLicenseAccessMode.Operational)
        {
            return Severity.Error;
        }

        return license.Action == CompanyLicenseAction.None ? Severity.Success : Severity.Warning;
    }
    private static string GetOwnerActionCardClass(int count, string attentionClass) =>
        count == 0 ? "pa-3 dashboard-owner-action-card" : $"pa-3 dashboard-owner-action-card {attentionClass}";

    private static Color GetOwnerActionColor(int count, Color attentionColor) =>
        count == 0 ? Color.Default : attentionColor;

    private IReadOnlyList<DateOnly> GetVisibleDays() => Enumerable.Range(0, 7).Select(offset => visibleStartDate.AddDays(offset)).ToArray();

    private IReadOnlyList<AppointmentDto> GetAppointmentsForDay(DateOnly day) => appointments
        .Where(appointment => DateOnly.FromDateTime(AppointmentCalendarTime.ToLocalDateTime(appointment.StartAtUtc, appointment.ProfessionalTimeZoneId)) == day)
        .OrderBy(appointment => appointment.StartAtUtc)
        .ToArray();

    private string GetPeriodDescription() => isOwner
        ? $"{visibleStartDate:dd/MM} a {visibleStartDate.AddDays(6):dd/MM}"
        : visibleStartDate.ToString("dddd, dd 'de' MMMM", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));

}
