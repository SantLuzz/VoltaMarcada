@page "/account/register"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Criar conta | VoltaMarcada</PageTitle>

<section aria-labelledby="register-title">
    <header class="auth-page-header">
        <MudText id="register-title" Typo="Typo.h4">Crie sua conta</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Comece a organizar seus atendimentos e transforme manutenção em novas oportunidades.</MudText>
    </header>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@Error</MudAlert>
    }

    <form method="post" action="/account/register" class="auth-form">
        <AntiforgeryToken />
        <input name="returnUrl" type="hidden" value="@ReturnUrl" />

        <MudTextField T="string" Id="email" Name="email" Label="E-mail" InputType="InputType.Email" AutoComplete="email" Required="true" RequiredError="Campo obrigatório." Error="@HasFieldError("email")" ErrorText="@GetFieldError("email")" Variant="Variant.Outlined" FullWidth="true" />
        <MudTextField T="string" Id="full-name" Name="fullName" Label="Nome completo" AutoComplete="name" Required="true" Error="@HasFieldError("fullName")" ErrorText="@GetFieldError("fullName")" Variant="Variant.Outlined" FullWidth="true" />
        <BrazilianCpfInput Id="document" Name="document" Required="true" />
        @if (HasFieldError("document"))
        {
            <MudText Color="Color.Error" Typo="Typo.caption">@GetFieldError("document")</MudText>
        }
        <BrazilianPhoneInput Id="phone" Name="phone" Required="true" />
        @if (HasFieldError("phone"))
        {
            <MudText Color="Color.Error" Typo="Typo.caption">@GetFieldError("phone")</MudText>
        }
        <MudTextField T="string" Id="address" Name="address" Label="Endereço" AutoComplete="street-address" Required="true" Error="@HasFieldError("address")" ErrorText="@GetFieldError("address")" Variant="Variant.Outlined" FullWidth="true" />
        <PasswordInput Id="password" Name="password" Label="Senha" Autocomplete="new-password" MinLength="6" Required="true" />
        @if (HasFieldError("password"))
        {
            <MudText Color="Color.Error" Typo="Typo.caption">@GetFieldError("password")</MudText>
        }
        <PasswordInput Id="confirm-password" Name="confirmPassword" Label="Confirmar senha" Autocomplete="new-password" MinLength="6" Required="true" />
        @if (HasFieldError("confirmPassword"))
        {
            <MudText Color="Color.Error" Typo="Typo.caption">@GetFieldError("confirmPassword")</MudText>
        }
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">
            <span data-loading-label>Criar conta</span>
            <MudProgressCircular data-loading-spinner Indeterminate="true" Size="Size.Small" aria-hidden="true" />
        </MudButton>
    </form>

    <p class="auth-footer">Já tem uma conta? <MudLink Href="@LoginUrl">Entrar</MudLink></p>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "field")]
    public string? Field { get; set; }

    [SupplyParameterFromQuery(Name = "fieldError")]
    public string? FieldError { get; set; }

    private string LoginUrl => "/account/login" + QueryString.Create("returnUrl", ReturnUrl);

    private bool HasFieldError(string field) => Field == field && !string.IsNullOrWhiteSpace(FieldError);

    private string GetFieldError(string field) => HasFieldError(field) ? FieldError! : string.Empty;
}
