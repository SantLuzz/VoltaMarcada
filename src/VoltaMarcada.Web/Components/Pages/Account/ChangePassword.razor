@page "/account/change-password"
@attribute [Authorize]
@layout MainLayout

<PageTitle>Alterar senha | VoltaMarcada</PageTitle>
<PageHeader Title="Alterar senha" Description="Atualize sua senha de acesso." />
@if (!string.IsNullOrWhiteSpace(Message)) { <MudAlert Severity="Severity.Success">@Message</MudAlert> }
@if (!string.IsNullOrWhiteSpace(Error)) { <MudAlert Severity="Severity.Error">@Error</MudAlert> }
<MudPaper Class="pa-4 mt-4" MaxWidth="MaxWidth.Small">
    <form method="post" action="/account/change-password" class="auth-form">
        <AntiforgeryToken />
        <PasswordInput Id="currentPassword" Name="currentPassword" Label="Senha atual" Autocomplete="current-password" Required="true" />
        <PasswordInput Id="newPassword" Name="newPassword" Label="Nova senha" Autocomplete="new-password" Required="true" />
        <PasswordInput Id="confirmPassword" Name="confirmPassword" Label="Confirme a nova senha" Autocomplete="new-password" Required="true" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Alterar senha</MudButton>
    </form>
</MudPaper>
@code { [SupplyParameterFromQuery(Name = "message")] public string? Message { get; set; } [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; } }
