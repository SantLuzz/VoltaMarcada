@page "/account/forgot-password"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Recuperar senha | VoltaMarcada</PageTitle>
<MudText Typo="Typo.h4">Recupere sua senha</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary">Enviaremos instruções para o seu e-mail.</MudText>
@if (!string.IsNullOrWhiteSpace(Message)) { <MudAlert Severity="Severity.Success" Class="mt-4">@Message</MudAlert> }
<form method="post" action="/account/forgot-password" class="auth-form">
    <AntiforgeryToken />
    <MudTextField T="string" Name="email" Label="E-mail" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" FullWidth="true" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Enviar instruções</MudButton>
</form>
<p class="auth-footer"><MudLink Href="/account/login">Voltar para entrar</MudLink></p>
@code { [SupplyParameterFromQuery(Name = "message")] public string? Message { get; set; } }
