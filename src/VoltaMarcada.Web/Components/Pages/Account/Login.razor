@page "/account/login"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Entrar | VoltaMarcada</PageTitle>

<section aria-labelledby="login-title">
    <header class="auth-page-header">
        <MudText id="login-title" Typo="Typo.h4">Que bom ter você de volta</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Entre para acompanhar sua operação e as próximas oportunidades de manutenção.</MudText>
    </header>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@Error</MudAlert>
    }

    <form method="post" action="/account/login" class="auth-form" data-submission-loading="true">
        <AntiforgeryToken />
        <input name="returnUrl" type="hidden" value="@ReturnUrl" />

        <MudTextField T="string" Id="email" Name="email" Label="E-mail" InputType="InputType.Email" AutoComplete="email" Required="true" RequiredError="Campo obrigatório." Variant="Variant.Outlined" FullWidth="true" />
        <PasswordInput Id="password" Name="password" Label="Senha" Autocomplete="current-password" Required="true" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">
            <span data-loading-label>Entrar</span>
            <MudProgressCircular data-loading-spinner Indeterminate="true" Size="Size.Small" aria-hidden="true" />
        </MudButton>
    </form>

    <p class="auth-footer"><MudLink Href="/account/forgot-password">Esqueci minha senha</MudLink></p>
    <p class="auth-footer">Ainda não tem uma conta? <MudLink Href="@RegisterUrl">Criar conta</MudLink></p>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string RegisterUrl => "/account/register" + QueryString.Create("returnUrl", ReturnUrl);
}
