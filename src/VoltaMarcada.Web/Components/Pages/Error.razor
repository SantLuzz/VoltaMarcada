@page "/error"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Erro | VoltaMarcada</PageTitle>

<section class="status-page" aria-labelledby="error-title">
    <MudPaper Class="status-surface" Elevation="0" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" aria-hidden="true" />
        <MudText id="error-title" Typo="Typo.h4">Não foi possível concluir esta ação</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">Sua sessão pode estar inválida. Saia e entre novamente para continuar com segurança.</MudText>
        <form method="post" action="/account/logout" class="logout-form">
            <AntiforgeryToken />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Sair e entrar novamente</MudButton>
        </form>
    </MudPaper>
</section>
