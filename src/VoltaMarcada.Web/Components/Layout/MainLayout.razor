@inherits LayoutComponentBase
@using Microsoft.EntityFrameworkCore
@using VoltaMarcada.Application.Abstractions.Tenancy
@using VoltaMarcada.Domain.Enums
@using VoltaMarcada.Infrastructure.Persistence
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject ICurrentCompany CurrentCompany

<MudThemeProvider Theme="@VoltaMarcadaTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (hasCompanyContext)
{
<MudLayout>
    <MudAppBar Elevation="0" Class="main-app-bar">
        <MudTooltip Text="Abrir ou recolher menu">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" aria-label="Abrir ou recolher menu" OnClick="ToggleDrawer" />
        </MudTooltip>
        <MudSpacer />
        <MudStack Spacing="0" AlignItems="AlignItems.End" Class="app-bar-account-summary">
            <MudText Typo="Typo.body2" Class="app-bar-company-name">@companyName</MudText>
            <MudText Typo="Typo.caption" Class="app-bar-user-name">@accountSummary</MudText>
        </MudStack>
    </MudAppBar>

    <MudDrawer @bind-Open="isDrawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="0" Width="348px" Class="main-drawer">
        <div class="drawer-content">
            <header class="drawer-brand">
                <img src="/logos/icone.png" alt="VoltaMarcada" class="drawer-logo" />
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Color="Color.Inherit"
                               Class="drawer-close-button"
                               aria-label="Fechar menu"
                               OnClick="ToggleDrawer" />
            </header>
<div class="drawer-navigation-scroll">

    <MudNavMenu Class="drawer-navigation">

        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
            Painel
        </MudNavLink>

        <MudNavLink Href="/agenda" Icon="@Icons.Material.Filled.CalendarMonth">
            Agenda
        </MudNavLink>

        <MudNavGroup Title="Cadastros"
                 Icon="@Icons.Material.Filled.Apps"
                 Expanded="true">
            <MudNavLink Href="/clientes" Icon="@Icons.Material.Filled.People">
                Clientes
            </MudNavLink>

            @if(isOwner)
            {
                <MudNavLink Href="/empresa" Icon="@Icons.Material.Filled.Business">
                    Empresa
                </MudNavLink>
            }

            <MudNavLink Href="/equipamentos" Icon="@Icons.Material.Filled.Hvac">
                Equipamentos
            </MudNavLink>

            @if(isOwner)
            {
                <MudNavLink Href="/licenca/renovar" Icon="@Icons.Material.Filled.Paid">
                    Licença
                </MudNavLink>
            }
            <MudNavLink Href="/profissionais" Icon="@Icons.Material.Filled.Engineering">
                Profissionais
            </MudNavLink>

            <MudNavLink Href="/servicos" Icon="@Icons.Material.Filled.DesignServices">
                Serviços
            </MudNavLink>


        </MudNavGroup>

        @if (isOwner)
        {
            <MudNavLink Href="/caixa" Icon="@Icons.Material.Filled.PointOfSale">
                Caixa
            </MudNavLink>  
            <MudNavLink Href="/manutencoes" Icon="@Icons.Material.Filled.BuildCircle">
                Manutenções
            </MudNavLink>
            
        }

        <MudNavLink Href="/orcamentos" Icon="@Icons.Material.Filled.RequestQuote">
            Orçamentos
        </MudNavLink>

        <MudNavLink Href="/ordens-servico" Icon="@Icons.Material.Filled.Assignment">
            Ordens de serviço
        </MudNavLink>


    </MudNavMenu>

</div>

            <footer class="drawer-footer">
                <form method="post" action="/account/logout" class="logout-form">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Logout" aria-label="Sair da conta">
                        <span data-loading-label>Sair</span>
                        <MudProgressCircular data-loading-spinner Indeterminate="true" Size="Size.Small" aria-hidden="true" />
                    </MudButton>
                </form>
            </footer>
        </div>
    </MudDrawer>

    <MudMainContent>
        <main class="page-content">
            @Body
        </main>
    </MudMainContent>
</MudLayout>
}
else
{
    @Body
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private bool isDrawerOpen = true;
    private bool isOwner;
    private bool hasCompanyContext;
    private string companyName = string.Empty;
    private string accountSummary = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateTask;
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var companyId = await CurrentCompany.FindCompanyIdAsync();
        if (companyId is null)
        {
            return;
        }

        hasCompanyContext = true;
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        companyName = await dbContext.Companies.AsNoTracking()
            .Where(company => company.Id == companyId.Value)
            .Select(company => company.TradeName)
            .SingleOrDefaultAsync();
        var userIdValue = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(userIdValue, out var userId))
        {
            accountSummary = await dbContext.Users.AsNoTracking()
                .Where(item => item.Id == userId)
                .Select(item => item.FullName)
                .SingleOrDefaultAsync() ?? string.Empty;
            isOwner = await dbContext.CompanyUsers.AsNoTracking()
                .AnyAsync(companyUser =>
                    companyUser.UserId == userId &&
                    companyUser.CompanyId == companyId.Value &&
                    companyUser.Role == CompanyUserRole.Owner);
        }
    }

    private void ToggleDrawer() => isDrawerOpen = !isDrawerOpen;
}

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">×</span>
</div>
