@inherits LayoutComponentBase
@using Microsoft.EntityFrameworkCore
@using ServiceSync.Application.Abstractions.Tenancy
@using ServiceSync.Infrastructure.Persistence
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject ICurrentCompany CurrentCompany

<MudThemeProvider Theme="@ServiceSyncTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="main-app-bar">
        <MudTooltip Text="Abrir ou recolher menu">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" aria-label="Abrir ou recolher menu" OnClick="ToggleDrawer" />
        </MudTooltip>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="app-bar-company-name">@companyName</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="isDrawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="0" Class="main-drawer">
        <div class="drawer-content">
            <header class="drawer-brand">
                <img src="/logos/logo.png" alt="ServiceSync" class="drawer-logo" />
            </header>

            <MudNavMenu Class="drawer-navigation">
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Painel</MudNavLink>
            </MudNavMenu>

            <footer class="drawer-footer">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Empresa atual</MudText>
                <MudText Typo="Typo.body2" Class="company-name">@companyName</MudText>
                <form method="post" action="/account/logout" class="logout-form">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Logout" aria-label="Sair da conta">Sair</MudButton>
                </form>
            </footer>
        </div>
    </MudDrawer>

    <MudMainContent>
        <main class="page-content">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private bool isDrawerOpen = true;
    private string companyName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateTask;
        if (authenticationState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var companyId = await CurrentCompany.GetCompanyIdAsync();
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        companyName = await dbContext.Companies.AsNoTracking()
            .Where(company => company.Id == companyId)
            .Select(company => company.TradeName)
            .SingleOrDefaultAsync();
    }

    private void ToggleDrawer() => isDrawerOpen = !isDrawerOpen;
}

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">×</span>
</div>
