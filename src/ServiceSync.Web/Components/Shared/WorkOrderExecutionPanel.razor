@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using ServiceSync.Application.WorkOrders
@using ServiceSync.Domain.Enums
@inject StartWorkOrderUseCase StartWorkOrderUseCase
@inject SaveWorkOrderChecklistProgressUseCase SaveWorkOrderChecklistProgressUseCase
@inject CompleteWorkOrderUseCase CompleteWorkOrderUseCase
@inject AddWorkOrderPhotoUseCase AddWorkOrderPhotoUseCase
@inject RemoveWorkOrderPhotoUseCase RemoveWorkOrderPhotoUseCase
@inject ISnackbar Snackbar

@if (WorkOrder.Status == WorkOrderStatus.Pending)
{
    @if (WorkOrder.Capabilities.CanStart)
    {
        <MudButton OnClick="StartAsync" Color="Color.Primary" Variant="Variant.Filled">Iniciar atendimento</MudButton>
    }
    else
    {
        <MudAlert Severity="Severity.Info">A OS precisa de um profissional habilitado antes de iniciar o atendimento.</MudAlert>
    }
}
else
{
    <MudStack Spacing="3" Class="work-order-execution-content">
        <MudText Typo="Typo.h6">Fotos antes</MudText>
        @if (CanExecute)
        {
            <InputFile OnChange="@(args => UploadAsync(args, WorkOrderPhotoType.Before))" accept="image/*" capture="environment" />
        }
        <div class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.Before))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Foto antes" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" />
                    }
                </div>
            }
        </div>

        <MudText Typo="Typo.h6">Checklist</MudText>
        @if (WorkOrder.ChecklistItems.Count == 0)
        {
            <MudText Color="Color.Secondary">Este serviço não possui checklist configurado.</MudText>
        }
        else
        {
            @foreach (var item in WorkOrder.ChecklistItems)
            {
                <MudCheckBox T="bool" Value="@progress.GetValueOrDefault(item.Id)" ValueChanged="@(value => SetProgress(item.Id, value))" Disabled="@(!CanExecute)">
                    @item.Description @(item.IsRequired ? "(obrigatório)" : string.Empty)
                </MudCheckBox>
            }
        }

        <MudText Typo="Typo.h6">Fotos depois</MudText>
        @if (CanExecute)
        {
            <InputFile OnChange="@(args => UploadAsync(args, WorkOrderPhotoType.After))" accept="image/*" capture="environment" />
        }
        <div class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.After))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Foto depois" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" />
                    }
                </div>
            }
        </div>

        <MudText Typo="Typo.h6">Outras fotos</MudText>
        @if (CanExecute)
        {
            <InputFile OnChange="@(args => UploadAsync(args, WorkOrderPhotoType.Other))" accept="image/*" capture="environment" />
        }
        <div class="work-order-photo-grid">
            @foreach (var photo in WorkOrder.Photos.Where(photo => photo.Type == WorkOrderPhotoType.Other))
            {
                <div class="work-order-photo-card">
                    <MudImage Src="@($"/work-orders/{WorkOrder.Id}/photos/{photo.Id}/content")" Alt="Outra foto" Width="160" Height="120" ObjectFit="ObjectFit.Cover" />
                    @if (CanExecute)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" AriaLabel="Remover foto" OnClick="@(() => RemovePhotoAsync(photo.Id))" />
                    }
                </div>
            }
        </div>

        <MudTextField @bind-Value="executionNotes" @bind-Value:after="ScheduleAutoSave" Label="Observações da execução" Lines="4" Variant="Variant.Outlined" Disabled="@(!CanExecute)" />

        @if (CanExecute)
        {
            <MudStack Row="true">
                <MudButton OnClick="SaveAsync" Variant="Variant.Outlined" Disabled="isSaving">Salvar progresso</MudButton>
                <MudButton OnClick="CompleteAsync" Color="Color.Success" Variant="Variant.Filled" Disabled="isSaving">Concluir serviço</MudButton>
            </MudStack>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public WorkOrderDetailDto WorkOrder { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private readonly Dictionary<Guid, bool> progress = [];
    private CancellationTokenSource? autosaveCancellation;
    private Guid loadedWorkOrderId;
    private string? executionNotes;
    private bool isSaving;

    private bool CanExecute => WorkOrder.Status == WorkOrderStatus.InProgress && WorkOrder.Capabilities.CanExecute;

    protected override void OnParametersSet()
    {
        if (loadedWorkOrderId == WorkOrder.Id && isSaving)
        {
            return;
        }

        loadedWorkOrderId = WorkOrder.Id;
        progress.Clear();
        foreach (var item in WorkOrder.ChecklistItems)
        {
            progress[item.Id] = item.IsCompleted;
        }

        executionNotes = WorkOrder.ExecutionNotes;
    }

    private async Task StartAsync()
    {
        var result = await StartWorkOrderUseCase.ExecuteAsync(WorkOrder.Id);
        if (result.Code == WorkOrderOperationResultCode.Success)
        {
            await OnChanged.InvokeAsync();
            return;
        }

        ShowOperationError(result.Code);
    }

    private void SetProgress(Guid id, bool value)
    {
        progress[id] = value;
        ScheduleAutoSave();
    }

    private void ScheduleAutoSave()
    {
        if (!CanExecute)
        {
            return;
        }

        autosaveCancellation?.Cancel();
        autosaveCancellation?.Dispose();
        autosaveCancellation = new CancellationTokenSource();
        _ = SaveAfterDelayAsync(autosaveCancellation.Token);
    }

    private async Task SaveAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1.5), cancellationToken);
            await FlushProgressAsync(false);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SaveAsync() => await FlushProgressAsync(true);

    private async Task<bool> FlushProgressAsync(bool showSuccess)
    {
        if (!CanExecute)
        {
            return true;
        }

        autosaveCancellation?.Cancel();
        isSaving = true;
        try
        {
            var command = new SaveWorkOrderChecklistProgressCommand(
                progress.Select(item => new ChecklistProgressInput(item.Key, item.Value)).ToArray(),
                executionNotes);
            var result = await SaveWorkOrderChecklistProgressUseCase.ExecuteAsync(WorkOrder.Id, command);
            if (result.Code != WorkOrderOperationResultCode.Success)
            {
                ShowOperationError(result.Code);
                return false;
            }

            if (showSuccess)
            {
                Snackbar.Add("Progresso salvo.", Severity.Success);
            }

            await OnChanged.InvokeAsync();
            return true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CompleteAsync()
    {
        if (!await FlushProgressAsync(false))
        {
            return;
        }

        var result = await CompleteWorkOrderUseCase.ExecuteAsync(WorkOrder.Id);
        if (result.Code == WorkOrderOperationResultCode.Success)
        {
            Snackbar.Add("Serviço concluído.", Severity.Success);
            await OnChanged.InvokeAsync();
            return;
        }

        ShowOperationError(result.Code);
    }

    private async Task UploadAsync(InputFileChangeEventArgs args, WorkOrderPhotoType type)
    {
        var file = args.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            Snackbar.Add("A foto excede 10 MB.", Severity.Warning);
            return;
        }

        await using var stream = file.OpenReadStream(10 * 1024 * 1024 + 1);
        var result = await AddWorkOrderPhotoUseCase.ExecuteAsync(
            WorkOrder.Id,
            new WorkOrderPhotoUpload(stream, file.Name, file.ContentType, file.Size, type, null));
        if (result.Code == WorkOrderOperationResultCode.Success)
        {
            Snackbar.Add("Foto enviada.", Severity.Success);
            await OnChanged.InvokeAsync();
            return;
        }

        ShowOperationError(result.Code);
    }

    private async Task RemovePhotoAsync(Guid photoId)
    {
        var result = await RemoveWorkOrderPhotoUseCase.ExecuteAsync(WorkOrder.Id, photoId);
        if (result.Code == WorkOrderOperationResultCode.Success)
        {
            await OnChanged.InvokeAsync();
            return;
        }

        ShowOperationError(result.Code);
    }

    private void ShowOperationError(WorkOrderOperationResultCode code)
    {
        var message = code switch
        {
            WorkOrderOperationResultCode.ChecklistIncomplete => "Conclua todos os itens obrigatórios do checklist.",
            WorkOrderOperationResultCode.BeforePhotoRequired => "Inclua pelo menos uma foto antes de concluir.",
            WorkOrderOperationResultCode.AfterPhotoRequired => "Inclua pelo menos uma foto depois de concluir.",
            WorkOrderOperationResultCode.ProfessionalNotQualified => "A OS precisa de um profissional habilitado.",
            WorkOrderOperationResultCode.PhotoLimitReached => "O limite de fotos para a OS foi atingido.",
            WorkOrderOperationResultCode.InvalidPhoto => "Envie uma imagem JPEG, PNG, WebP ou HEIC de até 10 MB.",
            _ => "Não foi possível concluir esta operação."
        };

        Snackbar.Add(message, Severity.Warning);
    }

    public async ValueTask DisposeAsync()
    {
        autosaveCancellation?.Cancel();
        if (CanExecute && !isSaving)
        {
            await FlushProgressAsync(false);
        }

        autosaveCancellation?.Dispose();
    }
}
