<div class="password-input">
    <input id="@Id"
           name="@Name"
           type="@(isVisible ? "text" : "password")"
           autocomplete="@Autocomplete"
           minlength="@MinLength"
           required="@Required" />
    <button class="password-visibility-toggle"
            type="button"
            aria-label="@ToggleLabel"
            title="@ToggleLabel"
            @onclick="ToggleVisibility">
        <MudIcon Icon="@(isVisible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" aria-hidden="true" />
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Autocomplete { get; set; } = string.Empty;

    [Parameter]
    public int? MinLength { get; set; }

    [Parameter]
    public bool Required { get; set; }

    private bool isVisible;

    private string ToggleLabel => isVisible ? "Ocultar senha" : "Mostrar senha";

    private void ToggleVisibility() => isVisible = !isVisible;
}
