@using ServiceSync.Application.Scheduling
@using ServiceSync.Domain.Enums
@using ServiceSync.Application.WorkOrders
@inject WorkOrderAuthorization WorkOrderAuthorization
@inject GetScheduleBlockRequestsUseCase GetScheduleBlockRequestsUseCase
@inject CreateScheduleBlockRequestUseCase CreateScheduleBlockRequestUseCase
@inject ApproveScheduleBlockRequestUseCase ApproveScheduleBlockRequestUseCase
@inject RejectScheduleBlockRequestUseCase RejectScheduleBlockRequestUseCase
@inject ISnackbar Snackbar
@inject TimeProvider TimeProvider

<MudPaper Outlined="true" Class="pa-4 mt-4">
    <MudText Typo="Typo.h6">@(isOwner ? "Solicitações de bloqueio" : "Solicitar bloqueio de agenda")</MudText>
    @if (!isOwner)
    {
        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="6"><MudDatePicker Label="Data inicial" @bind-Date="startDate" /></MudItem>
            <MudItem xs="12" sm="6"><MudDatePicker Label="Data final" @bind-Date="endDate" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="notes" Label="Motivo" Lines="2" /></MudItem>
            <MudItem xs="12"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync">Solicitar bloqueio de dia inteiro</MudButton></MudItem>
        </MudGrid>
    }
    @if (requests.Count == 0)
    {
        <MudText Color="Color.Secondary" Class="mt-3">Nenhuma solicitação para exibir.</MudText>
    }
    else
    {
        <MudList T="ScheduleBlockRequestDto" Class="mt-3">
            @foreach (var request in requests)
            {
                <MudListItem T="ScheduleBlockRequestDto" Value="@request" Icon="@Icons.Material.Filled.Block">
                    <MudText>@request.StartDate.ToString("dd/MM") a @request.EndDate.ToString("dd/MM") — @GetStatusName(request.Status)</MudText>
                    @if (isOwner && (request.Status == ScheduleBlockRequestStatus.Pending || request.Status == ScheduleBlockRequestStatus.RequiresAppointmentResolution))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="@(() => ApproveAsync(request.Id))">Aprovar</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RejectAsync(request.Id))">Recusar</MudButton>
                    }
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public WorkOrderAccessScope AccessScope { get; set; } = default!;

    private IReadOnlyList<ScheduleBlockRequestDto> requests = [];
    private bool isOwner;
    private DateTime? startDate;
    private DateTime? endDate;
    private string? notes;

    protected override async Task OnInitializedAsync()
    {
        isOwner = AccessScope.IsOwner;
        var today = TimeProvider.GetLocalNow().Date;
        startDate = today;
        endDate = today;
        await LoadAsync();
    }

    private async Task CreateAsync()
    {
        if (startDate is null || endDate is null) return;
        var result = await CreateScheduleBlockRequestUseCase.ExecuteAsync(new CreateScheduleBlockRequestCommand(ScheduleBlockType.TimeOff, DateOnly.FromDateTime(startDate.Value), DateOnly.FromDateTime(endDate.Value), true, null, null, notes));
        if (result.Code == SchedulingOperationResultCode.Success)
        {
            Snackbar.Add("Solicitação enviada para aprovação.", Severity.Success);
            await LoadAsync();
            return;
        }

        Snackbar.Add("Não foi possível enviar a solicitação.", Severity.Error);
    }

    private async Task ApproveAsync(Guid id)
    {
        var result = await ApproveScheduleBlockRequestUseCase.ExecuteAsync(id);
        Snackbar.Add(result.Code == SchedulingOperationResultCode.Success ? "Bloqueio aprovado." : "Existem atendimentos a ajustar antes da aprovação.", result.Code == SchedulingOperationResultCode.Success ? Severity.Success : Severity.Warning);
        await LoadAsync();
    }

    private async Task RejectAsync(Guid id)
    {
        var result = await RejectScheduleBlockRequestUseCase.ExecuteAsync(id, null);
        if (result.Code == SchedulingOperationResultCode.Success) Snackbar.Add("Solicitação recusada.", Severity.Info);
        await LoadAsync();
    }

    private async Task LoadAsync() => requests = await GetScheduleBlockRequestsUseCase.ExecuteAsync(AccessScope);

    private static string GetStatusName(ScheduleBlockRequestStatus status) => status switch
    {
        ScheduleBlockRequestStatus.Approved => "Aprovada",
        ScheduleBlockRequestStatus.Rejected => "Recusada",
        ScheduleBlockRequestStatus.RequiresAppointmentResolution => "Requer ajuste de agenda",
        _ => "Pendente"
    };
}
