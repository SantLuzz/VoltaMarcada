@using System.Globalization
@using ServiceSync.Application.Professionals
@using ServiceSync.Domain.Enums
@inject GetProfessionalAvailabilityUseCase GetProfessionalAvailabilityUseCase
@inject SaveProfessionalAvailabilityUseCase SaveProfessionalAvailabilityUseCase
@inject CreateScheduleBlockUseCase CreateScheduleBlockUseCase
@inject DeleteScheduleBlockUseCase DeleteScheduleBlockUseCase
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ProfessionalAvailabilityPanel> Logger

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (loadError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@loadError</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Outlined="true" Class="service-form-section">
            <MudText Typo="Typo.h6">Horário padrão</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Defina os dias trabalhados e um único horário aplicado a todos eles.
            </MudText>

            @if (ReadOnly)
            {
                @if (availability?.WeeklySchedule is null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                        O horário padrão ainda não foi configurado.
                    </MudAlert>
                }
                else
                {
                    <MudStack Row="true" Spacing="1" Class="mt-4" Style="flex-wrap: wrap;">
                        @foreach (var dayName in GetSelectedDayNames(availability.WeeklySchedule.WorkDays))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@dayName</MudChip>
                        }
                    </MudStack>
                    <MudGrid Spacing="2" Class="mt-2">
                        <MudItem xs="12" sm="6">
                            <MudTextField Value="@FormatTimeRange(availability.WeeklySchedule.EntryTime, availability.WeeklySchedule.LunchStartTime)"
                                          Label="Expediente da manhã" Variant="Variant.Outlined" FullWidth="true" Disabled="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Value="@FormatTimeRange(availability.WeeklySchedule.LunchEndTime, availability.WeeklySchedule.ExitTime)"
                                          Label="Expediente da tarde" Variant="Variant.Outlined" FullWidth="true" Disabled="true" />
                        </MudItem>
                    </MudGrid>
                }
            }
            else
            {
                @if (scheduleError is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@scheduleError</MudAlert>
                }

                <MudText Typo="Typo.subtitle2" Class="mt-4">Dias trabalhados</MudText>
                <MudGrid Spacing="1" Class="mt-1">
                    @foreach (var day in workdayOptions)
                    {
                        <MudItem xs="6" sm="4" md="3">
                            <MudCheckBox T="bool" Value="@IsWorkdaySelected(day.Value)"
                                         ValueChanged="@(selected => SetWorkday(day.Value, selected))"
                                         Color="Color.Primary" Disabled="@isSavingSchedule">
                                @day.Label
                            </MudCheckBox>
                        </MudItem>
                    }
                </MudGrid>

                <MudGrid Spacing="2" Class="mt-2">
                    <MudItem xs="12" sm="6" md="3">
                        <MudTimePicker @bind-Time="schedule.EntryTime" Label="Entrada" Variant="Variant.Outlined"
                                       AmPm="false" Disabled="@isSavingSchedule" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTimePicker @bind-Time="schedule.LunchStartTime" Label="Início do almoço" Variant="Variant.Outlined"
                                       AmPm="false" Disabled="@isSavingSchedule" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTimePicker @bind-Time="schedule.LunchEndTime" Label="Fim do almoço" Variant="Variant.Outlined"
                                       AmPm="false" Disabled="@isSavingSchedule" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTimePicker @bind-Time="schedule.ExitTime" Label="Saída" Variant="Variant.Outlined"
                                       AmPm="false" Disabled="@isSavingSchedule" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveScheduleAsync" Disabled="@isSavingSchedule">
                        @(isSavingSchedule ? "Salvando..." : "Salvar horário")
                    </MudButton>
                </MudStack>
            }
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="service-form-section">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.h6">Indisponibilidades</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Férias, folgas, compromissos, treinamentos, ausências e bloqueios manuais.
                    </MudText>
                </div>
                @if (!ReadOnly && !showBlockForm)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="ShowBlockForm">
                        Adicionar indisponibilidade
                    </MudButton>
                }
            </MudStack>

            @if (!ReadOnly && showBlockForm)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-4">
                    <MudText Typo="Typo.subtitle1">Nova indisponibilidade</MudText>
                    @if (blockError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">@blockError</MudAlert>
                    }
                    <MudGrid Spacing="2" Class="mt-1">
                        <MudItem xs="12" sm="6">
                            <MudSelect T="ScheduleBlockType" @bind-Value="blockForm.Type" Label="Tipo"
                                       Variant="Variant.Outlined" FullWidth="true" Disabled="@isCreatingBlock">
                                @foreach (var type in Enum.GetValues<ScheduleBlockType>())
                                {
                                    <MudSelectItem Value="@type">@GetBlockTypeLabel(type)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSwitch T="bool" @bind-Value="blockForm.IsFullDay" Color="Color.Primary" Disabled="@isCreatingBlock">
                                Dia inteiro
                            </MudSwitch>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="blockForm.StartDate" Label="Data inicial" Variant="Variant.Outlined"
                                           DateFormat="dd/MM/yyyy" Disabled="@isCreatingBlock" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="blockForm.EndDate" Label="Data final" Variant="Variant.Outlined"
                                           DateFormat="dd/MM/yyyy" Disabled="@isCreatingBlock" />
                        </MudItem>
                        @if (!blockForm.IsFullDay)
                        {
                            <MudItem xs="12" sm="6">
                                <MudTimePicker @bind-Time="blockForm.StartTime" Label="Horário inicial" Variant="Variant.Outlined"
                                               AmPm="false" Disabled="@isCreatingBlock" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTimePicker @bind-Time="blockForm.EndTime" Label="Horário final" Variant="Variant.Outlined"
                                               AmPm="false" Disabled="@isCreatingBlock" />
                            </MudItem>
                        }
                        <MudItem xs="12">
                            <MudTextField @bind-Value="blockForm.Notes" Label="Observações" Variant="Variant.Outlined"
                                          FullWidth="true" Lines="3" MaxLength="1000" Disabled="@isCreatingBlock" />
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelBlockForm" Disabled="@isCreatingBlock">
                            Cancelar
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="CreateBlockAsync" Disabled="@isCreatingBlock">
                            @(isCreatingBlock ? "Adicionando..." : "Adicionar")
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }

            @if (availability is null || availability.ScheduleBlocks.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                    Nenhuma indisponibilidade cadastrada.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@availability.ScheduleBlocks" Class="servicesync-data-grid mt-4" Hover="true" Breakpoint="Breakpoint.Md">
                    <HeaderContent>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Período</MudTh>
                        <MudTh>Observações</MudTh>
                        @if (!ReadOnly)
                        {
                            <MudTh aria-label="Ações"></MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Tipo"><GridTextCell Value="@GetBlockTypeLabel(context.Type)" /></MudTd>
                        <MudTd DataLabel="Período"><GridTextCell Value="@FormatBlockPeriod(context)" /></MudTd>
                        <MudTd DataLabel="Observações"><GridTextCell Value="@(context.Notes ?? "—")" /></MudTd>
                        @if (!ReadOnly)
                        {
                            <MudTd DataLabel="Ações">
                                <MudTooltip Text="Remover indisponibilidade">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                                                   aria-label="Remover indisponibilidade"
                                                   Disabled="@(deletingBlockId == context.Id)"
                                                   OnClick="@(() => DeleteBlockAsync(context))" />
                                </MudTooltip>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public Guid ProfessionalId { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    private static readonly (ProfessionalWorkDays Value, string Label)[] workdayOptions =
    [
        (ProfessionalWorkDays.Monday, "Segunda-feira"),
        (ProfessionalWorkDays.Tuesday, "Terça-feira"),
        (ProfessionalWorkDays.Wednesday, "Quarta-feira"),
        (ProfessionalWorkDays.Thursday, "Quinta-feira"),
        (ProfessionalWorkDays.Friday, "Sexta-feira"),
        (ProfessionalWorkDays.Saturday, "Sábado"),
        (ProfessionalWorkDays.Sunday, "Domingo")
    ];

    private ProfessionalAvailabilityDto? availability;
    private readonly WeeklyScheduleFormModel schedule = new();
    private ScheduleBlockFormModel blockForm = ScheduleBlockFormModel.CreateDefault();
    private Guid? loadedProfessionalId;
    private Guid? deletingBlockId;
    private bool isLoading = true;
    private bool isSavingSchedule;
    private bool isCreatingBlock;
    private bool showBlockForm;
    private string? loadError;
    private string? scheduleError;
    private string? blockError;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedProfessionalId == ProfessionalId)
        {
            return;
        }

        loadedProfessionalId = ProfessionalId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            availability = await GetProfessionalAvailabilityUseCase.ExecuteAsync(ProfessionalId);
            if (availability is null)
            {
                loadError = "Não foi possível localizar a disponibilidade deste profissional.";
                return;
            }

            schedule.Load(availability.WeeklySchedule);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load availability for professional {ProfessionalId}", ProfessionalId);
            loadError = "Não foi possível carregar a disponibilidade. Tente novamente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsWorkdaySelected(ProfessionalWorkDays day) =>
        (schedule.WorkDays & day) == day;

    private void SetWorkday(ProfessionalWorkDays day, bool selected)
    {
        schedule.WorkDays = selected ? schedule.WorkDays | day : schedule.WorkDays & ~day;
    }

    private async Task SaveScheduleAsync()
    {
        scheduleError = ValidateSchedule();
        if (scheduleError is not null)
        {
            return;
        }

        isSavingSchedule = true;
        try
        {
            var result = await SaveProfessionalAvailabilityUseCase.ExecuteAsync(
                ProfessionalId,
                new SaveProfessionalAvailabilityCommand(
                    schedule.WorkDays,
                    TimeOnly.FromTimeSpan(schedule.EntryTime!.Value),
                    TimeOnly.FromTimeSpan(schedule.LunchStartTime!.Value),
                    TimeOnly.FromTimeSpan(schedule.LunchEndTime!.Value),
                    TimeOnly.FromTimeSpan(schedule.ExitTime!.Value)));
            if (result.Code != ProfessionalAvailabilityOperationResultCode.Success)
            {
                scheduleError = "Revise os dias e horários informados.";
                return;
            }

            await ReloadAvailabilityAsync();
            Snackbar.Add("Horário do profissional salvo com sucesso.", Severity.Success);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to save availability for professional {ProfessionalId}", ProfessionalId);
            scheduleError = "Não foi possível salvar o horário. Tente novamente.";
        }
        finally
        {
            isSavingSchedule = false;
        }
    }

    private string? ValidateSchedule()
    {
        if (schedule.WorkDays == ProfessionalWorkDays.None)
        {
            return "Selecione ao menos um dia de trabalho.";
        }

        if (schedule.EntryTime is null || schedule.LunchStartTime is null || schedule.LunchEndTime is null || schedule.ExitTime is null)
        {
            return "Informe todos os horários do expediente.";
        }

        if (schedule.EntryTime >= schedule.LunchStartTime ||
            schedule.LunchStartTime >= schedule.LunchEndTime ||
            schedule.LunchEndTime >= schedule.ExitTime)
        {
            return "Os horários devem seguir a ordem: entrada, início do almoço, fim do almoço e saída.";
        }

        return null;
    }

    private void ShowBlockForm()
    {
        blockError = null;
        blockForm = ScheduleBlockFormModel.CreateDefault();
        showBlockForm = true;
    }

    private void CancelBlockForm()
    {
        blockError = null;
        showBlockForm = false;
    }

    private async Task CreateBlockAsync()
    {
        blockError = ValidateBlock();
        if (blockError is not null)
        {
            return;
        }

        isCreatingBlock = true;
        try
        {
            var startDate = DateOnly.FromDateTime(blockForm.StartDate!.Value);
            var endDate = DateOnly.FromDateTime(blockForm.EndDate!.Value);
            var result = await CreateScheduleBlockUseCase.ExecuteAsync(
                ProfessionalId,
                new CreateScheduleBlockCommand(
                    blockForm.Type,
                    startDate,
                    endDate,
                    blockForm.IsFullDay,
                    blockForm.IsFullDay ? null : TimeOnly.FromTimeSpan(blockForm.StartTime!.Value),
                    blockForm.IsFullDay ? null : TimeOnly.FromTimeSpan(blockForm.EndTime!.Value),
                    blockForm.Notes));
            if (result.Code != ProfessionalAvailabilityOperationResultCode.Success)
            {
                blockError = "Revise o período informado.";
                return;
            }

            await ReloadAvailabilityAsync();
            showBlockForm = false;
            blockForm = ScheduleBlockFormModel.CreateDefault();
            Snackbar.Add("Indisponibilidade adicionada com sucesso.", Severity.Success);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to create schedule block for professional {ProfessionalId}", ProfessionalId);
            blockError = "Não foi possível adicionar a indisponibilidade. Tente novamente.";
        }
        finally
        {
            isCreatingBlock = false;
        }
    }

    private string? ValidateBlock()
    {
        if (blockForm.StartDate is null || blockForm.EndDate is null)
        {
            return "Informe a data inicial e a data final.";
        }

        if (blockForm.EndDate.Value.Date < blockForm.StartDate.Value.Date)
        {
            return "A data final não pode ser anterior à data inicial.";
        }

        if (blockForm.IsFullDay)
        {
            return null;
        }

        if (blockForm.StartDate.Value.Date != blockForm.EndDate.Value.Date)
        {
            return "Indisponibilidades com horário devem ocorrer em um único dia.";
        }

        if (blockForm.StartTime is null || blockForm.EndTime is null || blockForm.StartTime >= blockForm.EndTime)
        {
            return "Informe um horário inicial anterior ao horário final.";
        }

        return null;
    }

    private async Task DeleteBlockAsync(ScheduleBlockDto block)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remover indisponibilidade",
            $"Deseja remover {GetBlockTypeLabel(block.Type).ToLowerInvariant()} de {FormatBlockPeriod(block)}?",
            "Remover",
            null,
            "Cancelar");
        if (confirmed != true)
        {
            return;
        }

        deletingBlockId = block.Id;
        try
        {
            var result = await DeleteScheduleBlockUseCase.ExecuteAsync(ProfessionalId, block.Id);
            if (result.Code != ProfessionalAvailabilityOperationResultCode.Success)
            {
                Snackbar.Add("Não foi possível remover a indisponibilidade.", Severity.Error);
                return;
            }

            await ReloadAvailabilityAsync();
            Snackbar.Add("Indisponibilidade removida.", Severity.Success);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unable to delete schedule block {ScheduleBlockId} for professional {ProfessionalId}",
                block.Id,
                ProfessionalId);
            Snackbar.Add("Não foi possível remover a indisponibilidade.", Severity.Error);
        }
        finally
        {
            deletingBlockId = null;
        }
    }

    private async Task ReloadAvailabilityAsync()
    {
        availability = await GetProfessionalAvailabilityUseCase.ExecuteAsync(ProfessionalId);
        if (availability is null)
        {
            throw new InvalidOperationException("Professional availability could not be reloaded.");
        }

        schedule.Load(availability.WeeklySchedule);
    }

    private static IEnumerable<string> GetSelectedDayNames(ProfessionalWorkDays workDays) =>
        workdayOptions.Where(option => (workDays & option.Value) == option.Value).Select(option => option.Label);

    private static string FormatTimeRange(TimeOnly startTime, TimeOnly endTime) =>
        $"{startTime:HH:mm} às {endTime:HH:mm}";

    private static string FormatBlockPeriod(ScheduleBlockDto block)
    {
        var startDate = block.StartDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
        if (!block.IsFullDay && block.StartTime is { } startTime && block.EndTime is { } endTime)
        {
            return $"{startDate}, {startTime:HH:mm} às {endTime:HH:mm}";
        }

        if (block.StartDate == block.EndDate)
        {
            return $"{startDate}, dia inteiro";
        }

        return $"{startDate} a {block.EndDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)}, dias inteiros";
    }

    private static string GetBlockTypeLabel(ScheduleBlockType type) =>
        type switch
        {
            ScheduleBlockType.TimeOff => "Folga",
            ScheduleBlockType.Vacation => "Férias",
            ScheduleBlockType.Appointment => "Compromisso",
            ScheduleBlockType.Training => "Treinamento",
            ScheduleBlockType.Absence => "Ausência",
            ScheduleBlockType.Manual => "Bloqueio manual",
            _ => "Indisponibilidade"
        };

    private sealed class WeeklyScheduleFormModel
    {
        public ProfessionalWorkDays WorkDays { get; set; }
        public TimeSpan? EntryTime { get; set; }
        public TimeSpan? LunchStartTime { get; set; }
        public TimeSpan? LunchEndTime { get; set; }
        public TimeSpan? ExitTime { get; set; }

        public void Load(WeeklyScheduleDto? weeklySchedule)
        {
            WorkDays = weeklySchedule?.WorkDays ??
                (ProfessionalWorkDays.Monday |
                 ProfessionalWorkDays.Tuesday |
                 ProfessionalWorkDays.Wednesday |
                 ProfessionalWorkDays.Thursday |
                 ProfessionalWorkDays.Friday);
            EntryTime = weeklySchedule?.EntryTime.ToTimeSpan() ?? new TimeSpan(8, 0, 0);
            LunchStartTime = weeklySchedule?.LunchStartTime.ToTimeSpan() ?? new TimeSpan(12, 0, 0);
            LunchEndTime = weeklySchedule?.LunchEndTime.ToTimeSpan() ?? new TimeSpan(13, 0, 0);
            ExitTime = weeklySchedule?.ExitTime.ToTimeSpan() ?? new TimeSpan(18, 0, 0);
        }
    }

    private sealed class ScheduleBlockFormModel
    {
        public ScheduleBlockType Type { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public bool IsFullDay { get; set; }
        public TimeSpan? StartTime { get; set; }
        public TimeSpan? EndTime { get; set; }
        public string? Notes { get; set; }

        public static ScheduleBlockFormModel CreateDefault()
        {
            return new ScheduleBlockFormModel
            {
                Type = ScheduleBlockType.Vacation,
                IsFullDay = true,
                StartTime = new TimeSpan(8, 0, 0),
                EndTime = new TimeSpan(18, 0, 0)
            };
        }
    }
}
