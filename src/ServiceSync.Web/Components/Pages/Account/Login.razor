@page "/account/login"
@attribute [AllowAnonymous]
@layout AuthLayout

<PageTitle>Entrar | ServiceSync</PageTitle>

<section class="auth-card" aria-labelledby="login-title">
    <a class="auth-brand" href="/account/login">ServiceSync</a>

    <h1 id="login-title">Que bom ter você de volta</h1>
    <p class="auth-subtitle">Entre para acompanhar sua operação e as próximas oportunidades de manutenção.</p>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="auth-feedback" role="alert">@Error</div>
    }

    <form method="post" action="/account/login">
        <AntiforgeryToken />

        <div class="auth-field">
            <label for="email">E-mail</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="auth-field">
            <label for="password">Senha</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required />
        </div>

        <button class="auth-submit" type="submit">Entrar</button>
    </form>

    <p class="auth-footer">Ainda não tem uma conta? <a href="/account/register">Criar conta</a></p>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
