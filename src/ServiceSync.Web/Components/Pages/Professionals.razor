@page "/profissionais"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyMember)]
@using ServiceSync.Application.Abstractions.Tenancy
@using ServiceSync.Application.Professionals
@inject ICurrentCompany CurrentCompany
@inject ProfessionalOwnerAuthorization ProfessionalOwnerAuthorization
@inject GetProfessionalsUseCase GetProfessionalsUseCase
@inject GetCurrentEmployeeProfessionalUseCase GetCurrentEmployeeProfessionalUseCase
@inject ChangeProfessionalStatusUseCase ChangeProfessionalStatusUseCase
@inject ISnackbar Snackbar
@inject ILogger<Professionals> Logger

<PageTitle>Profissionais | ServiceSync</PageTitle>

@if (isOwner)
{
    <PageHeader Title="Profissionais" Description="Vincule funcionários e defina os serviços que cada profissional executa.">
        <Actions>
            <MudButton Href="/profissionais/registro" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Novo profissional</MudButton>
        </Actions>
    </PageHeader>
}
else
{
    <PageHeader Title="Meu perfil profissional" Description="Consulte os serviços vinculados ao seu perfil profissional." />
}

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (loadError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@loadError</MudAlert>
}
else if (isOwner)
{
    <MudPaper Elevation="0" Outlined="true" Class="service-list-surface">
        <MudTable Items="@professionals" Class="servicesync-data-grid" Hover="true" Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh>Funcionário</MudTh>
                <MudTh>Serviços</MudTh>
                <MudTh>Status</MudTh>
                <MudTh aria-label="Ações"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Funcionário"><GridTextCell Value="@context.CompanyMemberName" /></MudTd>
                <MudTd DataLabel="Serviços">@(string.Join(", ", context.ServiceNames))</MudTd>
                <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Ativo" : "Inativo")</MudChip></MudTd>
                <MudTd DataLabel="Ações">
                    <MudTooltip Text="Editar profissional"><MudIconButton Href="@($"/profissionais/registro?id={context.Id}")" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" aria-label="Editar profissional" /></MudTooltip>
                    <MudTooltip Text="@(context.IsActive ? "Inativar profissional" : "Reativar profissional")"><MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)" Color="@(context.IsActive ? Color.Error : Color.Success)" aria-label="Alterar status do profissional" OnClick="@(() => ChangeStatusAsync(context))" /></MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}
else if (currentProfessional is null)
{
    <EmptyState Icon="@Icons.Material.Filled.PersonOff" Title="Perfil profissional não vinculado" Description="Peça ao responsável pela empresa para vincular seu cadastro de funcionário a um profissional." />
}
else
{
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Outlined="true" Class="service-form-section">
            <MudText Typo="Typo.h6">Dados do profissional</MudText>
            <MudTextField Value="@currentProfessional.CompanyMemberName" Label="Funcionário" Variant="Variant.Outlined" FullWidth="true" Disabled="true" Class="mt-4" />
            <MudTextField Value="@currentProfessional.CompanyMemberEmail" Label="E-mail" Variant="Variant.Outlined" FullWidth="true" Disabled="true" Class="mt-3" />
            <MudText Typo="Typo.subtitle2" Class="mt-4">Serviços executados</MudText>
            <MudList T="string" Dense="true">
                @foreach (var serviceName in currentProfessional.ServiceNames)
                {
                    <MudListItem T="string">@serviceName</MudListItem>
                }
            </MudList>
            <MudTextField Value="@(currentProfessional.IsActive ? "Ativo" : "Inativo")" Label="Status" Variant="Variant.Outlined" FullWidth="true" Disabled="true" Class="mt-3" />
        </MudPaper>

        <ProfessionalAvailabilityPanel ProfessionalId="@currentProfessional.Id" ReadOnly="true" />
    </MudStack>
}

@code {
    private IReadOnlyList<ProfessionalDto> professionals = [];
    private ProfessionalDto? currentProfessional;
    private bool isOwner;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var companyId = await CurrentCompany.GetCompanyIdAsync();
            isOwner = await ProfessionalOwnerAuthorization.IsOwnerAsync(companyId);
            if (isOwner)
            {
                professionals = await GetProfessionalsUseCase.ExecuteAsync();
            }
            else
            {
                currentProfessional = await GetCurrentEmployeeProfessionalUseCase.ExecuteAsync();
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load professionals for the current company");
            loadError = "Não foi possível carregar os profissionais. Tente novamente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeStatusAsync(ProfessionalDto professional)
    {
        var result = await ChangeProfessionalStatusUseCase.ExecuteAsync(professional.Id, !professional.IsActive);
        if (!result.IsSuccess)
        {
            Snackbar.Add(OperationErrorMessages.GetMessage(result.Error?.Code), Severity.Error);
            return;
        }

        professionals = professionals.Select(item => item.Id == professional.Id ? item with { IsActive = !item.IsActive } : item).ToArray();
        Snackbar.Add(professional.IsActive ? "Profissional inativado." : "Profissional reativado.", Severity.Success);
    }
}
