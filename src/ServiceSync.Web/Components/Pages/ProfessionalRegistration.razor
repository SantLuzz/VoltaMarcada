@page "/profissionais/registro"
@attribute [Authorize(Policy = AuthorizationPolicies.CompanyOwner)]
@using ServiceSync.Application.Professionals
@inject GetProfessionalForEditUseCase GetProfessionalForEditUseCase
@inject GetProfessionalRegistrationOptionsUseCase GetProfessionalRegistrationOptionsUseCase
@inject CreateProfessionalUseCase CreateProfessionalUseCase
@inject UpdateProfessionalUseCase UpdateProfessionalUseCase
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject ILogger<ProfessionalRegistration> Logger

<PageTitle>@(isEditing ? "Editar profissional" : "Novo profissional") | ServiceSync</PageTitle>

<PageHeader Title="@(isEditing ? "Editar profissional" : "Novo profissional")" Description="Vincule um funcionário aos serviços que ele executa.">
    <Actions>
        <MudButton Href="/profissionais" Variant="Variant.Outlined" Color="Color.Default" Disabled="@isSaving">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="@(isLoading || isSaving)">@(isSaving ? "Salvando..." : "Salvar profissional")</MudButton>
    </Actions>
</PageHeader>

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (submitError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@submitError</MudAlert>
    }
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mt-4">
        <MudTabPanel Text="Dados e serviços" Icon="@Icons.Material.Filled.Person" PanelClass="pa-0 mt-4">
            <MudPaper Elevation="0" Outlined="true" Class="service-form-section">
                <MudText Typo="Typo.h6">Dados do profissional</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">O vínculo com o funcionário e ao menos um serviço são obrigatórios.</MudText>
                <MudSelect T="Guid?" @bind-Value="model.CompanyUserId" Label="Funcionário" Placeholder="Selecione um funcionário" Variant="Variant.Outlined" FullWidth="true" Required="true" Class="mt-4" Disabled="@isSaving">
                    @foreach (var member in options.CompanyMembers)
                    {
                        <MudSelectItem Value="@((Guid?)member.Id)">@member.Name (@member.Email)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="Guid" SelectedValues="@model.ServiceIds" SelectedValuesChanged="OnServiceIdsChanged" MultiSelectionTextFunc="GetSelectedServicesText" Label="Serviços executados" Placeholder="Selecione os serviços executados" Variant="Variant.Outlined" FullWidth="true" MultiSelection="true" Required="true" Class="mt-4" Disabled="@isSaving">
                    @foreach (var service in options.Services)
                    {
                        <MudSelectItem Value="@service.Id">@service.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" @bind-Value="model.TimeZoneId" Label="Fuso horÃ¡rio" Variant="Variant.Outlined" FullWidth="true" Required="true" Class="mt-4" Disabled="@isSaving">
                    @foreach (var timeZoneId in options.TimeZoneIds)
                    {
                        <MudSelectItem Value="@timeZoneId">@timeZoneId</MudSelectItem>
                    }
                </MudSelect>

                @if (!isEditing)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                        Salve o profissional para configurar os dias, horários e indisponibilidades.
                    </MudAlert>
                }
            </MudPaper>
        </MudTabPanel>
        @if (ProfessionalId is { } professionalId)
        {
            <MudTabPanel Text="Disponibilidade" Icon="@Icons.Material.Filled.EventAvailable" PanelClass="pa-0 mt-4">
                <ProfessionalAvailabilityPanel ProfessionalId="@professionalId" />
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public Guid? ProfessionalId { get; set; }

    private readonly ProfessionalFormModel model = new();
    private ProfessionalRegistrationOptionsDto options = new([], [], [], "America/Sao_Paulo");
    private bool isLoading = true;
    private bool isSaving;
    private string? submitError;
    private bool isEditing => ProfessionalId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (ProfessionalId is { } professionalId)
            {
                var professional = await GetProfessionalForEditUseCase.ExecuteAsync(professionalId);
                if (professional is null)
                {
                    NavigationManager.NavigateTo("/profissionais");
                    return;
                }

                model.CompanyUserId = professional.CompanyUserId;
                model.ServiceIds = professional.ServiceIds.ToHashSet();
                model.TimeZoneId = professional.TimeZoneId;
            }

            options = await GetProfessionalRegistrationOptionsUseCase.ExecuteAsync(ProfessionalId);
            if (string.IsNullOrWhiteSpace(model.TimeZoneId))
            {
                model.TimeZoneId = options.DefaultTimeZoneId;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to initialize professional registration");
            submitError = "Não foi possível carregar os dados do profissional.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        submitError = null;
        isSaving = true;
        try
        {
            var companyUserId = model.CompanyUserId.GetValueOrDefault();
            if (companyUserId == Guid.Empty)
            {
                submitError = "Selecione um funcionário.";
                return;
            }

            var result = ProfessionalId is { } professionalId
                ? await UpdateProfessionalUseCase.ExecuteAsync(professionalId, new UpdateProfessionalCommand(companyUserId, model.ServiceIds.ToArray(), model.TimeZoneId))
                : await CreateProfessionalUseCase.ExecuteAsync(new CreateProfessionalCommand(companyUserId, model.ServiceIds.ToArray(), model.TimeZoneId));
            if (result.Code != ProfessionalOperationResultCode.Success)
            {
                submitError = "Revise o funcionário e os serviços selecionados.";
                return;
            }

            Snackbar.Add(isEditing ? "Profissional atualizado com sucesso." : "Profissional cadastrado com sucesso.", Severity.Success);
            NavigationManager.NavigateTo("/profissionais");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to save professional");
            submitError = "Não foi possível salvar o profissional. Tente novamente.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task OnServiceIdsChanged(IEnumerable<Guid> serviceIds)
    {
        model.ServiceIds = serviceIds.Distinct().ToArray();
        return Task.CompletedTask;
    }

    private string GetSelectedServicesText(IReadOnlyList<string> selectedValues)
    {
        var serviceNamesById = options.Services.ToDictionary(service => service.Id, service => service.Name);

        return string.Join(
            ", ",
            selectedValues
                .Select(value => Guid.TryParse(value, out var serviceId) ? serviceId : Guid.Empty)
                .Where(serviceId => serviceId != Guid.Empty && serviceNamesById.ContainsKey(serviceId))
                .Select(serviceId => serviceNamesById[serviceId]));
    }

    private sealed class ProfessionalFormModel
    {
        public Guid? CompanyUserId { get; set; }
        public IReadOnlyCollection<Guid> ServiceIds { get; set; } = [];
        public string? TimeZoneId { get; set; }
    }
}
