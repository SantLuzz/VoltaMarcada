FROM nginx:1.27-alpine

ENV PORT=8080

RUN rm /etc/nginx/conf.d/default.conf \
    && sed -i 's|/var/run/nginx.pid|/tmp/nginx.pid|' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /etc/nginx/conf.d /usr/share/nginx/html /var/cache/nginx

COPY --chown=nginx:nginx landing/ /usr/share/nginx/html/
COPY --chown=nginx:nginx deploy/landing/default.conf.template /etc/nginx/templates/default.conf.template

USER nginx
EXPOSE 8080

ENTRYPOINT ["nginx", "-g", "daemon off;"]
