# Immutable production image tags
WEB_IMAGE=voltamarcada-web:0.0.0
LANDING_IMAGE=voltamarcada-landing:0.0.0

# PostgreSQL
POSTGRES_DB=voltamarcada
POSTGRES_USER=voltamarcada
POSTGRES_PASSWORD=

# Public URLs
APP_PUBLIC_URL=https://app.voltamarcada.com.br
LANDING_PUBLIC_URL=https://voltamarcada.com.br

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=VoltaMarcada

# Licensing
LICENSE_BILLING_PIX_KEY=

# Platform bootstrap
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
