# Managed PostgreSQL. The real value belongs only in deploy/.env.production.
# Use the provider's TLS connection configuration (for example, SSL Mode=Require or VerifyFull).
EXTERNAL_DATABASE_CONNECTION_STRING=

# Public URLs
APPLICATION_BASE_URL=https://app.voltamarcada.com.br
LANDING_PAGE_URL=https://voltamarcada.com.br

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=VoltaMarcada
SMTP_USERNAME=
SMTP_PASSWORD=

# Licensing
LICENSE_BILLING_PIX_KEY=

# Platform administrator bootstrap
PLATFORM_ADMINISTRATOR_EMAIL=
PLATFORM_ADMINISTRATOR_PASSWORD=
