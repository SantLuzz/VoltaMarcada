SMTP_PASSWORD=

# Support
SUPPORT_WHATSAPP_NUMBER=

# Licensing
LICENSE_BILLING_PIX_KEY=

# Platform administrator bootstrap
PLATFORM_ADMINISTRATOR_EMAIL=
PLATFORM_ADMINISTRATOR_PASSWORD=
